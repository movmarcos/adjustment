        "measures": [
          {
            "name": "Count Sensi Summary Import",
            "expression": "countrows('Sensitivity Summary Import')",
            "formatString": "0",
            "isHidden": true,
            "lineageTag": "63a7aa24-fee4-4747-a3d3-c21c6652e16a"
          },
          {
            "name": "DoD Import Raw",
            "expression": [
              "",
              "[Sensi Summary Import USD] - (CALCULATE([Sensi Summary Import USD],FILTER(ALL('Reporting Date'), 'Reporting Date'[COBId] = MAX('Previous Reporting Date'[Previous COBID]))))"
            ],
            "isHidden": true,
            "lineageTag": "35102885-cc7c-456d-b75d-d0f8f9d27569"
          },
          {
            "name": "MAX_TW",
            "expression": [
              "",
              "var bothTenor ",
              "    = SUMMARIZE(",
              "        'Sensitivity Summary Import', ",
              "        'Sensitivity Summary Import'[TenorCurrencyKey], ",
              "        'Sensitivity Summary Import'[UnderlyingTenorCurrencyKey], ",
              "        \"value\", MAX(TenorGroupMapping[Weighting])",
              "        )",
              "return MAXX(bothTenor, [value])"
            ],
            "isHidden": true,
            "lineageTag": "1f2fbd53-1e84-42f6-b833-d3fa3c7b439e"
          },
          {
            "name": "New Measure",
            "expression": [
              "",
              "[Sensi Summary Import USD]",
              "    - (",
              "        CALCULATE (",
              "            [Sensi Summary Import USD],",
              "            FILTER (",
              "                ALL ( 'Reporting Date' ),",
              "                'Reporting Date'[COBId] = MAX ( 'Previous Reporting Date'[Previous COBID] )",
              "            )",
              "        )",
              "    )"
            ],
            "isHidden": true,
            "lineageTag": "283c497d-a3ea-4415-9dba-454dadf6d748",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "Previous Sensi Summary Import",
            "expression": [
              "",
              "",
              "VAR _Max_Prev_COBID = MAX ( 'Previous Reporting Date'[Previous COBID] )",
              "VAR Result = ",
              "CALCULATE (",
              "    [Sensi Summary Import Original USD],",
              "    FILTER (",
              "        ALL ( 'Reporting Date' ),",
              "        'Reporting Date'[COBId]",
              "            = _Max_Prev_COBID",
              "    )",
              ")",
              "RETURN ",
              "   Result"
            ],
            "isHidden": true,
            "lineageTag": "0e038243-86d6-4d7a-b265-352e6359607e"
          },
          {
            "name": "Sensi Summary Import Original USD",
            "expression": " SUM('Sensitivity Summary Import'[MEASURE_VALUE_USD_INT]) + SUM('Sensitivity Summary Import'[MEASURE_VALUE_USD_DECIMAL])",
            "isHidden": true,
            "lineageTag": "5624a0fe-13ab-4976-8fda-e5fcc56acd1c"
          },
          {
            "name": "Sensi Summary Import USD",
            "expression": [
              "",
              "    SUM('Sensitivity Summary Import'[MEASURE_VALUE_USD_INT]) + SUM( 'Sensitivity Summary Import'[MEASURE_VALUE_USD_DECIMAL]) +",
              "    SUM('Sensitivity Summary Adjustment Import'[MEASURE_VALUE_USD_INT] ) + SUM( 'Sensitivity Summary Adjustment Import'[MEASURE_VALUE_USD_DECIMAL])"
            ],
            "isHidden": true,
            "lineageTag": "052e6677-15bc-450e-8581-29e6b4ea8b8a"
          }
        ],
