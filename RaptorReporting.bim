          {
            "name": "Original MRM_GLB_Severe_CR_C_Gain",
            "expression": [
              "var comb = ",
              "    CALCULATETABLE(",
              "        SUMMARIZE(",
              "            'Stress Group Calc',",
              "            'Stress Group Calc'[STRESS_SIMULATION_KEY],",
              "            \"value\", ",
              "            [Original Simulation Pl Levels]",
              "        ),",
              "        REMOVEFILTERS('Stress Group Calc'), ",
              "        'Stress Group Calc'[SIMULATION_GROUP] = \"MRM_GLB_Severe_CR_C\"",
              "    )",
              "return MAXX(comb, [value])"
