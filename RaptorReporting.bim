          {
            "type": "calculated",
            "name": "Rating Order",
            "dataType": "double",
            "isDataTypeInferred": true,
            "expression": [
              "CALCULATE (",
              "    MAX ( 'Rating Band'[Rating Order] ),",
              "    TREATAS ( { 'Limit Department'[Rating] }, 'Rating Band'[Rating] ),",
              "    'Rating Band'[Rating Template Name] = 3",
              ")"
            ],
            "lineageTag": "dbcbe103-1223-4a28-a2b2-70b1573900d0",
            "summarizeBy": "none",
            "isAvailableInMdx": false
          }
