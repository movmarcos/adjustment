            "expression": [
              "",
              "IF([Display PNL], ",
              "    IF([Use Stress Trade Level DQ], Blank(), CALCULATE([Sim Pl cyclic SUM], 'Stress Simulation'[STRESS_SIMULATION_KEY]=-11)),",
              "    BLANK()",
