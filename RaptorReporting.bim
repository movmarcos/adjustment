              "    SUMX({",
              "    CALCULATE(",
              "        [Simulation Pl Levels],",
              "        FILTER(ALL('Stress Simulation'), 'Stress Simulation'[Simulation Name]=\"MRM_M_PARA_EQ_Remote2_EQupEVdn\")",
              "    ),",
              "    CALCULATE(",
              "        [Simulation Pl Levels],",
              "        FILTER(ALL('Stress Simulation'), 'Stress Simulation'[Simulation Name]=\"MRM_S_PARA_CR_Remote_BullSteepener\")",
              "    ),",
              "    CALCULATE(",
              "        [Simulation Pl MRM_S_PARA_RemoteRatesStress],",
              "        ALL('Stress Simulation')",
              "    )",
              "    },[Value])",
              ")"
            ],
            "isHidden": true,
            "displayFolder": "Calculated",
            "lineageTag": "1f49544b-1d25-4c85-9c8f-cb66ea05d3a2",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              },
              {
                "name": "PBI_ChangedProperties",
                "value": "[\"IsHidden\"]"
              }
            ]
          },
          {
            "name": "Simulation Pl MRM_S_PARA_RemoteRatesStress",
            "expression": [
              "",
              "IF([Display PNL],",
              "    IF([Use Stress Trade Level DQ], ",
              "        Blank(),",
              "        CALCULATE([Sim Pl cyclic SUM], 'Stress Simulation'[STRESS_SIMULATION_KEY]=-11) +",
              "        CALCULATE([Measure Adjustment Value Simulation Pl In USD], FILTER(ALL('Stress Simulation'), 'Stress Simulation'[STRESS_SIMULATION_KEY]=-11))",
              "    ),",
              "    BLANK()",
              ")"
            ],
            "isHidden": true,
            "displayFolder": "Calculated",
            "lineageTag": "00318256-18c3-4e19-80d5-5488597e0fb9",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              },
              {
                "name": "PBI_ChangedProperties",
                "value": "[\"IsHidden\"]"
              }
            ]
          },
          {
            "name": "Simulation Pl MRM_S_PARA_StdCombinedStress",
            "expression": [
              "MINX (",
              "    {",
              "        [Simulation Pl MRM_M_PARA_CreditStandard],",
              "        [Simulation Pl MRM_M_PARA_EQ_StdStress],",
              "        [Simulation Pl MRM_S_PARA_StdRatesStress],",
              "        [Simulation Pl MRM_S_PARA_StdCombinedStress_Calc]",
              "    },",
              "    [Value]",
              ")"
            ],
            "isHidden": true,
            "displayFolder": "Calculated",
            "lineageTag": "04bbff00-31f3-4fac-9622-54a1702bb875",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"General\" />"
              },
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              },
              {
                "name": "PBI_ChangedProperties",
                "value": "[\"IsHidden\"]"
              }
            ]
          },
          {
            "name": "Simulation Pl MRM_S_PARA_StdCombinedStress_Calc",
            "expression": [
              "SUMX({",
              "    [Simulation Pl MRM_M_PARA_CreditStandard] * 0.8,",
              "    [Simulation Pl MRM_M_PARA_EQ_StdStress] * 0.9,",
              "    [Simulation Pl MRM_S_PARA_StdRatesStress] * 0.4 ",
              "    },[Value])",
              ""
            ],
            "isHidden": true,
            "displayFolder": "Calculated",
            "lineageTag": "5aa6e2ce-46ae-4e8d-92b4-eb23888ead4a",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"General\" />"
              },
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              },
              {
                "name": "PBI_ChangedProperties",
                "value": "[\"IsHidden\"]"
              }
            ]
          },
          {
            "name": "Simulation Pl MRM_S_PARA_StdRatesStress",
            "expression": [
              "VAR s = SUMMARIZE(",
              "    FILTER(All('Stress Simulation'), 'Stress Simulation'[Simulation Name] IN { ",
              "        \"MRM_M_PARA_IRBearFlattener_VolUpLHS\", ",
              "        \"MRM_M_PARA_IRBullSteepener_VolDownLHS\", ",
              "        \"MRM_M_PARA_IRBearSteepener_VolUpRHS\", ",
              "        \"MRM_M_PARA_IRBullFlattener_VolDownRHS\" }",
              "    ), ",
              "    'Stress Simulation'[Simulation Name], ",
              "    \"value\",  [Simulation Pl Levels]",
              ")",
              "",
              "RETURN MINX(s,[value])"
            ],
            "isHidden": true,
            "displayFolder": "Calculated",
            "lineageTag": "423362ad-467e-4e4e-b467-ded64bea751d",
            "annotations": [
              {
                "name": "PBI_ChangedProperties",
                "value": "[\"IsHidden\"]"
              },
              {
                "name": "Format",
                "value": "<Format Format=\"General\" />"
              },
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "Use Stress Summary Level DQ",
            "expression": "MIN('Reporting Date'[IMPORTED_STRESS])=0",
            "formatString": "\"TRUE\";\"TRUE\";\"FALSE\"",
            "isHidden": true,
            "lineageTag": "ed53d136-262a-4902-86ac-98de919579bb",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"Boolean\" />"
              },
              {
                "name": "PBI_ChangedProperties",
                "value": "[\"IsHidden\"]"
              }
            ]
          },
          {
            "name": "Use Stress Trade Level DQ",
            "expression": "ISCROSSFILTERED(Trade[Trade Key]) || (ISCROSSFILTERED('Official Source') && MIN('Official Source'[OfficialsourceValue]) = 0)",
            "formatString": "\"TRUE\";\"TRUE\";\"FALSE\"",
            "isHidden": true,
            "lineageTag": "30faa4de-86de-4bd5-87e8-9faf70785b95",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"Boolean\" />"
