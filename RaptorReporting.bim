      {
        "name": "Business Line 2",
        "isHidden": true,
        "lineageTag": "6d265cf9-3b76-4eef-aa2f-6a755e39e3e1",
        "columns": [
          {
            "type": "calculatedTableColumn",
            "name": "Business Line",
            "dataType": "string",
            "isNameInferred": true,
            "isDataTypeInferred": true,
            "sourceColumn": "ENTITY_DEPARTMENT[Business Line]",
            "lineageTag": "ace50b0c-276a-4482-8af7-38b763334ccf",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "isAvailableInMdx": false
          },
          {
            "type": "calculatedTableColumn",
            "name": "Business Unit Code",
            "dataType": "string",
            "isNameInferred": true,
            "isDataTypeInferred": true,
            "isKey": true,
            "sourceColumn": "ENTITY_DEPARTMENT[Business Unit Code]",
            "lineageTag": "a413915d-5e68-4263-aefa-da8b492705b7",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "isAvailableInMdx": false
          },
          {
            "type": "calculated",
            "name": "Business Line Display",
            "dataType": "string",
            "isDataTypeInferred": true,
            "expression": [
              "IF (",
              "    NOT ( 'Business Line 2'[Business Line]",
              "        IN { \"Rates\", \"Credit\", \"Equities\", \"Securities Financing\" } ),",
              "    \"Other\",",
              "    'Business Line 2'[Business Line]",
              ")"
            ],
            "sortByColumn": "Business Line Order",
            "lineageTag": "bd028c60-b56e-4296-b8e9-9fdf42a6cf9a",
            "isAvailableInMdx": false
          },
          {
            "type": "calculated",
            "name": "Business Line Order",
            "dataType": "int64",
            "isDataTypeInferred": true,
            "expression": [
              "SWITCH (",
              "    'Business Line 2'[Business Line],",
              "    \"Rates\", 1,",
              "    \"Credit\", 2,",
              "    \"Equities\", 3,",
              "    \"Securities Financing\", 4,",
              "    5",
              ")"
            ],
            "lineageTag": "d43ae801-2f25-48d5-a00c-d986626a4258"
          },
          {
            "type": "calculated",
            "name": "Business Line Display Stress",
            "dataType": "string",
            "isDataTypeInferred": true,
            "expression": [
              "IF (",
              "    'Business Line 2'[Business Line] = \"N/A\",",
              "    \"Other\",",
              "    'Business Line 2'[Business Line]",
              ")"
            ],
            "sortByColumn": "Business Line Order Stress",
            "lineageTag": "f26ccf58-c1d4-48fd-89f1-96347cb17ff7",
            "isAvailableInMdx": false
          },
          {
            "type": "calculated",
            "name": "Business Line Order Stress",
            "dataType": "int64",
            "isDataTypeInferred": true,
            "expression": [
              "SWITCH (",
              "    'Business Line 2'[Business Line],",
              "    \"Credit\", 1,",
              "    \"Equities\", 2,",
              "    \"Rates\", 3,",
              "    \"Securities Financing\", 4,",
              "    \"Structured\", 5,",
              "    \"Capital Market\", 6,",
              "    \"Securitised Products\", 7,",
              "    \"Treasury\", 8,",
              "    \"N/A\", 9, 10",
              ")"
            ],
            "lineageTag": "72f46e61-45f6-41ab-87bf-10672dce79b0"
          }
        ],
        "partitions": [
          {
            "name": "Business Line 2",
            "mode": "import",
            "source": {
              "type": "calculated",
              "expression": [
                "SUMMARIZECOLUMNS (",
                "    ENTITY_DEPARTMENT[Business Unit Code],",
                "    ENTITY_DEPARTMENT[Business Line],",
