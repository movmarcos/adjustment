              }
            ]
          },
          {
            "name": "PnL Import Count",
            "expression": "COUNTROWS('VaR Book Import')",
            "formatString": "0",
            "isHidden": true,
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"NumberWhole\" Accuracy=\"0\" />"
              }
            ]
          },
          {
            "name": "PnL Import",
            "expression": "SUM('VaR Book Import'[PNL_VECTOR_VALUE_IN_USD_INT]) + SUM('VaR Book Import'[PNL_VECTOR_VALUE_IN_USD_DECIMAL])",
            "isHidden": true,
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"General\" />"
              }
            ]
          },
          {
            "name": "VaR All Department Import Unadjusted",
            "expression": "IF([VaR In USD Import Unadjusted] = BLANK(), BLANK(), CALCULATE([VaR In USD Import Unadjusted], ALL('Book'[Department Code])))",
            "isHidden": true,
            "lineageTag": "c8102f8f-d4aa-4e14-a2e2-e63752b10d07",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"General\" />"
              }
            ]
          },
          {
            "name": "VaR All Department Import",
            "expression": "IF([VaR In USD Import Adjusted] = BLANK(), BLANK(), CALCULATE([VaR In USD Import Adjusted], ALL('Book'[Department Code])))",
            "isHidden": true,
            "lineageTag": "f63941be-6f39-48b3-8c9a-dd4b394b1429",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"General\" />"
              }
            ]
          },
          {
            "name": "VaR In USD Import Adjusted MUSECon",
            "expression": [
              "VAR SecondElementFraction = 1-[First Element Fraction]",
              "VAR ScenarioTable =  CALCULATETABLE(SUMMARIZE('PnL Vector Element Ordinal','PnL Vector Element Ordinal'[SCENARIO_DATE_ID],\"PnlVector\",  [PnL Vector Value Import Adjusted]),'Entity'[Entity Code] IN {\"MUSI\",\"MUSEU\"})",
              "VAR VaRVectors = TOPN(2,TOPN([Second Element Sl No Summary],ScenarioTable,[PnlVector],ASC),[PnlVector],DESC)",
              "RETURN  (((CALCULATE(MINX(VaRVectors,[PnlVector])) * [First Element Fraction]) +  (CALCULATE(MAXX(VaRVectors,[PnlVector])) * SecondElementFraction)) * [VaR Scaling Value] *-1)"
            ],
            "isHidden": true,
            "lineageTag": "8002bada-d8dd-4abe-84d6-4becd501eb18",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"General\" />"
              }
            ]
          }
        ],
