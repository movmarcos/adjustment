          {
            "name": "Simulation Pl Levels With Cyclic DQ",
            "expression": [
              "",
              "IF([Display PNL],",
              "    IF([Use Stress Trade Level DQ], [Simulation Pl DQ Adjusted],",
              "        IF([Use Stress Summary Level DQ], [Simulation Pl Summary DQ Adjusted] , [Simulation Pl Import Adjusted] + [Sim Pl cyclic SUM])",
              "    )",
              ",BLANK()",
              ")"
            ],
            "isHidden": true,
