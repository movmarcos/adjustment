      {
        "name": "CVA classification",
        "isHidden": true,
        "lineageTag": "8e06f057-431f-4963-93fd-800c872a9c41",
        "columns": [
          {
            "type": "calculatedTableColumn",
            "name": "Book Code",
            "dataType": "string",
            "isNameInferred": true,
            "isDataTypeInferred": true,
            "sourceColumn": "[Book Code]",
            "isAvailableInMdx": false
          },
          {
            "type": "calculatedTableColumn",
            "name": "CVA Activity",
            "dataType": "string",
            "isNameInferred": true,
            "isDataTypeInferred": true,
            "sourceColumn": "[CVA Activity]",
            "sortByColumn": "Order Activity",
            "isAvailableInMdx": false
          },
          {
            "type": "calculatedTableColumn",
            "name": "CVA Category",
            "dataType": "string",
            "isNameInferred": true,
            "isDataTypeInferred": true,
            "sourceColumn": "[CVA Category]",
            "sortByColumn": "Order Category",
            "isAvailableInMdx": false
          },
          {
            "type": "calculatedTableColumn",
            "name": "CVA Sub-Category",
            "dataType": "string",
            "isNameInferred": true,
            "isDataTypeInferred": true,
            "sourceColumn": "[CVA Sub-Category]",
            "sortByColumn": "Order Sub-Category",
            "isAvailableInMdx": false
          },
          {
            "type": "calculatedTableColumn",
            "name": "Order Activity",
            "dataType": "int64",
            "isNameInferred": true,
            "isDataTypeInferred": true,
            "sourceColumn": "[Order Activity]"
          },
          {
            "type": "calculatedTableColumn",
            "name": "Order Category",
            "dataType": "int64",
            "isNameInferred": true,
            "isDataTypeInferred": true,
            "sourceColumn": "[Order Category]"
          },
          {
            "type": "calculatedTableColumn",
            "name": "Order Sub-Category",
            "dataType": "int64",
            "isNameInferred": true,
            "isDataTypeInferred": true,
            "sourceColumn": "[Order Sub-Category]"
          }
        ],
        "partitions": [
          {
            "name": "New Calculated Table",
            "mode": "import",
            "source": {
              "type": "calculated",
              "expression": [
                "ADDCOLUMNS (",
                "    DISTINCT (",
                "        SELECTCOLUMNS (",
                "            FILTER (",
                "                Book,",
                "                Book[ENTITYDEPTJOIN]",
                "                    IN { \"MUFGBK-CPM\", \"MUSI-CCX\" } && NOT ( Book[Is RM Excluded] )",
                "            ),",
                "            \"Book Code\", Book[Book Code]",
                "        )",
                "    ),",
                "    \"CVA Activity\",",
                "        SWITCH (",
                "            TRUE (),",
                "            [Book Code] IN { \"Book-CVA\", \"MUFG-XVA\", \"MUFG-XVB\", \"MUFG-XVN\" }, \"CVA\",",
                "            \"Hedges\"",
                "        ),",
                "    \"CVA Category\",",
                "        SWITCH (",
                "            TRUE (),",
                "            [Book Code] IN { \"Book-CVA\", \"MUFG-XVA\" }, \"CAS\",",
                "            [Book Code] IN { \"MUFG-XVB\", \"MUFG-XVN\" }, \"Vamos\",",
                "            \"Hedges\"",
                "        ),",
                "    \"CVA Sub-Category\",",
                "        SWITCH (",
                "            [Book Code],",
                "            \"Book-CVA\", \"CAS\",",
                "            \"MUFG-XVA\", \"CAS\",",
                "            \"MUFG-XVB\", \"Vamos\",",
                "            \"MUFG-XVN\", \"Vamos-MBE\",",
                "            \"LD800\", \"SN CDS\",",
                "            \"LD812\", \"SN CDS\",",
                "            \"LD810\", \"Index CDS\",",
                "            \"LD803\", \"IR Hedges\",",
                "            \"LD805\", \"Inflation Hedges\",",
                "            \"LD812\", \"Credit Insurance\",",
                "            \"Hedges\"",
                "        ),",
                "    \"Order Activity\",",
                "        SWITCH (",
                "            TRUE (),",
                "            [Book Code] IN { \"Book-CVA\", \"MUFG-XVA\", \"MUFG-XVB\", \"MUFG-XVN\" }, 1,",
                "            2",
                "        ),",
                "    \"Order Category\",",
                "        SWITCH (",
                "            TRUE (),",
                "            [Book Code] IN { \"Book-CVA\", \"MUFG-XVA\" }, 1,",
                "            [Book Code] IN { \"MUFG-XVB\", \"MUFG-XVN\" }, 2,",
                "            3",
                "        ),",
                "    \"Order Sub-Category\",",
                "        SWITCH (",
                "            [Book Code],",
                "            \"Book-CVA\", 1,",
                "            \"MUFG-XVA\", 2,",
                "            \"MUFG-XVB\", 3,",
                "            \"MUFG-XVN\", 4,",
                "            \"LD800\", 5,",
                "            \"LD812\", 5,",
                "            \"LD810\", 6,",
                "            \"LD803\", 7,",
                "            \"LD805\", 8,",
                "            \"LD812\", 9,",
                "            10",
                "        )",
                ")"
              ]
            }
          }
        ]
      },
