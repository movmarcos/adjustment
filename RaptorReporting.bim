        "partitions": [
          {
            "name": "Stress Measures Summary Combined DQ",
            "mode": "directQuery",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Snowflake.Databases(\"tj90313.west-europe.azure.snowflakecomputing.com\",WarehouseName),",
                "    RAPTOR_Database = Source{[Name=DBName,Kind=\"Database\"]}[Data],",
                "    FACT_Schema = RAPTOR_Database{[Name=\"FACT\",Kind=\"Schema\"]}[Data],",
                "    STRESS_SUMMARY_COMBINED_View = FACT_Schema{[Name=\"STRESS_SUMMARY_COMBINED\",Kind=\"View\"]}[Data]",
                "in",
                "    STRESS_SUMMARY_COMBINED_View"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Adjust RemoteRatesStress",
            "expression": "CALCULATE([Simulation Pl Import Adjustment], 'Stress Simulation'[STRESS_SIMULATION_KEY]=-11)",
            "isHidden": true,
            "lineageTag": "5fea03fe-aafc-4de5-9a00-d7fc3fc5e56d",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "Adjustment Summary DQ Row Count",
            "expression": [
              "",
              "CALCULATE(",
              "    COUNTROWS('Stress Measures Summary Combined DQ'), ",
              "    FILTER(ALL('IsAdjustment'), IsAdjustment[Is Adjustment] = 1)",
              "    )"
            ],
            "formatString": "0",
            "isHidden": true,
            "lineageTag": "ef72a389-242a-4844-9778-ee804cb2ef61",
            "annotations": [
              {
                "name": "Format",
