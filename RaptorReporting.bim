            "lineageTag": "61381159-f51d-44cf-9ada-e2b36d798b6d"
          },
          {
            "name": "Sensi 6M Min Summary",
            "expression": [
              "VAR _DIVISOR = SELECTEDVALUE('Reporting Measure Type'[PBI Format Divisor],1)",
              "RETURN",
              "    DIVIDE ( [Candlesticks_6M_Min_Summary], _DIVISOR )"
