          {
            "name": "VaR DoD Change Original Reporting Currency",
            "expression": "[UnAdjusted VaR In Reporting Currency] - [Previous VaR In Reporting Currency]",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"General\" />"
              }
            ]
          },
          {
            "name": "VaR DoD Change Reporting Currency 0dp",
            "expression": "[VaR DoD Change Reporting Currency]",
            "formatString": "#,0",
            "isHidden": true,
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"NumberDecimal\" Accuracy=\"0\" ThousandSeparator=\"True\" />"
              }
            ]
          },
          {
            "name": "VaR In Reporting Currency 0dp",
            "expression": "[VaR In Reporting Currency]",
            "formatString": "#,0",
            "isHidden": true,
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"NumberDecimal\" Accuracy=\"0\" ThousandSeparator=\"True\" />"
              }
            ]
          },
          {
            "name": "VaR In Reporting Currency MUSECon",
            "expression": "DIVIDE([VaR In USD MUSECon], [Exchange Rate]) * [Currency Unit Value]",
            "formatString": "#,0.00",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"NumberDecimal\" Accuracy=\"2\" ThousandSeparator=\"True\" />"
              }
            ]
          },
          {
            "name": "VaR In USD MUSECon",
            "expression": "IF([Display VAR], IF([Use Trade Level DQ], [VaR Trade Adjusted MUSECon], IF([Use VaR Summary Level DQ], [VaR In USD Summary Adjusted MUSECon], [VaR In USD Import Adjusted MUSECon])),BLANK())",
            "formatString": "#,0.00",
            "lineageTag": "e5e76bf6-a594-4539-991a-551059028982",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"NumberDecimal\" Accuracy=\"2\" ThousandSeparator=\"True\" />"
              }
            ]
          },
          {
            "name": "VaR Marginal Average",
            "expression": "IF( ISBLANK( [VaR Marginal Roll Forward] ), BLANK(), DIVIDE( ( [VaR Marginal Roll Forward] + [VaR Marginal Roll Back] ), 2 ) )",
            "formatString": "#,##0",
            "displayFolder": "VaR Marginal",
            "lineageTag": "5816c423-a836-4467-988e-55d19dbe2ce5"
          },
          {
            "name": "VaR Marginal Roll Back",
            "expression": [
              "VaR VaRAllComponentTrader = IF(ISBLANK([VaR In USD]), BLANK(), CALCULATE([VaR In USD], ALL('Book'[Department Code]),All('Book'[Trader Code]),All('VaR Sub Component'[VaR Component Name])))",
              "VAR SecondElementFraction = 1-[First Element Fraction]",
              "VAR ScenarioTable = SUMMARIZE('PnL Vector Element Ordinal','PnL Vector Element Ordinal'[SCENARIO_DATE_ID] ,\"PnlVector\",IF(ISBLANK([Pnl Vector Value In USD]), Blank(), CALCULATE([Pnl Vector Value In USD],ALL('Book'[Department Code]), All('Book'[Trader Code]), All('VaR Sub Component'[VaR Component Name]))) + [Pnl Vector Value In USD] - [Previous PnL])",
              "VAR VaRVectors = TOPN(2,TOPN([Second Element Sl No Summary],ScenarioTable,[PnlVector],ASC),[PnlVector],DESC)",
              "RETURN  (((CALCULATE(MINX(VaRVectors,[PnlVector])) * [First Element Fraction]) +  (CALCULATE(MAXX(VaRVectors,[PnlVector])) * SecondElementFraction))*-1) - VaRAllComponentTrader"
            ],
            "formatString": "#,##0",
            "isHidden": true,
            "displayFolder": "VaR Marginal",
            "lineageTag": "241f3a06-ef8f-4b9e-965f-42430c4e39a4"
          },
          {
            "name": "VaR Marginal Roll Forward",
            "expression": [
              "VAR PreviousVaRAllComponentTrader = IF(ISBLANK([Previous VaR In USD]), BLANK(), CALCULATE([Previous VaR In USD], ALL('Book'[Department Code]),All('Book'[Trader Code]),All('VaR Sub Component'[VaR Component Name])))",
              "VAR SecondElementFraction = 1-[First Element Fraction]",
              "VAR ScenarioTable = SUMMARIZE('PnL Vector Element Ordinal','PnL Vector Element Ordinal'[SCENARIO_DATE_ID] ,\"PnlVector\",  IF(ISBLANK([Previous Pnl]),BLANK(), CALCULATE([Previous Pnl],ALL('Book'[Department Code]), All('Book'[Trader Code]), All('VaR Sub Component'[VaR Component Name]))) + [Pnl Vector Value In USD] - [Previous PnL])",
              "VAR VaRVectors = TOPN(2,TOPN([Second Element Sl No Summary],ScenarioTable,[PnlVector],ASC),[PnlVector],DESC)",
              "RETURN  (((CALCULATE(MINX(VaRVectors,[PnlVector])) * [First Element Fraction]) +  (CALCULATE(MAXX(VaRVectors,[PnlVector])) * SecondElementFraction))*-1) - PreviousVaRAllComponentTrader"
            ],
            "formatString": "#,##0",
            "isHidden": true,
            "displayFolder": "VaR Marginal",
            "lineageTag": "81e6a179-a419-447d-b635-d1dcbd818ecc"
          }
        ],
