        "measures": [
          {
            "name": "VaR In USD Import Adjusted",
            "expression": [
              "VAR SecondElementFraction = 1-[First Element Fraction]",
              "VAR ScenarioTable =  SUMMARIZE('PnL Vector Element Ordinal','PnL Vector Element Ordinal'[SCENARIO_DATE_ID],\"PnlVector\",  [PnL Vector Value Import Adjusted])",
              "VAR VaRVectors = TOPN(2,TOPN([Second Element Sl No Summary],ScenarioTable,[PnlVector],ASC),[PnlVector],DESC)",
              "RETURN  (((CALCULATE(MINX(VaRVectors,[PnlVector])) * [First Element Fraction]) +  (CALCULATE(MAXX(VaRVectors,[PnlVector])) * SecondElementFraction)) * [VaR Scaling Value] *-1)"
            ],
            "isHidden": true,
            "lineageTag": "493a6c9f-2d09-4658-b764-0a2df6c1cbde",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"General\" />"
              }
            ]
          },
          {
            "name": "PnL Row Count Book Import",
            "expression": "countrows('VaR Book Import')",
            "formatString": "0",
            "isHidden": true,
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"NumberWhole\" Accuracy=\"0\" />"
              }
            ]
          },
          {
            "name": "VaR In Reporting Currency Import Unadjusted",
            "expression": "DIVIDE([VaR In USD Import Unadjusted],[Exchange Rate])*[Currency Unit Value]",
            "formatString": "#,0",
            "isHidden": true,
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"NumberDecimal\" Accuracy=\"0\" ThousandSeparator=\"True\" />"
              }
            ]
          },
          {
            "name": "Previous PnL Vector Value USD",
            "expression": "IF( ISBLANK([PnL Vector Value Import Adjusted] ), BLANK(),IF( hasonevalue('Previous Reporting Date'[Previous COBId]), CALCULATE([PnL Vector Value Import Adjusted],FILTER(ALL('Reporting Date'), 'Reporting Date'[COBId] = MIN('Previous Reporting Date'[Previous COBId])))))",
            "isHidden": true,
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"General\" />"
              }
            ]
          },
          {
            "name": "All Department VaR",
            "expression": [
              "VAR SecondElementFraction = 1-[First Element Fraction]",
              "VAR ScenarioTable = SUMMARIZE('VaR Book Import', 'VaR Book Import'[SCENARIO_DATE_ID] ,\"PnlVector\", [PnL Import])",
              "VAR VaRVectors = TOPN(2,TOPN([Second Element Sl No Summary],ScenarioTable,[PnlVector],ASC),[PnlVector],DESC)",
              "RETURN  (((CALCULATE(MINX(VaRVectors,[PnlVector])) * [First Element Fraction]) +  (CALCULATE(MAXX(VaRVectors,[PnlVector])) * SecondElementFraction)) * DIVIDE(-1,SQRT(MIN('VaR Sub Component'[VaR Sub Component Day Type]))))"
            ],
            "isHidden": true,
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"General\" />"
              }
            ]
          },
          {
            "name": "VaR In USD Import Unadjusted",
            "expression": [
              "VAR SecondElementFraction = 1-[First Element Fraction]",
              "VAR ScenarioTable =  SUMMARIZE('PnL Vector Element Ordinal','PnL Vector Element Ordinal'[SCENARIO_DATE_ID] ,\"PnlVector\", [PnL Vector Value Import Unadjusted])",
              "VAR VaRVectors = TOPN(2,TOPN([Second Element Sl No Summary],ScenarioTable,[PnlVector],ASC),[PnlVector],DESC)",
              "RETURN  (((CALCULATE(MINX(VaRVectors,[PnlVector])) * [First Element Fraction]) +  (CALCULATE(MAXX(VaRVectors,[PnlVector])) * SecondElementFraction)) * [VaR Scaling Value] *-1)"
            ],
            "isHidden": true,
            "lineageTag": "5d57872f-0244-450a-a596-be5a89f5d696",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"General\" />"
              }
            ]
          },
          {
            "name": "Previous PnL Vector Value USD Unadjusted",
            "expression": "IF( ISBLANK([PnL Vector Value Import Unadjusted] ), BLANK(),IF( hasonevalue('Previous Reporting Date'[Previous COBId]), CALCULATE([PnL Vector Value Import Unadjusted],FILTER(ALL('Reporting Date'), 'Reporting Date'[COBId] = MIN('Previous Reporting Date'[Previous COBId])))))",
            "isHidden": true,
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"General\" />"
              }
            ]
          },
          {
            "name": "Previous PnL Adjustment",
            "expression": "IF( ISBLANK([PnL Adjustment Import]), BLANK(),IF( hasonevalue('Previous Reporting Date'[Previous COBId]), CALCULATE([PnL Adjustment Import],FILTER(ALL('Reporting Date'), 'Reporting Date'[COBId] = MIN('Previous Reporting Date'[Previous COBId])))))",
            "isHidden": true,
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"General\" />"
              }
            ]
          },
          {
            "name": "PnL Vector Value Import Unadjusted",
            "expression": "[PnL Import] + [PnL Summary Max] + [PnL Import Cyclic]",
            "isHidden": true,
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"General\" />"
              }
            ]
          },
          {
            "name": "PnL Vector Value Import Adjusted",
            "expression": "[PnL Import]+[PnL Summary Max] + [PnL Adjustment Import] + [PnL Import Cyclic] ",
            "isHidden": true,
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"General\" />"
              }
            ]
          },
          {
            "name": "VaR DoD Change Import Unadjusted",
            "expression": "([VaR In USD Import Unadjusted] - [Previous VaR In USD Import Adjusted])",
            "formatString": "#,0",
            "isHidden": true,
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"NumberWhole\" Accuracy=\"0\" ThousandSeparator=\"True\" />"
              }
            ]
          },
          {
            "name": "VaR In Reporting Currency Import Adjusted",
            "expression": "DIVIDE([VaR In USD Import Adjusted], [Exchange Rate]) * [Currency Unit Value]",
            "formatString": "#,0",
            "isHidden": true,
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"NumberDecimal\" Accuracy=\"0\" ThousandSeparator=\"True\" />"
              }
            ]
          },
          {
            "name": "Previous VaR In USD Import Adjusted",
            "expression": "CALCULATE([VaR In USD Import Adjusted],FILTER(ALL('Reporting Date'), 'Reporting Date'[COBId] = MAX('Previous Reporting Date'[Previous COBId])))",
            "isHidden": true,
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"General\" />"
              }
            ]
          },
          {
            "name": "VaR DoD Change % Import Unaj",
            "expression": [
              "VAR PrevVAR = [Previous VaR In USD Import Adjusted]",
              "RETURN DIVIDE([VaR In USD Import Unadjusted]-PrevVAR,PrevVAR)"
            ],
            "isHidden": true,
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"General\" />"
              }
            ]
          },
          {
            "name": "Highlight Change Unadjsted",
            "expression": [
              "IF(",
              "    ABS( [VaR DoD Change % Import Unaj] ) > 0,",
              "    IF(",
              "        ABS( [VaR DoD Change % Import Unaj] ) > MIN( 'FlashVaR%'[Highlight%] )",
              "            && ABS( [VaR DoD Change Import Unadjusted] ) >= DIVIDE( MIN( FlashVaRAmount[HighlightAmount] ), [Currency Unit Value] ),",
              "        1,",
              "        0",
              "    ),",
              "    BLANK( )",
              ")"
            ],
            "formatString": "0",
            "isHidden": true,
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"NumberWhole\" Accuracy=\"0\" />"
              }
            ]
          },
          {
            "name": "Highlight Change Import",
            "expression": [
              "IF(",
              "    ABS( [VaR DoD Change % Import] ) > MIN( 'FlashVaR%'[Highlight%] )",
              "        && ABS( [VaR DoD Change Import] ) >= DIVIDE( MIN( FlashVaRAmount[HighlightAmount] ), [Currency Unit Value] ),",
              "    1,",
              "    0",
              ")"
            ],
            "formatString": "0",
            "isHidden": true,
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"NumberWhole\" Accuracy=\"0\" />"
              }
            ]
          },
          {
            "name": "VaR DoD Change Import",
            "expression": "([VaR In USD Import Adjusted] - [Previous VaR In USD Import Adjusted])",
            "formatString": "0",
            "isHidden": true,
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"NumberWhole\" Accuracy=\"0\" />"
              }
            ]
          },
          {
            "name": "VaR DoD Change % Import",
            "expression": [
              "VAR  PrevVAR = [Previous VaR In USD Import Adjusted]",
              "RETURN DIVIDE([VaR In USD Import Adjusted]- PrevVAR,PrevVAR)"
            ],
            "isHidden": true,
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"General\" />"
              }
            ]
          },
          {
            "name": "VaR In Reporting Currency DoD Change Import",
            "expression": "DIVIDE([VaR DoD Change Import],[Exchange Rate])*[Currency Unit Value]",
            "formatString": "#,0",
            "isHidden": true,
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"NumberDecimal\" Accuracy=\"0\" ThousandSeparator=\"True\" />"
