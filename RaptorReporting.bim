              }
            ],
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "Measure Count",
            "expression": [
              "",
              "IF([Display Sensi],",
              "    IF([Use Sensi Trade Level DQ], [Count Sensitivity Detail DQ], ",
              "        IF([Use Sensi Summary Level DQ],[Count Sensi Summary DQ], ([Count Sensi Summary Import] + [Count Sensi Summary Adjustment import])) ",
              "        )",
              "    , BLANK()",
              ")"
            ],
            "formatString": "#,0",
            "lineageTag": "4118e7d4-be6e-4a4e-95f1-f8e607354311"
          },
          {
            "name": "Measure Original Value In Reporting Currency",
            "expression": "DIVIDE([Measure Original Value In USD], [Exchange rate])",
            "formatString": "#,##0.00",
            "lineageTag": "bde9ca82-53af-4074-85e8-10e3425f93a9"
          },
          {
            "name": "Measure Original Value In USD",
            "expression": [
              "",
              "IF([Display Sensi],",
              "    IF(ISCROSSFILTERED('Reporting Measure Type'),",
              "        SWITCH(TRUE(),",
              "            SELECTEDVALUE('Reporting Measure Type'[Measure Type Code]) = \"WAS\", [WAS Original],",
              "            SELECTEDVALUE('Reporting Measure Type'[Measure Type Code]) = \"FX Exposure T-1\", [FxExpTminus1 Original],",
              "            SELECTEDVALUE('Reporting Measure Type'[Measure Type Code]) = \"WASPerf-ABSCS01\", [WASPerf-ABSCS01 Original],",
              "            SELECTEDVALUE('Reporting Measure Type'[Measure Type Code]) = \"WASPerf-ABSCS01CSPD\", [WASPerf-ABSCS01CSPD Original],",
              "            SELECTEDVALUE('Reporting Measure Type'[Measure Type Code]) = \"CashAdjustment\", [Cash Adjustment Original],",
              "            SELECTEDVALUE ( 'Reporting Measure Type'[Reporting Measure Name] ) = \"GOV01\", [GOV01 Original],",
              "            SELECTEDVALUE ( 'Reporting Measure Type'[Reporting Measure Name] ) = \"CC01\", [CC01 Original],",
              "            [Original USD Tenor Selection]",
              "        ),",
              "        [Original USD Tenor Selection]",
              "    )",
              "    , BLANK()",
              ")"
            ],
            "formatString": "#,##0.00",
            "lineageTag": "5ac608b0-437f-4af5-b106-39d075a12413"
          },
          {
            "name": "Measure Value For Prior Day In Reporting Currency",
            "expression": "DIVIDE([Prior Day Measure Value In USD], [Exchange Rate] )",
            "formatString": "#,##0.00",
            "lineageTag": "338eb631-83f9-4a22-b963-af136d650503"
          },
          {
            "name": "Measure Value In Reporting Currency Formatted",
            "expression": "DIVIDE([Measure Value In Reporting Currency], [Format Divisor])",
            "formatString": "#,##0.00",
            "lineageTag": "f4a17ee2-5d18-4a06-91e3-7c9ee840580f"
          },
          {
            "name": "Measure Value In Reporting Currency",
            "expression": "DIVIDE([Measure Value in USD], [Exchange Rate]) * [Currency Unit Value]",
            "formatString": "#,##0.00",
            "lineageTag": "540780df-f4df-415a-aa24-e2377b048d56"
          },
          {
            "name": "Measure Value In USD Both Tenor Group Weighting",
            "expression": [
              "VAR BothTenorGrp =",
              "    SUMMARIZECOLUMNS (",
              "        TenorGroupMapping[Weighting],",
              "        UnderlyingTenorGroupMapping[Weighting],",
              "        \"value\",",
              "        [Measure Value In USD Simple]",
              "    )",
              "RETURN",
              "    SUMX ( BothTenorGrp, [value] * TenorGroupMapping[Weighting] * UnderlyingTenorGroupMapping[Weighting] )"
            ],
            "isHidden": true,
            "displayFolder": "TenorMeasures",
            "lineageTag": "6c8527e4-9bd9-4d83-a4a6-ca3aae658b87",
            "changedProperties": [
              {
                "property": "IsHidden"
              }
            ],
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "Measure Value in USD non_GovG4 format",
            "expression": "[Measure Value in USD non_GovG4]",
            "isHidden": true,
            "lineageTag": "9b20882b-0a19-4e2d-864b-6893d4afcde7",
            "formatStringDefinition": {
              "expression": [
                "SWITCH(TRUE(),",
                "ABS(SELECTEDMEASURE())< 1E6, \"#,0,.0k\",",
                "ABS(SELECTEDMEASURE())< 1E9, \"#,0,,.0m\",",
                "\"#,0,,,.0b\")"
              ]
            }
          },
          {
            "name": "Measure Value in USD non_GovG4",
            "expression": [
              "IF( ",
              "    SELECTEDVALUE('Reporting Measure Type'[Measure Type Name]) IN {\"CS01\",\"CS1%\",\"Market Value\"} && SELECTEDVALUE('Business Line 2'[Business Line])=\"Credit\",",
              "    CALCULATE(",
              "        [Measure Value in USD],",
              "        NOT(Instrument[Gov G4 Flag])",
              "    ),",
              "    [Measure Value in USD]",
              ")"
            ],
            "formatString": "0.00",
            "isHidden": true,
            "lineageTag": "69b6a20d-506f-415e-a792-54cdbfa54e78"
          },
          {
            "name": "Measure Value In USD Simple",
            "expression": [
              "IF (",
              "    [Use Sensi Trade Level DQ],",
              "    IF (",
              "        MIN ( 'Reporting Date'[IMPORTED_SENSITIVITY_DETAIL] ) = 1,",
              "        [Sensi Detail Import USD]",
              "            + /* used IF here as only required for the Fx Exposure measure type and this avoids DB calls on every query to the model */",
              "            IF (",
              "                SELECTEDVALUE ( 'Reporting Measure Type'[Reporting Measure Name] ) = \"Fx Exposure\",",
              "                [Cash Adjustment Original],",
              "                BLANK ()",
              "            ),",
              "        [Sensi Detail DQ Measure Value USD]",
              "    ),",
              "    IF (",
              "        [Use Sensi Summary Level DQ],",
              "        [Sensi Summary DQ Measure Value USD],",
              "        [Sensi Summary Import USD]",
              "            + /* used IF here as only required for the Fx Exposure measure type and this avoids DB calls on every query to the model */",
              "            IF (",
              "                SELECTEDVALUE ( 'Reporting Measure Type'[Reporting Measure Name] ) = \"Fx Exposure\",",
              "                [Cash Adjustment Original],",
              "                BLANK ()",
              "            )",
              "    )",
              ")"
            ],
            "isHidden": true,
            "displayFolder": "TenorMeasures",
            "lineageTag": "32cfbc31-39c0-473c-a115-99ee9f129020",
            "changedProperties": [
              {
                "property": "IsHidden"
              }
            ],
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "Measure Value In USD Tenor Group Weighting",
            "expression": [
              "VAR TenorGrp =",
              "    SUMMARIZECOLUMNS (",
              "        TenorGroupMapping[Weighting],",
              "        \"value\",",
              "        [Measure Value In USD Simple]",
              "    )",
              "RETURN",
              "    SUMX ( TenorGrp, [value] * TenorGroupMapping[Weighting] )"
            ],
            "isHidden": true,
            "displayFolder": "TenorMeasures",
            "lineageTag": "7a5ea597-a115-4172-9279-ace0457614cb",
            "changedProperties": [
              {
                "property": "IsHidden"
              }
            ],
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "Measure Value In USD Tenor Selection",
            "expression": [
              "",
              "SWITCH(",
              "       [Tenor Selection value],",
              "    0, [Measure Value In USD Simple],",
              "    1, [Measure Value In USD Tenor Group Weighting],",
              "    2, [Measure Value In USD Underlying Tenor Group Weighting],",
              "    3, [Measure Value In USD Both Tenor Group Weighting]",
              ")",
              ""
            ],
            "isHidden": true,
            "displayFolder": "TenorMeasures",
            "lineageTag": "33d440d4-98eb-4dcd-9def-168bee2396c6",
            "changedProperties": [
              {
                "property": "IsHidden"
              }
            ],
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "Measure Value In USD Underlying Tenor Group Weighting",
            "expression": [
              "VAR UTenorGrp =",
              "    SUMMARIZECOLUMNS (",
              "        UnderlyingTenorGroupMapping[Weighting],",
              "        \"value\",",
              "        [Measure Value In USD Simple]",
              "    )",
              "RETURN",
              "    SUMX ( UTenorGrp, [value] * UnderlyingTenorGroupMapping[Weighting] )"
            ],
            "isHidden": true,
            "displayFolder": "TenorMeasures",
            "lineageTag": "698e7cc2-9b4a-4a1c-ab4a-3f1c0e75b7ff",
            "changedProperties": [
              {
                "property": "IsHidden"
              }
            ],
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "Measure Value in USD",
            "expression": [
              "IF([Display Sensi],",
              "    IF(ISCROSSFILTERED('Reporting Measure Type'),",
              "        SWITCH(TRUE(),",
              "            SELECTEDVALUE('Reporting Measure Type'[Reporting Measure Name]) = \"WAS\", [WAS],",
              "            SELECTEDVALUE('Reporting Measure Type'[Reporting Measure Name]) = \"WASPerf-ABSCS01\", [WASPerf-ABSCS01],",
              "            SELECTEDVALUE('Reporting Measure Type'[Reporting Measure Name]) = \"WASPerf-ABSCS01CSPD\", [WASPerf-ABSCS01CSPD],",
              "            SELECTEDVALUE('Reporting Measure Type'[Reporting Measure Name]) = \"FX Exposure T-1\", [FxExpTminus1],",
              "            SELECTEDVALUE('Reporting Measure Type'[Reporting Measure Name]) = \"Gross MV\", [GrossMV],",
              "            SELECTEDVALUE('Reporting Measure Type'[Reporting Measure Name]) = \"Long MV\",[LongMV],",
              "            SELECTEDVALUE('Reporting Measure Type'[Reporting Measure Name]) = \"Short MV\",[ShortMV],",
              "            SELECTEDVALUE('Reporting Measure Type'[Measure Type Code]) = \"CashAdjustment\", [Cash Adjustment],",
              "            SELECTEDVALUE ( 'Reporting Measure Type'[Reporting Measure Name] ) = \"GOV01\", [GOV01],",
              "            SELECTEDVALUE ( 'Reporting Measure Type'[Reporting Measure Name] ) = \"CC01\", [CC01],",
              "            [Measure Value In USD Tenor Selection]",
              "        ),",
              "        [Measure Value In USD Tenor Selection]",
              "    )",
              "    ,BLANK()",
              ")"
            ],
            "formatString": "#,##0.00",
            "lineageTag": "2d82dafc-1f5b-409d-b4ce-e5076e1555e1"
          },
          {
            "name": "Organization_level",
            "expression": [
              "VAR _RLS = [RLS_Level]",
              "RETURN",
              "    SWITCH (",
              "        TRUE (),",
              "        ISBLANK ( _RLS ), BLANK (),",
              "        _RLS = \"ENT_DEP\",",
              "            IF (",
              "                NOT ( ISFILTERED ( 'Department 2'[Entity Department] ) ),",
              "                \"ENT_DEP\",",
              "                IF (",
              "                    HASONEVALUE ( 'Department 2'[Entity Department] ),",
              "                    \"ENT_DEP\",",
              "                    \"ENT_DEP_MULTI\"",
              "                )",
              "            ),",
              "        _RLS = \"BU\"",
              "            && NOT ( ISFILTERED ( 'Department 2'[Entity Department] ) )",
              "                && NOT ( ISFILTERED ( 'Department 2'[Volcker Desk] ) ),",
              "            IF (",
              "                NOT ( ISFILTERED ( 'Entity 2'[Entity Code] ) ),",
              "                \"BU\",",
              "                IF (",
              "                    ISFILTERED ( 'Entity 2'[Entity Code] ),",
              "                    IF ( HASONEVALUE ( 'Entity 2'[Entity Code] ), \"ENT_BU\", \"ENT_BU_MULTI\" )",
              "                )",
              "            ),",
              "        _RLS = \"ENT\"",
              "            && NOT ( ISFILTERED ( 'Department 2'[Entity Department] ) )",
              "                && NOT ( ISFILTERED ( 'Department 2'[Volcker Desk] ) ),",
              "            IF (",
              "                NOT ( ISFILTERED ( 'Business Line 2'[Business Line] ) ),",
              "                \"ENT\",",
              "                IF (",
              "                    ISFILTERED ( 'Business Line 2'[Business Line] ),",
              "                    IF (",
              "                        HASONEVALUE ( 'Business Line 2'[Business Line] ),",
              "                        \"ENT_BU\",",
              "                        \"ENT_BU_MULTI\"",
              "                    )",
              "                )",
              "            ),",
              "        _RLS = \"ENT_BU\"",
              "            && NOT ( ISFILTERED ( 'Department 2'[Entity Department] ) )",
              "                && NOT ( ISFILTERED ( 'Department 2'[Volcker Desk] ) ),",
              "            SWITCH (",
              "                TRUE (),",
              "                NOT ( ISFILTERED ( 'Business Line 2'[Business Line] ) )",
              "                    && NOT ( ISFILTERED ( 'Entity 2'[Entity Code] ) ), \"ENT_BU\",",
              "                ISFILTERED ( 'Business Line 2'[Business Line] )",
              "                    && NOT ( ISFILTERED ( 'Entity 2'[Entity Code] ) ),",
              "                    IF (",
              "                        HASONEVALUE ( 'Business Line 2'[Business Line] ),",
              "                        \"ENT_BU\",",
              "                        \"ENT_BU_MULTI\"",
              "                    ),",
              "                NOT ( ISFILTERED ( 'Business Line 2'[Business Line] ) )",
              "                    && ISFILTERED ( 'Entity 2'[Entity Code] ), IF ( HASONEVALUE ( 'Entity 2'[Entity Code] ), \"ENT_BU\", \"ENT_BU_MULTI\" ),",
              "                ISFILTERED ( 'Business Line 2'[Business Line] )",
              "                    && ISFILTERED ( 'Entity 2'[Entity Code] ),",
              "                    IF (",
              "                        HASONEVALUE ( 'Entity 2'[Entity Code] )",
              "                            && HASONEVALUE ( 'Business Line 2'[Business Line] ),",
              "                        \"ENT_BU\",",
              "                        \"ENT_BU_MULTI\"",
              "                    )",
              "            ),",
              "        IF (",
              "            ISFILTERED ( 'Department 2'[Entity Department] ),",
              "            IF (",
              "                HASONEVALUE ( 'Department 2'[Entity Department] ),",
              "                \"ENT_DEP\",",
              "                \"ENT_DEP_MULTI\"",
              "            ),",
              "            IF (",
              "                ISFILTERED ( 'Department 2'[Volcker Desk] ),",
              "                IF (",
              "                    HASONEVALUE ( 'Department 2'[Volcker Desk] ),",
              "                    IF ( ISFILTERED ( 'Entity 2'[Entity Code] ), \"ENT_VOLCKER\", \"VOLCKER\" ),",
              "                    \"VOLCKER_MULTI\"",
              "                ),",
              "                IF (",
              "                    ISFILTERED ( 'Business Line 2'[Business Line] ),",
              "                    IF (",
              "                        HASONEVALUE ( 'Business Line 2'[Business Line] ),",
              "                        IF (",
              "                            ISFILTERED ( 'Entity 2'[Entity Code] ),",
              "                            IF ( HASONEVALUE ( 'Entity 2'[Entity Code] ), \"ENT_BU\", \"ENT_BU_MULTI\" ),",
              "                            \"BU\"",
              "                        ),",
              "                        IF ( ISFILTERED ( 'Entity 2'[Entity Code] ), \"ENT_BU_MULTI\", \"BU_MULTI\" )",
              "                    ),",
              "                    IF (",
              "                        ISFILTERED ( 'Entity 2'[Entity Code] ),",
              "                        IF ( HASONEVALUE ( 'Entity 2'[Entity Code] ), \"ENT\", \"ENT_MULTI\" ),",
              "                        \"INT\"",
              "                    )",
              "                )",
              "            )",
              "        )",
              "    )"
            ],
            "isHidden": true,
            "lineageTag": "ea8e68e7-eb72-4236-9ca9-07be9c8ff70f"
          },
          {
            "name": "Original USD Both Tenor Group Weighting",
            "expression": [
              "VAR BothTenorGrp =",
              "    SUMMARIZECOLUMNS (",
              "        TenorGroupMapping[Weighting],",
              "        UnderlyingTenorGroupMapping[Weighting],",
              "        \"value\",",
              "        [Original USD Simple]",
              "    )",
              "RETURN",
              "    SUMX ( BothTenorGrp, [value] * TenorGroupMapping[Weighting] * UnderlyingTenorGroupMapping[Weighting] )"
            ],
            "isHidden": true,
            "displayFolder": "TenorMeasures",
            "lineageTag": "457d8e7a-a240-45c8-ad0f-4499cc916922",
            "changedProperties": [
              {
                "property": "IsHidden"
              }
            ],
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "Original USD Simple",
            "expression": [
              "IF (",
              "    [Use Sensi Trade Level DQ],",
              "    IF (",
              "        MIN ( 'Reporting Date'[IMPORTED_SENSITIVITY_DETAIL] ) = 1,",
              "        [Sensi Detail Import Original USD]",
              "        /* used IF here as only required for the Fx Exposure measure type and this avoids DB calls on every query to the model */",
              "            + IF (SELECTEDVALUE ( 'Reporting Measure Type'[Reporting Measure Name]) = \"Fx Exposure\",[Cash Adjustment Original],blank()),",
              "        [Sensi Detail DQ Measure Value USD Original]",
              "    ),",
              "    IF (",
              "        [Use Sensi Summary Level DQ],",
              "        [Sensi Summary DQ Measure Value USD Original],",
              "        [Sensi Summary Import Original USD]",
              "        /* used IF here as only required for the Fx Exposure measure type and this avoids DB calls on every query to the model */",
              "            + IF (SELECTEDVALUE ( 'Reporting Measure Type'[Reporting Measure Name]) = \"Fx Exposure\",[Cash Adjustment Original],blank())",
              "    )",
              ")"
            ],
            "isHidden": true,
            "displayFolder": "TenorMeasures",
            "lineageTag": "3f8cac25-0818-4bb4-ad08-c6f70e509fe7",
            "changedProperties": [
              {
                "property": "IsHidden"
              }
            ],
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "Original USD Tenor Group Weighting",
            "expression": [
              "VAR TenorGrp =",
              "    SUMMARIZECOLUMNS (",
              "        TenorGroupMapping[Weighting],",
              "        \"value\",",
              "        [Original USD Simple]",
              "    )",
              "RETURN",
              "    SUMX ( TenorGrp, [value] * TenorGroupMapping[Weighting] )"
            ],
            "isHidden": true,
            "displayFolder": "TenorMeasures",
            "lineageTag": "9d7667d6-fa1b-47ac-a7e1-e116fa117ee6",
            "changedProperties": [
              {
                "property": "IsHidden"
              }
            ],
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "Original USD Tenor Selection",
            "expression": [
              "",
              "SWITCH(",
              "       [Tenor Selection value],",
              "    0, [Original USD Simple],",
              "    1, [Original USD Tenor Group Weighting],",
              "    2, [Original USD Underlying Tenor Group Weighting],",
              "    3, [Original USD Both Tenor Group Weighting]",
              ")",
              ""
            ],
            "isHidden": true,
            "displayFolder": "TenorMeasures",
            "lineageTag": "7b2aef1b-f62c-4649-807c-4092e162ff02",
            "changedProperties": [
              {
                "property": "IsHidden"
              }
            ],
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "Original USD Underlying Tenor Group Weighting",
            "expression": [
              "VAR UTenorGrp =",
              "    SUMMARIZECOLUMNS (",
              "        UnderlyingTenorGroupMapping[Weighting],",
              "        \"value\",",
              "        [Original USD Simple]",
              "    )",
              "RETURN",
              "    SUMX ( UTenorGrp, [value] * UnderlyingTenorGroupMapping[Weighting] )"
            ],
            "isHidden": true,
            "displayFolder": "TenorMeasures",
            "lineageTag": "4b2cc0d3-de00-405a-9eec-0ae0938e6a76",
            "changedProperties": [
              {
                "property": "IsHidden"
              }
            ],
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "Previous Measure Value In Reporting Currency",
            "expression": [
              "",
              "VAR _Max_Prev_COBID = MAX ( 'Previous Reporting Date'[Previous COBID] )",
              "",
              "VAR Result = ",
              "CALCULATE (",
              "    [Measure Value In Reporting Currency],",
              "    FILTER (",
              "        ALL ( 'Reporting Date' ),",
              "        'Reporting Date'[COBId]",
              "            = _Max_Prev_COBID",
              "    )",
              ")",
              "Return ",
              "    Result",
              "   "
            ],
            "formatString": "#,##0.00",
            "lineageTag": "54f65dea-8e83-4cf2-94f4-f5a04df1f137"
          },
          {
            "name": "Previous Measure Value In USD",
            "expression": [
              "",
              "",
              "VAR _Max_Prev_COBID = MAX ( 'Previous Reporting Date'[Previous COBID] )",
              "VAR Result = ",
              "CALCULATE (",
              "    [Measure Value in USD],",
              "    FILTER (",
              "        ALL ( 'Reporting Date' ),",
              "        'Reporting Date'[COBId]",
              "            = _Max_Prev_COBID",
              "    )",
              ")",
              "RETURN ",
              "   Result"
            ],
            "formatString": "#,##0.00",
            "lineageTag": "ea6d1ae9-a8cb-48bf-a0ba-001ca3273ee0"
          },
          {
            "name": "Prior Day Measure Value In USD",
            "expression": [
              "",
              "CALCULATE(",
              "    [Measure Value in USD],",
              "    OFFSET(-1,ALLSELECTED('Reporting Date'[COBID]))",
              "    )"
            ],
            "formatString": "#,##0.00",
            "lineageTag": "0b401698-faac-4806-9f0b-fb7f90bb0c68"
          },
          {
            "name": "Sensi Daily Change",
            "expression": "IF([Prior Day Measure Value In USD], [Measure Value in USD] - [Prior Day Measure Value In USD],Blank())",
            "isHidden": true,
            "lineageTag": "ccdee563-15f6-4a54-96b2-a202d9d0a1dd",
            "changedProperties": [
              {
                "property": "IsHidden"
              }
            ],
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "Tenor Selection value",
            "expression": [
              "",
              "IF(",
              "    ISFILTERED('Tenor Group'[Tenor Group Code])||ISFILTERED('Tenor Group'[Tenor Group End Day])||ISFILTERED('Tenor Group'[Tenor Group Start Day]), ",
              "    1, ",
              "    0",
              ") + ",
              "IF(",
              "    ISFILTERED('Underlying Tenor Group'[Underlying Tenor Group Code])||ISFILTERED('Underlying Tenor Group'[Underlying Tenor Group End Day])||ISFILTERED('Underlying Tenor Group'[Underlying Tenor Group Start Day]), ",
              "    2,",
              "    0",
              ")"
            ],
            "formatString": "0",
            "isHidden": true,
            "displayFolder": "TenorMeasures",
            "lineageTag": "13cc2887-abad-498e-8aa4-32a2612247d8",
            "changedProperties": [
              {
                "property": "IsHidden"
              }
            ]
          },
          {
            "name": "Use Sensi Summary Level DQ",
            "expression": "MIN('Reporting Date'[IMPORTED_SENSITIVITY])=0",
            "formatString": "\"TRUE\";\"TRUE\";\"FALSE\"",
            "isHidden": true,
            "lineageTag": "8dbee4d7-362a-463e-97c3-8176c227e3bd",
            "changedProperties": [
              {
                "property": "IsHidden"
              }
            ]
          },
          {
            "name": "Use Sensi Trade Level DQ",
            "expression": "ISCROSSFILTERED(Trade[Trade Key]) || (ISCROSSFILTERED('Official Source') && MAX('Official Source'[OfficialSourceValue]) = 0)",
            "formatString": "\"TRUE\";\"TRUE\";\"FALSE\"",
            "isHidden": true,
            "lineageTag": "91c26244-12fc-42b7-beb8-07305c525963",
            "changedProperties": [
              {
                "property": "IsHidden"
              }
            ]
          },
          {
            "name": "WAS Original",
            "expression": "DIVIDE([WASPerf-ABSCS01CSPD Original] , [WASPerf-ABSCS01 Original])",
            "isHidden": true,
            "displayFolder": "CalculatedMeasures",
            "lineageTag": "d090297a-dadd-499c-b054-33d48674a34f",
            "changedProperties": [
              {
                "property": "IsHidden"
              }
            ],
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "WAS",
            "expression": "DIVIDE([WASPerf-ABSCS01CSPD], [WASPerf-ABSCS01])",
            "isHidden": true,
            "displayFolder": "CalculatedMeasures",
            "lineageTag": "20789c18-969b-4a1a-9db2-e346beabbcc6",
            "changedProperties": [
              {
                "property": "IsHidden"
              }
            ],
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "WASPerf-ABSCS01 Original",
            "expression": [
              "",
              "var was = ",
              "    SUMMARIZE(",
              "        'Instrument',",
              "        Instrument[COMMON_INSTRUMENT_KEY],",
              "        \"value\",",
              "        CALCULATE(",
              "            ABS([Original USD Tenor Selection]), ",
              "            FILTER(ALL('Reporting Measure Type'),'Reporting Measure Type'[Measure Type Code]=\"CS01\")",
              "        )",
              "    )",
              "return sumx(was, [value])"
            ],
            "isHidden": true,
            "displayFolder": "CalculatedMeasures",
            "lineageTag": "60ef20e6-d55f-4259-9437-985db2422757",
            "changedProperties": [
              {
                "property": "IsHidden"
              }
            ],
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "WASPerf-ABSCS01",
            "expression": [
              "",
              "var was = ",
              "    SUMMARIZE(",
              "        'Instrument',",
              "        Instrument[COMMON_INSTRUMENT_KEY],",
              "        \"value\",",
              "        CALCULATE(",
              "            ABS([Measure Value In USD Tenor Selection]), ",
              "            FILTER(ALL('Reporting Measure Type'),'Reporting Measure Type'[Measure Type Code]=\"CS01\")",
              "        )",
              "    )",
              "return sumx(was, [value])"
            ],
            "isHidden": true,
            "displayFolder": "CalculatedMeasures",
            "lineageTag": "63bced37-36fb-4a46-9d53-ad4c6b333199",
            "changedProperties": [
              {
                "property": "IsHidden"
              }
            ],
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "WASPerf-ABSCS01CSPD Original",
            "expression": [
              "",
              "var was = ",
              "    SUMMARIZE(",
              "        'Instrument',",
              "        'Instrument'[COMMON_INSTRUMENT_KEY],",
              "        \"maxcspd\", [Max CSPD],",
              "        \"value\",[WASPerf-ABSCS01 Original]",
              "    )",
              "return sumx(was, [value] * [maxcspd])"
            ],
            "isHidden": true,
            "displayFolder": "CalculatedMeasures",
            "lineageTag": "bad2862c-1671-45b3-af35-70e76fceb842",
            "changedProperties": [
              {
                "property": "IsHidden"
              }
            ],
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "WASPerf-ABSCS01CSPD",
            "expression": [
              "",
              "var was = ",
              "    SUMMARIZE(",
              "        'Instrument',",
              "        Instrument[COMMON_INSTRUMENT_KEY],",
              "        \"maxcspd\", [Max CSPD],",
              "        \"value\",[WASPerf-ABSCS01]",
              "    )",
              "return sumx(was, [value] * [maxcspd])"
            ],
            "isHidden": true,
            "displayFolder": "CalculatedMeasures",
            "lineageTag": "fc1f817b-7c38-4f59-83b5-c795f90a3014",
            "changedProperties": [
              {
                "property": "IsHidden"
              }
            ],
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "Measure Value Adjustment",
            "expression": [
              "IF([Tenor Selection value] = 0,",
              "    SUM('Sensitivity Detail Adjustment Import'[MEASURE_VALUE_INT] ) + SUM('Sensitivity Detail Adjustment Import'[MEASURE_VALUE_DECIMAL]),",
              "    BLANK()",
              "    )",
              "",
              ""
            ],
            "formatString": "#,##0.00",
            "displayFolder": "Original Currency",
            "lineageTag": "885f87f7-5166-43a2-aa63-d60f38de8dde"
          },
          {
            "name": "Measure Value Original",
            "expression": [
              " IF([Tenor Selection value] = 0,",
              "    SUM('Sensitivity Detail Import'[MEASURE_VALUE_INT]) + SUM('Sensitivity Detail Import'[MEASURE_VALUE_DECIMAL]),",
              "    BLANK()",
              "    )",
              "",
              ""
            ],
            "formatString": "#,##0.00",
            "displayFolder": "Original Currency",
            "lineageTag": "9e98a6b3-1776-4fae-8977-f845803811a7"
          },
          {
            "name": "Measure Value",
            "expression": "[Measure Value Original] + [Measure Value Adjustment]",
            "formatString": "#,##0.00",
            "displayFolder": "Original Currency",
            "lineageTag": "79680cd7-bc93-4fc0-81b7-9377ed55c33d"
          },
          {
            "name": "CC01 Original",
            "expression": [
              "CALCULATE (",
              "    [Original USD Tenor Selection],",
              "    REMOVEFILTERS ( 'Reporting Measure Type' ),",
              "    'Reporting Measure Type'[Reporting Measure Name] = \"CS01\",",
              "    KEEPFILTERS ( Instrument[Gov Or Non-Gov] <> \"Gov\" )",
              ")"
            ],
            "isHidden": true,
            "displayFolder": "CalculatedMeasures",
            "lineageTag": "772da6b2-be1b-48cc-8419-56e164e473ba"
          },
          {
            "name": "CC01",
            "expression": [
              "CALCULATE (",
              "    [Measure Value In USD Tenor Selection],",
              "    REMOVEFILTERS ( 'Reporting Measure Type' ),",
              "    'Reporting Measure Type'[Reporting Measure Name] = \"CS01\",",
              "    KEEPFILTERS ( Instrument[Gov Or Non-Gov] <> \"Gov\" )",
              ")"
            ],
            "isHidden": true,
            "displayFolder": "CalculatedMeasures",
            "lineageTag": "25d52761-55f6-4a43-9093-9023ce377593"
          },
          {
            "name": "GOV01 Original",
            "expression": [
              "CALCULATE (",
              "    [Original USD Tenor Selection],",
              "    REMOVEFILTERS ( 'Reporting Measure Type' ),",
              "    'Reporting Measure Type'[Reporting Measure Name] = \"CS01\"",
              ")"
            ],
            "isHidden": true,
            "displayFolder": "CalculatedMeasures",
            "lineageTag": "5df1c737-3311-4ebe-bbcc-9fb048feb03e"
          },
          {
            "name": "GOV01",
            "expression": [
              "CALCULATE (",
              "    [Measure Value In USD Tenor Selection],",
              "    REMOVEFILTERS ( 'Reporting Measure Type' ),",
              "    'Reporting Measure Type'[Reporting Measure Name] = \"CS01\"",
              ")"
            ],
            "isHidden": true,
            "displayFolder": "CalculatedMeasures",
            "lineageTag": "45a706a0-8e68-4548-bde8-792430bb63a3"
          }
        ],
        "annotations": [
