        "measures": [
          {
            "name": "Candlesticks_6M_Max",
            "expression": [
              "VAR _SUM_TABLE =",
              "    SUMMARIZECOLUMNS (",
              "        'MarketRiskMeasureDepartment'[COBID],",
              "        \"SUM\", [Sensi Historical Graph]",
              "    )",
              "RETURN",
              "    MAXX ( _SUM_TABLE, [SUM] )"
            ],
            "isHidden": true,
            "lineageTag": "0d258fd2-dc8f-416a-bd4f-491b9b6ee54a"
          },
          {
            "name": "Candlesticks_6M_Min",
            "expression": [
              "VAR _SUM_TABLE =",
              "    SUMMARIZECOLUMNS (",
              "        'MarketRiskMeasureDepartment'[COBID],",
              "        \"SUM\", [Sensi Historical Graph]",
              "    )",
              "RETURN",
              "    MINX ( _SUM_TABLE, [SUM] )"
            ],
            "isHidden": true,
            "lineageTag": "4f544b0e-2c7e-4af5-9d40-9b0cd1d67711"
          },
          {
            "name": "Candlesticks_No_Agg",
            "expression": [
              "VAR _HEIGHT = 25",
              "VAR _WIDTH = 100",
              "VAR _MARGIN_X = 2",
              "VAR _MARGIN_Y = 0",
              "VAR _VIEWBOX = \"'\"&-_MARGIN_X&\" \"&-_MARGIN_Y&\" \"&_WIDTH+_MARGIN_X&\" \"& _HEIGHT+_MARGIN_Y&\"'\"",
              "//Setting measures and positions for graphs (relative to dimensions)",
              "VAR _DIVISOR = SELECTEDVALUE('Reporting Measure Type'[PBI Format Divisor],1)",
              "VAR _EOD_Value = CALCULATE(SUM('MarketRiskMeasureDepartment'[MeasureValueUSD]),'Historic COB List'[COBID] = SELECTEDVALUE ( 'Reporting Date'[COBID] ))",
              "VAR _DIFF = _EOD_Value - CALCULATE (SUM ( 'MarketRiskMeasureDepartment'[MeasureValueUSD] ),'Historic COB List'[COBID]= SELECTEDVALUE ( 'Previous Reporting Date'[Previous COBID] ))",
              "VAR _OPEN_VALUE = IF(_DIFF<0, _EOD_Value, _EOD_Value-_DIFF)",
              "VAR _CLOSE_VALUE = IF(_DIFF>0,_EOD_Value, _EOD_Value-_DIFF)",
              "VAR _MIN_VALUE= [Candlesticks_6M_Min]",
              "VAR _MAX_VALUE= [Candlesticks_6M_Max]",
              "VAR _ALL_MIN_VALUE  = IF(ISINSCOPE('Department 2'[Entity Department]),MIN(MINX(SUMMARIZE(ALLSELECTED('Department 2'),'Department 2'[Entity Department],\"MIN\",[Candlesticks_6M_Min]),[MIN]),0),MIN(_MIN_VALUE,0))",
              "VAR _ALL_MAX_VALUE  = IF(ISINSCOPE('Department 2'[Entity Department]),MAX(MAXX(SUMMARIZE(ALLSELECTED('Department 2'),'Department 2'[Entity Department],\"MAX\",[Candlesticks_6M_Max]),[MAX]),0),MAX(_MAX_VALUE,0))",
              "VAR _RATIO = DIVIDE(_WIDTH, (_ALL_MAX_VALUE - _ALL_MIN_VALUE))",
              "VAR _AXIS_RANGE = (_MAX_VALUE - _MIN_VALUE) * _RATIO",
              "VAR _AXIS_START = (_MIN_VALUE - _ALL_MIN_VALUE) * _RATIO",
              "--VAR _AXIS_END = (_MAX_VALUE - _ALL_MIN_VALUE) * _RATIO",
              "VAR _BOX_END = (_CLOSE_VALUE - _ALL_MIN_VALUE) * _RATIO",
              "VAR _BOX_START = (_OPEN_VALUE - _ALL_MIN_VALUE) * _RATIO",
              "VAR _BOX_WIDTH = _BOX_END - _BOX_START",
              "VAR _ZERO_SPOT = (0  - _ALL_MIN_VALUE)*_RATIO",
              "VAR _BAR_COLOUR = IF(_DIFF<0,\"#E60000\",\"#2AABA0\")",
              "VAR _TEXT_COLOUR = IF(_DIFF<0,\"#E60000\",\"#000000\")",
              "RETURN",
              "SWITCH(TRUE(),",
              "ISINSCOPE('Department 2'[Entity Department]) && NOT(SELECTEDVALUE('Department 2'[Entity Department]) IN VALUES('Department 2'[Entity Department])),BLANK(),",
              "SELECTEDVALUE('View Type'[Change column display])=\"Numbers\",",
              "\"data:image/svg+xml;utf8,\" & ",
              "\"<svg width='\"&_WIDTH&\"' height='\"&_HEIGHT&\"' viewBox=\"&_viewbox&\" xmlns='http://www.w3.org/2000/svg' xmlns:xlink='http://www.w3.org/1999/xlink' overflow='visible'>",
              "<text alignment-baseline='hanging' text-anchor='middle' y='\"&_MARGIN_Y+3&\"' x='\"&_WIDTH/2&\"' font-size='14PX' font-style='italic' font-family='Calibri' fill='\"&_TEXT_COLOUR&\"'>\"&round(DIVIDE(_DIFF,_DIVISOR),1)&\"</text> </svg>\",",
              "ISBLANK(_EOD_Value),\"data:image/svg+xml;utf8,\" & ",
              "\"<svg width='\"&_WIDTH&\"' height='\"&_height&\"' viewBox=\"&_viewbox&\" xmlns='http://www.w3.org/2000/svg' xmlns:xlink='http://www.w3.org/1999/xlink' overflow='visible'>",
              "<line stroke-dasharray='10, 5' x1='\"& _zero_spot&\"' y1='0' x2='\"& _zero_spot&\"' y2='\"&_height&\"' style='stroke-width: 2px; stroke: rgb(90, 90, 90)'></line>",
              "</svg>\",",
              "\"data:image/svg+xml;utf8,\" & ",
              "\"<svg width='\"&_WIDTH&\"' height='\"&_height&\"' viewBox=\"&_viewbox&\" xmlns='http://www.w3.org/2000/svg' xmlns:xlink='http://www.w3.org/1999/xlink' overflow='visible'>",
              "<rect id='range' x='\"& _axis_start&\"' y='\"&_height*7.5/16&\"' width='\"&_axis_range&\"' height='\"&_height/16&\"' fill='black'/>",
              "<rect id='box' x='\"& _box_start &\"' y='\"&_height/3&\"' width='\"& _box_width &\"' height='\"&_height/3&\"' fill='\"& _bar_colour &\"'></rect> ",
              "<line stroke-dasharray='10, 5' x1='\"& _zero_spot&\"' y1='0' x2='\"& _zero_spot&\"' y2='\"&_height&\"' style='stroke-width: 2px; stroke: rgb(90, 90, 90)'></line>",
              "</svg>\")"
            ],
            "isHidden": true,
            "lineageTag": "393140b6-af75-483e-9e8d-f285f862c0fc",
            "dataCategory": "ImageUrl"
          },
          {
            "name": "Sensi 6M Max",
            "expression": [
              "VAR _DIVISOR = SELECTEDVALUE('Reporting Measure Type'[PBI Format Divisor],1)",
              "RETURN",
              "    DIVIDE ( [Candlesticks_6M_Max], _DIVISOR )"
            ],
            "formatString": "#,0.0",
            "isHidden": true,
            "lineageTag": "d3b86ef0-55a7-4a40-b956-8bd198b5a290"
          },
          {
            "name": "Sensi 6M Min",
            "expression": [
              "VAR _DIVISOR =",
              "    SELECTEDVALUE ( 'Reporting Measure Type'[PBI Format Divisor], 1 )",
              "RETURN",
              "    DIVIDE ( [Candlesticks_6M_Min], _DIVISOR )"
            ],
            "formatString": "#,0.0",
            "isHidden": true,
            "lineageTag": "8c0bcf6a-d9a4-418b-83d4-892adff6a3eb"
          },
          {
            "name": "Sensi Box Format",
            "expression": [
              "VAR _COBS =",
              "    FILTER (",
              "        'Historic COB List',",
              "        'Historic COB List'[COBID] = SELECTEDVALUE ( 'Reporting Date'[COBID] )",
              "    )",
              "VAR _SENSI =",
              "    CALCULATE ( SUM ( 'MarketRiskMeasureDepartment'[MeasureValueUSD] ), _COBS )",
              "VAR _LIMIT_FORMAT = [Current_Limit_Amount_Format]",
              "VAR _DISPLAY_UNITS =",
              "    SWITCH (",
              "        TRUE (),",
              "        ABS ( _SENSI ) < 1E6, \"$#,0,.0k\",",
              "        ABS ( _SENSI ) < 1E9, \"$#,0,,.0m\",",
              "        \"#,0,,,.0b\"",
              "    )",
              "VAR _FORMAT =",
              "    IF ( ISBLANK ( _Limit_Format ), _DISPLAY_UNITS, _Limit_Format )",
              "RETURN",
              "    FORMAT ( _SENSI, _FORMAT )"
            ],
            "isHidden": true,
            "lineageTag": "1b23e55d-aeec-4dee-910f-ac14ed682e8a"
          },
          {
            "name": "Sensi Change",
            "expression": [
              "VAR _SENSI =",
              "    CALCULATE ( SUM ( 'MarketRiskMeasureDepartment'[MeasureValueUSD] ),'Historic COB List'[COBID] = SELECTEDVALUE ( 'Reporting Date'[COBID] ) )",
              "VAR _DIFF =     ",
              "    _SENSI - CALCULATE (SUM ( 'MarketRiskMeasureDepartment'[MeasureValueUSD] ),'Historic COB List'[COBID]= SELECTEDVALUE ( 'Previous Reporting Date'[Previous COBID] ))",
              "    ",
              "VAR _DIVISOR = SELECTEDVALUE('Reporting Measure Type'[PBI Format Divisor],1)",
              "RETURN",
              "    DIVIDE ( _DIFF, _DIVISOR )",
              ""
            ],
            "formatString": "#,0.0",
            "isHidden": true,
            "lineageTag": "066e60a6-f824-4a06-9a02-2e55edc5f4f2"
          },
          {
            "name": "Sensi Current",
            "expression": [
              "VAR _SENSI =",
              "    CALCULATE ( SUM ( 'MarketRiskMeasureDepartment'[MeasureValueUSD] ), 'Historic COB List'[COBID] = SELECTEDVALUE ( 'Reporting Date'[COBID] ) )",
              "VAR _DIVISOR = SELECTEDVALUE('Reporting Measure Type'[PBI Format Divisor],1)",
              "RETURN",
              "    DIVIDE ( _SENSI, _DIVISOR )"
            ],
            "formatString": "#,0.0",
            "isHidden": true,
            "lineageTag": "3df596f2-61f9-4f85-b944-8185bfa457c7"
          },
          {
            "name": "Sensi Historical Graph",
            "expression": [
              "VAR _COBS =",
              "    FILTER ( 'Historic COB List', [6M_window_flag] = 1 )",
              "RETURN",
              "    CALCULATE ( SUM ( 'MarketRiskMeasureDepartment'[MeasureValueUSD] ), _COBS )"
            ],
            "formatString": "$#,0.##",
            "isHidden": true,
            "lineageTag": "715caab7-ec4d-47e8-878c-4ce869d65601"
          }
        ]
      },
