                "    #\"Renamed Columns\" = Table.RenameColumns(#\"Converted to Table\",{{\"Column1\", \"DateTime\"}}),",
                "    #\"Duplicated Column\" = Table.DuplicateColumn(#\"Renamed Columns\", \"DateTime\", \"DateTime - Copy\"),",
                "    #\"Duplicated Column1\" = Table.DuplicateColumn(#\"Duplicated Column\", \"DateTime\", \"DateTime - Copy.1\"),",
                "    #\"Changed Type\" = Table.TransformColumnTypes(#\"Duplicated Column1\",{{\"DateTime - Copy\", type date}}),",
                "    #\"Renamed Columns1\" = Table.RenameColumns(#\"Changed Type\",{{\"DateTime - Copy\", \"Date\"}, {\"DateTime - Copy.1\", \"Time\"}}),",
                "    #\"Changed Type1\" = Table.TransformColumnTypes(#\"Renamed Columns1\",{{\"Time\", type time}})",
                "in",
