            "    VAR_SUMMARY_IMPORT_View = FACT_Schema{[Name=\"VAR_SUMMARY_IMPORT\",Kind=\"View\"]}[Data],",
            "    #\"Filtered Rows\" = Table.SelectRows(VAR_SUMMARY_IMPORT_View, each [COB_DATE] >= RangeStart and [COB_DATE] < RangeEnd),",
            "    #\"Removed Columns\" = Table.RemoveColumns(#\"Filtered Rows\",{\"PNL_VECTOR_VALUE_IN_USD\", \"RUN_LOG_ID\"})",
