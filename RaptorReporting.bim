                "name": "PBI_ChangedProperties",
                "value": "[\"IsHidden\"]"
              }
            ]
          },
          {
            "name": "Simulation Pl Levels",
            "expression": [
              "",
              "IF([Display PNL],",
              "    IF([Use Stress Trade Level DQ], [Simulation Pl DQ Adjusted],",
              "        IF([Use Stress Summary Level DQ], [Simulation Pl Summary DQ Adjusted] , [Simulation Pl Import Adjusted] + [Simulation Pl Import Unadjusted Cyclic])",
              "    )",
              ",BLANK()",
              ")"
            ],
            "formatString": "#,0.00",
            "isHidden": true,
            "lineageTag": "e31f482d-d517-4826-b596-f38ee6e86d8f",
            "annotations": [
              {
                "name": "PBI_ChangedProperties",
                "value": "[\"FormatString\",\"IsHidden\"]"
              },
              {
                "name": "Format",
                "value": "<Format Format=\"NumberDecimal\" Accuracy=\"2\" ThousandSeparator=\"True\" />"
              }
            ]
          },
          {
            "name": "Simulation Pl MRM_GLB_Severe_Combined_Gain",
            "expression": [
              "SQRT(",
              "((",
              "SUMX({",
              "    [Simulation Pl MRM_GLB_Severe_CR_C_Gain],",
              "    [Simulation Pl MRM_GLB_Severe_RT_C_Gain],",
              "    [Simulation Pl MRM_GLB_Severe_EQ_C_Gain],",
              "    [Simulation Pl MRM_GLB_Severe_FX_C_Gain],",
              "    [Simulation Pl MRM_GLB_Severe_MG_C_Gain],",
              "    [Simulation Pl MRM_GLB_Severe_IF_C_Gain],",
              "    [Simulation Pl MRM_GLB_Severe_FB_C_Gain]",
              "    },[Value])",
              ")*[Stress Correlation Factor])^2",
              "   +",
              "(1-([Stress Correlation Factor])^2)*(",
              "([Simulation Pl MRM_GLB_Severe_CR_C_Gain])^2 +",
              "([Simulation Pl MRM_GLB_Severe_RT_C_Gain])^2 +",
              "([Simulation Pl MRM_GLB_Severe_EQ_C_Gain])^2 +",
              "([Simulation Pl MRM_GLB_Severe_FX_C_Gain])^2 +",
              "([Simulation Pl MRM_GLB_Severe_MG_C_Gain])^2 +",
              "([Simulation Pl MRM_GLB_Severe_IF_C_Gain])^2 +",
              "([Simulation Pl MRM_GLB_Severe_FB_C_Gain])^2",
              ")",
              ")"
            ],
            "isHidden": true,
            "displayFolder": "GLB_Simulations",
            "lineageTag": "a0a9b06f-2d3f-43fe-bfdc-dd5ef5ee4d3e",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              },
              {
                "name": "PBI_ChangedProperties",
                "value": "[\"IsHidden\"]"
              }
            ]
          },
          {
            "name": "Simulation Pl MRM_GLB_Severe_Combined_Loss",
            "expression": [
              "-SQRT(",
              "((",
              "SUMX({",
              "    [Simulation Pl MRM_GLB_Severe_CR_C_Loss],",
              "    [Simulation Pl MRM_GLB_Severe_RT_C_Loss],",
