              {
                "name": "PBI_ChangedProperties",
                "value": "[\"IsHidden\"]"
              }
            ]
          },
          {
            "name": "Original MRM_GLB_Severe_Combined_Gain",
            "expression": [
              "SQRT(",
              "((",
              "SUMX({",
              "    [Original MRM_GLB_Severe_CR_C_Gain],",
              "    [Original MRM_GLB_Severe_RT_C_Gain],",
              "    [Original MRM_GLB_Severe_EQ_C_Gain],",
              "    [Original MRM_GLB_Severe_FX_C_Gain],",
              "    [Original MRM_GLB_Severe_MG_C_Gain],",
              "    [Original MRM_GLB_Severe_IF_C_Gain],",
              "    [Original MRM_GLB_Severe_FB_C_Gain]",
              "    },[Value])",
              ")*[Stress Correlation Factor])^2",
              "   +",
              "(1-([Stress Correlation Factor])^2)*(",
              "([Original MRM_GLB_Severe_CR_C_Gain])^2 +",
              "([Original MRM_GLB_Severe_RT_C_Gain])^2 +",
              "([Original MRM_GLB_Severe_EQ_C_Gain])^2 +",
              "([Original MRM_GLB_Severe_FX_C_Gain])^2 +",
              "([Original MRM_GLB_Severe_MG_C_Gain])^2 +",
              "([Original MRM_GLB_Severe_IF_C_Gain])^2 +",
              "([Original MRM_GLB_Severe_FB_C_Gain])^2",
              ")",
              ")"
            ],
            "isHidden": true,
            "displayFolder": "GLB_Simulations",
            "lineageTag": "4e85b1e0-91fa-4c9c-b9db-2da4da33fe40"
          },
          {
            "name": "Original MRM_GLB_Severe_Combined_Loss",
            "expression": [
              "-SQRT(",
              "((",
              "SUMX({",
              "    [Original MRM_GLB_Severe_CR_C_Loss],",
              "    [Original MRM_GLB_Severe_RT_C_Loss],",
              "    [Original MRM_GLB_Severe_EQ_C_Loss],",
              "    [Original MRM_GLB_Severe_FX_C_Loss],",
              "    [Original MRM_GLB_Severe_MG_C_Loss],",
              "    [Original MRM_GLB_Severe_IF_C_Loss],",
              "    [Original MRM_GLB_Severe_FB_C_Loss]",
              "    },[Value])",
              ")*[Stress Correlation Factor])^2",
              "   +",
              "(1-([Stress Correlation Factor])^2)*(",
              "([Original MRM_GLB_Severe_CR_C_Loss])^2 +",
              "([Original MRM_GLB_Severe_RT_C_Loss])^2 +",
              "([Original MRM_GLB_Severe_EQ_C_Loss])^2 +",
              "([Original MRM_GLB_Severe_FX_C_Loss])^2 +",
