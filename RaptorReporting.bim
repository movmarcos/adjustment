                "    #\"Renamed Columns\" = Table.RenameColumns(VW_STRESS_CVA_SUMMARY_View,{{\"BOOK_CODE\", \"Book Code\"}, {\"DEPARTMENT_CODE\", \"Department Code\"}, {\"STRESS_SIMULATION_NAME\", \"Simulation Name\"}, {\"ENTITY_CODE\", \"Entity Code\"}})",
                "in",
                "    #\"Renamed Columns\""
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Difference Stress CVA",
            "expression": "[Stress CVA Pl] - [Stress CVA Previous]",
            "isHidden": true,
            "lineageTag": "ab1b8f01-b034-4e30-b7c2-bbd348b4dcbb",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "Remote CVA Stress Change",
            "expression": [
              "",
              " ",
              "VAR __BookCode =",
              "    MAX ( 'Book'[Book Code] )",
              "",
              "VAR _Result_BookLevel =",
              "    CALCULATE (",
              "        [Stress CVA Previous],",
              "        //[Difference Stress CVA],",
              "        'Stress CVA'[Book Code] = __BookCode,",
              "        'Stress CVA'[Simulation Name] = \"MRM_M_CVA_RemoteCreditSellOff\"",
              "    )",
              "",
              "VAR Result =",
              "    CALCULATE (",
              "        [Stress CVA Previous],",
              "        //[Difference Stress CVA],",
              "        'Stress CVA'[Simulation Name] = \"MRM_M_CVA_RemoteCreditSellOff\"",
              "    )",
              "RETURN",
              "        if (ISINScope ( 'Book'[Book Code] ) , _Result_BookLevel ,  Result   )"
            ],
            "isHidden": true,
            "lineageTag": "85c836ab-bfb7-4aeb-a97a-5e61031f21c2",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "Stress CVA Pl",
            "expression": "SUM('Stress CVA'[SIMULATION_PL_IN_USD])",
            "isHidden": true,
            "lineageTag": "581abd5d-ee55-498f-9b64-a1a11cda18bc",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "Stress CVA Previous",
            "expression": [
              "",
              "CALCULATE(",
              "    [Stress CVA Pl],",
              "    REMOVEFILTERS('Reporting Date'),",
              "    'Reporting Date'[COBId]=MAX('Previous Reporting Date'[Previous COBID])",
              "    )"
            ],
            "isHidden": true,
            "lineageTag": "ed1952ef-9805-4e14-ba8f-a738e73e9fd6",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          },
          {
            "name": "PBI_NavigationStepName",
            "value": "Navigation"
          }
        ]
