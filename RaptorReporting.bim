          {
            "name": "Original MRM_GLB_StdCP_Combined_Gain",
            "expression": [
              "SQRT(",
              "((",
              "SUMX({",
              "    [Original MRM_GLB_StdCP_CR_C_Gain],",
              "    [Original MRM_GLB_StdCP_RT_C_Gain],",
              "    [Original MRM_GLB_StdCP_EQ_C_Gain],",
              "    [Original MRM_GLB_StdCP_FX_C_Gain],",
              "    [Original MRM_GLB_StdCP_MG_C_Gain],",
              "    [Original MRM_GLB_StdCP_IF_C_Gain],",
              "    [Original MRM_GLB_StdCP_FB_C_Gain]",
              "    },[Value])",
              ")*[Stress Correlation Factor])^2",
              "   +",
              "(1-([Stress Correlation Factor])^2)*(",
              "([Original MRM_GLB_StdCP_CR_C_Gain])^2 +",
              "([Original MRM_GLB_StdCP_RT_C_Gain])^2 +",
              "([Original MRM_GLB_StdCP_EQ_C_Gain])^2 +",
              "([Original MRM_GLB_StdCP_FX_C_Gain])^2 +",
              "([Original MRM_GLB_StdCP_MG_C_Gain])^2 +",
              "([Original MRM_GLB_StdCP_IF_C_Gain])^2 +",
              "([Original MRM_GLB_StdCP_FB_C_Gain])^2",
              ")",
              ")"
            ],
            "isHidden": true,
            "displayFolder": "GLB_Simulations",
            "lineageTag": "0c9eb6b7-5a6b-49d3-bd82-a31e8ed3b2c8",
