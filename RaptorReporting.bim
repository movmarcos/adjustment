        "partitions": [
          {
            "name": "VaR Measures Summary Adhoc",
            "mode": "directQuery",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Snowflake.Databases(\"tj90313.west-europe.azure.snowflakecomputing.com\",WarehouseName),",
                "    RAPTOR_Database = Source{[Name=DBName,Kind=\"Database\"]}[Data],",
                "    FACT_Schema = RAPTOR_Database{[Name=\"FACT\",Kind=\"Schema\"]}[Data],",
                "    VAR_MEASURES_SUMMARY_ADHOC_View = FACT_Schema{[Name=\"VAR_MEASURES_SUMMARY_ADHOC\",Kind=\"View\"]}[Data]",
                "in",
                "    VAR_MEASURES_SUMMARY_ADHOC_View"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "PnL Adhoc Row Count",
            "expression": "COUNTROWS('VaR Measures Summary Adhoc')",
            "formatString": "0",
            "lineageTag": "ba3161d8-3e91-4c20-83ac-4a29903c0373"
          },
          {
            "name": "PnL Adhoc",
            "expression": "SUM('VaR Measures Summary Adhoc'[PNL_VECTOR_VALUE_IN_USD])",
            "lineageTag": "4e7ef1b4-cfe7-4659-9d2c-b6cae0db476e",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "VaR In Reporting Currency Adhoc",
            "expression": "DIVIDE([VaR In USD Adhoc], [Exchange Rate]) * [Currency Unit Value]",
            "lineageTag": "d44fa8f2-417f-40b5-9763-a33546044a17",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "VaR In USD Adhoc",
            "expression": [
              "IF(",
              "    [Display VAR], ",
              "    --true",
              "    IF(",
              "        [Use Trade Level DQ], ",
              "        --true ",
              "        [VaR Trade Adjusted Adhoc], ",
              "        --false ",
              "        [VaR In USD Summary Adjusted Adhoc]",
              "    )",
              "    , ",
              "    --false ",
              "    BLANK()",
              ")",
              ""
            ],
            "lineageTag": "d5a93770-8888-4104-a37a-19d4b102ac05",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "VaR In USD Summary Adjusted Adhoc",
            "expression": [
              "VAR SecondElementFraction = 1-[First Element Fraction]",
              "VAR ScenarioTable =  SUMMARIZE('VaR Measures Summary Adhoc','VaR Measures Summary Adhoc'[SCENARIO_DATE_ID] ,\"PnlVector\", [PnL Adhoc])",
              "VAR VaRVectors = TOPN(2,TOPN([Second Element Sl No Summary],ScenarioTable,[PnlVector],ASC),[PnlVector],DESC)",
              "RETURN  (((CALCULATE(MINX(VaRVectors,[PnlVector])) * [First Element Fraction]) +  (CALCULATE(MAXX(VaRVectors,[PnlVector])) * SecondElementFraction)) * [VaR Scaling Value] *-1)"
            ],
            "lineageTag": "a8156237-a48a-4bc9-9a70-d0f5b0ff95b6",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          }
        ],
        "annotations": [
          {
            "name": "PBI_NavigationStepName",
            "value": "Navigation"
          },
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ]
      },
