          {
            "type": "calculated",
            "name": "Underlying Simulation Name",
            "dataType": "string",
            "expression": [
              "IF (",
              "    ISBLANK (",
              "        LOOKUPVALUE (",
              "            'Stress Simulation PBI Report'[Stress Component],",
              "            'Stress Simulation PBI Report'[Stress Simulation Key], 'Stress Summary PBI Report'[Stress Simulation Key]",
              "        )",
              "    )",
              "        || LOOKUPVALUE (",
              "            'Stress Simulation PBI Report'[Stress Component],",
              "            'Stress Simulation PBI Report'[Stress Simulation Key], 'Stress Summary PBI Report'[Stress Simulation Key]",
              "        ) = \"All\",",
              "    LOOKUPVALUE (",
              "        'Stress Simulation PBI Report'[Simulation Name Simple],",
              "        'Stress Simulation PBI Report'[Stress Simulation Key], 'Stress Summary PBI Report'[Stress Simulation Key]",
              "    ),",
              "    LOOKUPVALUE (",
              "        'Stress Simulation PBI Report'[Stress Component],",
              "        'Stress Simulation PBI Report'[Stress Simulation Key], 'Stress Summary PBI Report'[Stress Simulation Key]",
              "    )",
              ")"
            ],
            "lineageTag": "a6fa40ce-01e4-4e2b-a948-6e62d738292f",
