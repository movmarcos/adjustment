      {
        "name": "VaR Measures Default",
        "partitions": [
          {
            "name": "VaR Measures Default",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText(\"i44FAA==\", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Column1 = _t]),",
                "    #\"Changed Type\" = Table.TransformColumnTypes(Source,{{\"Column1\", type text}}),",
                "    #\"Removed Columns\" = Table.RemoveColumns(#\"Changed Type\",{\"Column1\"})",
                "in",
                "    #\"Removed Columns\""
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Default Original PnL Vector Value In USD",
            "expression": [
              "",
              "CALCULATE([Original PnL Vector Value In USD]",
              "    , 'Book'[Is RM Excluded]=FALSE()",
              "    , 'VaR Sub Component'[Is All VaR] = FALSE()",
              "    , 'VaR Sub Component'[Is Prospective] = FALSE()",
              "    , 'VaR Sub Component'[VaR Sub Component Day Type]=1",
              "    , 'Official Source'[Is Official Source])"
            ],
            "formatString": "#,0.00",
            "lineageTag": "76a3bff9-db35-4285-a343-4112bd49f513",
            "annotations": [
              {
                "name": "Format",
