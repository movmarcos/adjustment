        "partitions": [
          {
            "name": "Trade",
            "mode": "dual",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Snowflake.Databases(\"tj90313.west-europe.azure.snowflakecomputing.com\", WarehouseName, null),",
                "    RAPTOR_Database = Source{[Name=DBName,Kind=\"Database\"]}[Data],",
                "    DIMENSION_Schema = RAPTOR_Database{[Name=\"DIMENSION\",Kind=\"Schema\"]}[Data],",
                "    TRADE_Table = DIMENSION_Schema{[Name=\"TRADE\",Kind=\"Table\"]}[Data],",
                "    #\"Filtered Rows\" = Table.SelectRows(TRADE_Table, each ([HAS_MR_FACTS] = true)),",
                "    #\"Removed Columns\" = Table.RemoveColumns(#\"Filtered Rows\",{\"GLOBAL_TRADE_REFERENCE\", \"BUY_SELL\", \"CALL_PUT\", \"NOMINAL_QUANTITY\", \"CALCULATED_NOMINAL_AMOUNT\", \"CONTRACT_CODE\", \"DELIVERY_MONTH\", \"FINANCIAL_INSTRUMENT_TYPE\", \"TRADE_STATUS\", \"TRADER_CODE\", \"LAST_UPDATED_TIME\", \"LOAD_SET\", \"IS_CURRENT_ROW\", \"IS_DELETED\", \"INSTRUMENT_KEY\", \"UNDERLYING_INSTRUMENT_KEY\", \"CURRENCY_RECEIVE\", \"INDEX_PRICE\", \"PROTECTION_BUY_SELL\", \"SETTLEMENT_CURRENCY\", \"SETTLEMENT_TYPE\", \"HAS_FACTS_SOURCE\", \"COUPON_STRIKE\", \"KO_STRIKE\", \"F_EXCH_STRIKE\", \"OBSERVATION_STRIKE\", \"BARRIER_TERMS\", \"BARRIER_RATE\", \"MUREX_INSTRUMENT_KEY\", \"INST_SECURITY_CODE\", \"REGION_AREA_CODE\", \"BINARY_CHECK_SUM\"}),",
                "    #\"Renamed Columns\" = Table.RenameColumns(#\"Removed Columns\",{{\"TRADE_CODE\", \"Trade Code\"}, {\"TRADE_TYPOLOGY\", \"Trade Typology\"}, {\"MUREX_FAMILY\", \"Murex Family\"}, {\"MUREX_GROUP\", \"Murex Group\"}, {\"MUREX_TYPE_DESCRIPTION\", \"Murex Type\"}, {\"STRIKE\", \"Strike\"}, {\"NOMINAL_AMOUNT\", \"Nominal Amount\"}, {\"NOMINAL_CURRENCY\", \"Nominal Currency\"}, {\"COUNTERPARTY_ORGANISATION_CODE\", \"Counter Party Org Code\"}, {\"TRADE_DATE\", \"Trade Date\"}, {\"TRADE_END_DATE\", \"Trade End Date\"}, {\"MUREX_INSTRUMENT\", \"Murex Instrument\"}, {\"EFFECTIVE_START_DATE\", \"Effective Start Date\"}, {\"EFFECTIVE_END_DATE\", \"Effective End Date\"}, {\"STRATEGY\", \"Strategy\"}, {\"SECURITY_CODE\", \"Trade Security Code\"}, {\"UNDERLYING_SECURITY_CODE\", \"Trade Underlying Security Code\"}, {\"UL_INDEX\", \"UL Index\"}, {\"MUREX_VERSION\", \"Murex Version\"}, {\"IN_SIMM_SCOPE\", \"In SIMM Scope\"}, {\"NETTING_SET_REFERENCE\", \"Netting Set Reference\"}, {\"INITIAL_TRADE_CODE\", \"Initial Trade Code\"}, {\"SWAP_MATURITY_DATE\", \"Swap Maturity Date\"}, {\"SABRE_TRADE_CODE\", \"Sabre Trade Code\"}, {\"COUNTERPARTY_CODE\", \"Counter Party Org Name\"}, {\"BOOK_CODE\", \"Book Code\"}, {\"TRADE_KEY\", \"Trade Key\"}, {\"INSTRUMENT_TYPE_DESCRIPTION\", \"Instrument Type Description\"}, {\"TRADE_DESCRIPTION\", \"Trade Description\"}, {\"TRADE_BEGIN_DATE\", \"Trade Begin Date\"}, {\"SECURITY_MARKET\", \"Trade Market Code\"}, {\"AVAILABLE_QUANTITY\", \"Available Quantity\"}, {\"NEXT_FIXING_DATE\", \"Next Fixing Date\"}}),",
                "    #\"Removed Columns1\" = Table.RemoveColumns(#\"Renamed Columns\",{\"SETTLEMENT_AMOUNT\"})",
                "in",
                "    #\"Removed Columns1\""
              ]
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          },
          {
            "name": "PBI_DescriptionAtRefresh"
          }
        ]
