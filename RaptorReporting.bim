              "    'Typology Class'[TradeTypology] = \"MTBA\", \"TBAs\",",
              "    'Typology Class'[TradeTypology]",
              "        IN { \"BDGV\", \"ETBF\", \"ETBO\", \"ETEO\", \"ETFT\", \"REPT\" }, \"IR Hedges\",",
              "    \"Other\"",
