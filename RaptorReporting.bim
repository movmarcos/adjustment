        "partitions": [
          {
            "name": "FRTBSA Measures",
            "mode": "directQuery",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Snowflake.Databases(\"tj90313.west-europe.azure.snowflakecomputing.com\",WarehouseName),",
                "    Database = Source{[Name=DBName,Kind=\"Database\"]}[Data],",
                "    Schema = Database{[Name=\"FACT\",Kind=\"Schema\"]}[Data],",
                "    Data = Schema{[Name=\"VW_FRTBSA_COMBINED_ADJUSTED_DQ\",Kind=\"View\"]}[Data]",
                "in",
                "    Data"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Difference FRTBSA Measure Value In Reporting Currency",
            "expression": "[FRTBSA Measure Value In Reporting Currency] - [Previous FRTBSA Measure Value In Reporting Currency]",
            "formatString": "#,##0.00",
            "lineageTag": "ed92d5f8-d5ff-4d2b-b7d2-e746de189ba2"
          },
          {
            "name": "Difference FRTBSA Measure Value USD",
            "expression": "[FRTBSA Measure Value USD] - [Previous FRTBSA Measure Value USD]",
            "formatString": "#,##0.00",
            "lineageTag": "1cb2aede-10e2-4a43-9ca5-460912b6ae18"
          },
          {
            "name": "FRTBSA Adjustment Value USD",
            "expression": "[FRTBSA Measure Value USD]-[FRTBSA Measure Original Value USD]",
            "formatString": "#,##0.00",
            "lineageTag": "1901ad05-1084-4f22-ad51-66ee2153d746"
          },
          {
            "name": "FRTBSA Measure Original Value In Reporting Currency",
            "expression": "DIVIDE([FRTBSA Measure Original Value USD], [Exchange Rate]) * [Currency Unit Value]",
            "lineageTag": "3f60d323-bf17-4f20-b893-e224e3a6a9b8"
          },
          {
            "name": "FRTBSA Measure Original Value USD",
            "expression": [
              "IF(HASONEVALUE('Official Source'[OfficialSourceValue])",
              "    , SUM( 'FRTBSA Measures'[MEASURE_VALUE_ORIGINAL_USD] )",
              "    , CALCULATE(",
              "        SUM( 'FRTBSA Measures'[MEASURE_VALUE_ORIGINAL_USD])",
              "        , 'FRTBSA Measures'[IS_OFFICIAL_SOURCE] = TRUE",
              "    )",
              ")",
              ""
            ],
            "formatString": "#,##0.00",
            "lineageTag": "ee364bbe-c07f-40ba-a635-1f9ed04158ea"
          },
          {
            "name": "FRTBSA Measure Value In Reporting Currency",
            "expression": "DIVIDE([FRTBSA Measure Value USD], [Exchange Rate]) * [Currency Unit Value]",
            "lineageTag": "e2a96076-a9c3-41f2-a9fe-b9861dfbcca7"
          },
          {
            "name": "FRTBSA Measure Value USD",
            "expression": [
              "IF(HASONEVALUE('Official Source'[OfficialSourceValue])",
              "    , SUM( 'FRTBSA Measures'[MEASURE_VALUE_USD] )",
              "    , CALCULATE(",
              "        SUM( 'FRTBSA Measures'[MEASURE_VALUE_USD] )",
              "        , 'FRTBSA Measures'[IS_OFFICIAL_SOURCE] = TRUE",
              "    )",
              ")",
              ""
            ],
            "formatString": "#,##0.00",
            "lineageTag": "50efb9ae-b39f-473c-b887-0d1e8f23eced"
          },
          {
            "name": "Previous FRTBSA Measure Value In Reporting Currency",
            "expression": [
              "",
              "",
              "VAR _Max_Prev_COBID = MAX ( 'Previous Reporting Date'[Previous COBID] )",
              "VAR Result = ",
              "CALCULATE (",
              "    [FRTBSA Measure Value In Reporting Currency],",
              "    FILTER (",
              "        ALL ( 'Reporting Date' ),",
              "        'Reporting Date'[COBId]",
              "            = _Max_Prev_COBID",
              "    )",
              ")",
              "RETURN ",
              "   Result"
            ],
            "lineageTag": "f65d300f-3417-4e66-8297-dae6ddc2d0fb"
          },
          {
            "name": "Previous FRTBSA Measure Value USD",
            "expression": [
              "",
              "",
              "VAR _Max_Prev_COBID = MAX ( 'Previous Reporting Date'[Previous COBID] )",
              "VAR Result = ",
              "CALCULATE (",
              "    [FRTBSA Measure Value USD],",
              "    FILTER (",
              "        ALL ( 'Reporting Date' ),",
              "        'Reporting Date'[COBId]",
              "            = _Max_Prev_COBID",
              "    )",
              ")",
              "RETURN ",
              "   Result"
            ],
            "lineageTag": "7ba42be4-d591-41ee-b725-b2da28141a7c"
          }
        ]
      },
