            "name": "Stress Properties",
            "mode": "dual",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Snowflake.Databases(\"tj90313.west-europe.azure.snowflakecomputing.com\",WarehouseName),",
                "    RAPTOR_Database = Source{[Name=DBName,Kind=\"Database\"]}[Data],",
                "    DIMENSION_Schema = RAPTOR_Database{[Name=\"DIMENSION\",Kind=\"Schema\"]}[Data],",
                "    STRESS_PROPERTIES_Table = DIMENSION_Schema{[Name=\"STRESS_PROPERTIES\",Kind=\"Table\"]}[Data],",
                "    #\"Renamed Columns\" = Table.RenameColumns(STRESS_PROPERTIES_Table,{{\"RISK_ANALYSIS_TYPE\", \"Risk Analysis Name\"}, {\"FILENAME\", \"Filename\"}, {\"SDL_JOB_BLOCK_NAME\", \"SDL Job Block Name\"}, {\"SOURCE_SYSTEM_CODE\", \"Stress Source System\"}})",
                "in",
                "    #\"Renamed Columns\""
              ]
            }
          }
        ],
