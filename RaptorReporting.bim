        ],
        "measures": [
          {
            "name": "Candlesticks Summary",
            "expression": [
              "VAR _HEIGHT = 25",
              "VAR _WIDTH = 80",
              "VAR _MARGIN_X = 2",
              "VAR _MARGIN_Y = 0",
              "VAR _VIEWBOX = \"'\"&-_MARGIN_X&\" \"&-_MARGIN_Y&\" \"&_WIDTH+_MARGIN_X&\" \"& _HEIGHT+_MARGIN_Y&\"'\"",
              "//Setting measures and positions for graphs (relative to dimensions)",
              "VAR _TOTAL_ROW = IF(ISINSCOPE('Spread Band'[Spread Band] ) ||",
              "ISINSCOPE( 'Rating Band'[Rating]) ||",
              "ISINSCOPE( 'Sensitivity Summary Fields'[Product Category Name]),",
              "0,1)",
              "VAR _DIVISOR = SELECTEDVALUE('Reporting Measure Type'[PBI Format Divisor],1)",
              "VAR _EOD_Value = CALCULATE(SUM( 'Sensitivity Summary Fields'[MEASURE_VALUE_USD]),'Historic COB List'[COBID] = SELECTEDVALUE ( 'Reporting Date'[COBID] ))",
              "VAR _Row_Values = CALCULATE(SUM('Sensitivity Summary Fields'[MEASURE_VALUE_USD]),REMOVEFILTERS('Department 2'[Entity Department]), REMOVEFILTERS('Entity 2'[Entity Code]), REMOVEFILTERS('Department 2'[Volcker Desk]))",
              "VAR _DIFF = _EOD_Value - CALCULATE (SUM ('Sensitivity Summary Fields'[MEASURE_VALUE_USD]),'Historic COB List'[COBID]= SELECTEDVALUE ( 'Previous Reporting Date'[Previous COBID] ))",
              "VAR _OPEN_VALUE = IF(_DIFF<0, _EOD_Value, _EOD_Value-_DIFF)",
              "VAR _CLOSE_VALUE = IF(_DIFF>0,_EOD_Value, _EOD_Value-_DIFF)",
              "VAR _MIN_VALUE= IF(_TOTAL_ROW = 0, [Candlesticks_6M_Min_Summary], [Candlesticks_6M_Min])",
              "VAR _MAX_VALUE= IF(_TOTAL_ROW = 0, [Candlesticks_6M_Max_Summary], [Candlesticks_6M_Max])",
              "VAR _ALL_MIN_VALUE_ROWS  = SWITCH(TRUE(),",
              "ISINSCOPE('Spread Band'[Spread Band] ), MINX(ADDCOLUMNS(ALLSELECTED('Spread Band'),\"MIN\",[Candlesticks_6M_Min_Summary]),[MIN]), ",
              "ISINSCOPE( 'Rating Band'[Rating]), MINX(ADDCOLUMNS(ALLSELECTED('Rating Band'),\"MIN\",[Candlesticks_6M_Min_Summary]),[MIN]),",
              "ISINSCOPE( 'Sensitivity Summary Fields'[Product Category Name]), MINX(ADDCOLUMNS(ALLSELECTED('Sensitivity Summary Fields'),\"MIN\",[Candlesticks_6M_Min_Summary]),[MIN]),",
              "BLANK())",
              "VAR _ALL_MAX_VALUE_ROWS  = SWITCH(TRUE(),",
              "ISINSCOPE('Spread Band'[Spread Band] ), MAXX(ADDCOLUMNS(ALLSELECTED('Spread Band'),\"MAX\",[Candlesticks_6M_Max_Summary]),[MAX]), ",
              "ISINSCOPE( 'Rating Band'[Rating]), MAXX(ADDCOLUMNS(ALLSELECTED('Rating Band'),\"MAX\",[Candlesticks_6M_Max_Summary]),[MAX]),",
              "ISINSCOPE( 'Sensitivity Summary Fields'[Product Category Name]), MAXX(ADDCOLUMNS(ALLSELECTED('Sensitivity Summary Fields'),\"MAX\",[Candlesticks_6M_Max_Summary]),[MAX]),",
              "BLANK())",
              "VAR _ALL_MIN_VALUE  = IF(_TOTAL_ROW = 0,MIN(_ALL_MIN_VALUE_ROWS,0) , MIN(_MIN_VALUE,0))",
              "VAR _ALL_MAX_VALUE  = IF(_TOTAL_ROW = 0,MAX(_ALL_MAX_VALUE_ROWS,0) , MAX(_MAX_VALUE,0))",
              "VAR _RATIO = DIVIDE(_WIDTH, (_ALL_MAX_VALUE - _ALL_MIN_VALUE))",
              "VAR _AXIS_RANGE = (_MAX_VALUE - _MIN_VALUE) * _RATIO",
              "VAR _AXIS_START = (_MIN_VALUE - _ALL_MIN_VALUE) * _RATIO",
              "VAR _BOX_END = (_CLOSE_VALUE - _ALL_MIN_VALUE) * _RATIO",
              "VAR _BOX_START = (_OPEN_VALUE - _ALL_MIN_VALUE) * _RATIO",
              "VAR _BOX_WIDTH = _BOX_END - _BOX_START",
              "VAR _ZERO_SPOT = (0  - _ALL_MIN_VALUE)*_RATIO",
              "VAR _BAR_COLOUR = IF(_DIFF<0,\"#E60000\",\"#2AABA0\")",
              "VAR _TEXT_COLOUR = IF(_DIFF<0,\"#E60000\",\"#000000\")",
              "RETURN",
              "SWITCH(TRUE(),",
              "ISBLANK(_Row_Values), BLANK(), ",
              "SELECTEDVALUE('View Type'[Change column display])=\"Numbers\",",
              "\"data:image/svg+xml;utf8,\" & ",
              "\"<svg width='\"&_WIDTH&\"' height='\"&_HEIGHT&\"' viewBox=\"&_viewbox&\" xmlns='http://www.w3.org/2000/svg' xmlns:xlink='http://www.w3.org/1999/xlink' overflow='visible'>",
              "<text alignment-baseline='hanging' text-anchor='middle' y='\"&_MARGIN_Y+3&\"' x='\"&_WIDTH/2&\"' font-size='14PX' font-style='italic' font-family='Calibri' fill='\"&_TEXT_COLOUR&\"'>\"&round(DIVIDE(_DIFF,_DIVISOR),1)&\"</text> </svg>\",",
              "ISBLANK(_EOD_Value) ,\"data:image/svg+xml;utf8,\" & ",
              "\"<svg width='\"&_WIDTH&\"' height='\"&_height&\"' viewBox=\"&_viewbox&\" xmlns='http://www.w3.org/2000/svg' xmlns:xlink='http://www.w3.org/1999/xlink' overflow='visible'>",
              "<line stroke-dasharray='10, 5' x1='\"& _zero_spot&\"' y1='0' x2='\"& _zero_spot&\"' y2='\"&_height&\"' style='stroke-width: 2px; stroke: rgb(90, 90, 90)'></line>",
              "</svg>\",",
              "\"data:image/svg+xml;utf8,\" & ",
              "\"<svg width='\"&_WIDTH&\"' height='\"&_height&\"' viewBox=\"&_viewbox&\" xmlns='http://www.w3.org/2000/svg' xmlns:xlink='http://www.w3.org/1999/xlink' overflow='visible'>",
              "<rect id='range' x='\"& _axis_start&\"' y='\"&_height*7.5/16&\"' width='\"&_axis_range&\"' height='\"&_height/16&\"' fill='black'/>",
              "<rect id='box' x='\"& _box_start &\"' y='\"&_height/3&\"' width='\"& _box_width &\"' height='\"&_height/3&\"' fill='\"& _bar_colour &\"'></rect> ",
              "<line stroke-dasharray='10, 5' x1='\"& _zero_spot&\"' y1='0' x2='\"& _zero_spot&\"' y2='\"&_height&\"' style='stroke-width: 2px; stroke: rgb(90, 90, 90)'></line>",
              "</svg>\")"
            ],
            "isHidden": true,
            "lineageTag": "c606fbdc-9570-4359-ba67-a677aba69c03",
            "dataCategory": "ImageUrl"
          },
          {
            "name": "Candlesticks_6M_Max_Summary",
            "expression": [
              "VAR _COBS =",
              "    FILTER ( 'Historic COB List', [6M_window_flag] = 1 )",
              "RETURN",
              "    SWITCH (",
              "        TRUE (),",
              "        ISINSCOPE ( 'Spread Band'[Spread Band] ),",
              "            MAXX (",
              "                SUMMARIZECOLUMNS (",
              "                    'Sensitivity Summary Fields'[COBID],",
              "                    'Spread Band'[Spread Band],",
              "                    \"SUM\", CALCULATE ( SUM ( 'Sensitivity Summary Fields'[MEASURE_VALUE_USD] ), _COBS )",
              "                ),",
              "                [SUM]",
              "            ),",
              "        ISINSCOPE ( 'Rating Band'[Rating] ),",
              "            MAXX (",
              "                SUMMARIZECOLUMNS (",
              "                    'Sensitivity Summary Fields'[COBID],",
              "                    'Rating Band'[Rating],",
              "                    \"SUM\", CALCULATE ( SUM ( 'Sensitivity Summary Fields'[MEASURE_VALUE_USD] ), _COBS )",
              "                ),",
              "                [SUM]",
              "            ),",
              "        ISINSCOPE ( 'Sensitivity Summary Fields'[Product Category Name] ),",
              "            MAXX (",
              "                SUMMARIZECOLUMNS (",
              "                    'Sensitivity Summary Fields'[COBID],",
              "                    'Sensitivity Summary Fields'[Product Category Name],",
              "                    \"SUM\", CALCULATE ( SUM ( 'Sensitivity Summary Fields'[MEASURE_VALUE_USD] ), _COBS )",
              "                ),",
              "                [SUM]",
              "            ),",
              "        MAXX (",
              "            SUMMARIZECOLUMNS (",
              "                'Sensitivity Summary Fields'[COBID],",
              "                \"SUM\", CALCULATE ( SUM ( 'Sensitivity Summary Fields'[MEASURE_VALUE_USD] ), _COBS )",
              "            ),",
              "            [SUM]",
              "        )",
              "    )"
            ],
            "isHidden": true,
            "lineageTag": "b0d55d14-e13f-4ac2-a6df-9da593bf957c"
          },
          {
            "name": "Candlesticks_6M_Min_Summary",
            "expression": [
              "VAR _COBS =",
              "    FILTER ( 'Historic COB List', [6M_window_flag] = 1 )",
              "RETURN",
              "    SWITCH (",
              "        TRUE (),",
              "        ISINSCOPE ( 'Spread Band'[Spread Band] ),",
              "            MINX (",
              "                SUMMARIZECOLUMNS (",
              "                    'Sensitivity Summary Fields'[COBID],",
              "                    'Spread Band'[Spread Band],",
              "                    \"SUM\", CALCULATE ( SUM ( 'Sensitivity Summary Fields'[MEASURE_VALUE_USD] ), _COBS )",
              "                ),",
              "                [SUM]",
              "            ),",
              "        ISINSCOPE ( 'Rating Band'[Rating] ),",
              "            MINX (",
              "                SUMMARIZECOLUMNS (",
              "                    'Sensitivity Summary Fields'[COBID],",
              "                    'Rating Band'[Rating],",
              "                    \"SUM\", CALCULATE ( SUM ( 'Sensitivity Summary Fields'[MEASURE_VALUE_USD] ), _COBS )",
              "                ),",
              "                [SUM]",
              "            ),",
              "        ISINSCOPE ( 'Sensitivity Summary Fields'[Product Category Name] ),",
              "            MINX (",
              "                SUMMARIZECOLUMNS (",
              "                    'Sensitivity Summary Fields'[COBID],",
              "                    'Sensitivity Summary Fields'[Product Category Name],",
              "                    \"SUM\", CALCULATE ( SUM ( 'Sensitivity Summary Fields'[MEASURE_VALUE_USD] ), _COBS )",
              "                ),",
              "                [SUM]",
              "            ),",
              "        MINX (",
              "            SUMMARIZECOLUMNS (",
              "                'Sensitivity Summary Fields'[COBID],",
              "                \"SUM\", CALCULATE ( SUM ( 'Sensitivity Summary Fields'[MEASURE_VALUE_USD] ), _COBS )",
              "            ),",
              "            [SUM]",
              "        )",
              "    )"
            ],
            "isHidden": true,
            "lineageTag": "b1904e7a-298c-4942-a165-da106f5a5862"
          },
          {
            "name": "Sensi 6M Max Summary",
            "expression": [
              "VAR _DIVISOR = SELECTEDVALUE('Reporting Measure Type'[PBI Format Divisor],1)",
              "RETURN",
              "    DIVIDE ( [Candlesticks_6M_Max_Summary], _DIVISOR )"
            ],
            "formatString": "#,0.0",
