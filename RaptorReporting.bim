            "name": "Official Source",
            "mode": "dual",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Snowflake.Databases(\"tj90313.west-europe.azure.snowflakecomputing.com\",WarehouseName),",
                "    RAPTOR_Database = Source{[Name=DBName,Kind=\"Database\"]}[Data],",
                "    DIMENSION_Schema = RAPTOR_Database{[Name=\"DIMENSION\",Kind=\"Schema\"]}[Data],",
                "    VW_OFFICIAL_SOURCE_View = DIMENSION_Schema{[Name=\"VW_OFFICIAL_SOURCE\",Kind=\"View\"]}[Data],",
                "    #\"Renamed Columns\" = Table.RenameColumns(VW_OFFICIAL_SOURCE_View,{{\"IS_OFFICIAL_SOURCE\", \"Is Official Source\"}, {\"IS_OFFICIAL_SOURCE_DESCRIPTION\", \"Is Official Source Description\"}})",
                "in",
                "    #\"Renamed Columns\""
              ]
            }
          }
        ],
