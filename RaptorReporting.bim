          {
            "name": "Stress Measures Cyclic DQ",
            "mode": "directQuery",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Snowflake.Databases(\"tj90313.west-europe.azure.snowflakecomputing.com\",WarehouseName),",
                "    RAPTOR_Database = Source{[Name=DBName,Kind=\"Database\"]}[Data],",
                "    FACT_Schema = RAPTOR_Database{[Name=\"FACT\",Kind=\"Schema\"]}[Data],",
                "    STRESS_MEASURES_SUMMARY_DQ_View = FACT_Schema{[Name=\"STRESS_MEASURES_SUMMARY_CYCLIC_DQ\",Kind=\"View\"]}[Data]",
                "in",
                "    STRESS_MEASURES_SUMMARY_DQ_View"
              ]
            }
          }
        ],
