              }
            ]
          },
          {
            "name": "Adjustment Last Process Date",
            "expression": "MAX(Adjustment[Process DateTime])",
            "formatString": "yyyy-mm-dd hh:nn:ss",
            "isHidden": true,
            "lineageTag": "6fa77362-0802-41d3-8e90-a5810a94f434",
            "changedProperties": [
              {
                "property": "IsHidden"
              }
            ],
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isDateTimeCustom\":true}"
              }
            ]
          },
          {
            "name": "Adjustment Import Indicator",
            "expression": [
              "",
              "IF([VaR Adjustment Count] <> 0,",
              "    IF(MAX('Reporting Date'[IMPORTED_VAR])=0, -1,",
              "        IF(AND([VaR Adjustment Imported]<>0, MAX(Adjustment[Is Deleted Numeric])=0) ",
              "            ||AND([VaR Adjustment Imported]=0, MAX(Adjustment[Is Deleted Numeric])=1)",
              "            , 1",
              "            , 0",
              "        )",
              "    )",
              ") +",
              "IF([Stress Adjustment Count] <> 0,",
              "    IF(MAX('Reporting Date'[IMPORTED_STRESS])=0, -1,",
              "        IF( AND([Stress Adjustment Imported]<>0, MAX(Adjustment[Is Deleted Numeric])=0) ",
              "            || AND([Stress Adjustment Imported]=0, MAX(Adjustment[Is Deleted Numeric])=1)",
              "            , 1",
              "            , 0",
              "        )",
              "    )",
              "    , blank()",
              ") +",
              "IF([Sensitivity Adjustment Count] <> 0,",
              "    IF(MAX('Reporting Date'[IMPORTED_SENSITIVITY])=0, -1,",
              "        IF( AND([Sensitivity Adjustment Imported]<>0, MAX(Adjustment[Is Deleted Numeric])=0",
              "        ) || AND([Sensitivity Adjustment Imported]=0, MAX(Adjustment[Is Deleted Numeric])=1)",
              "            , 1",
              "            , 0",
              "        )",
              "    )",
              "    , blank()",
              ")"
            ],
            "formatString": "0",
            "isHidden": true,
            "lineageTag": "6e30d6e0-fd91-4e98-8160-d244242e5ff7",
            "changedProperties": [
              {
                "property": "IsHidden"
              }
            ]
          },
          {
            "name": "Adjustment Record Count",
