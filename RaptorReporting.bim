      {
        "name": "Market Risk Measure Summary",
        "lineageTag": "4d458aff-e8e6-40ef-9b58-652e8176aa13",
        "partitions": [
          {
            "name": "Market Risk Measure Summary",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText(\"i45WMlSKjQUA\", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Column1 = _t]),",
                "    #\"Changed Type\" = Table.TransformColumnTypes(Source,{{\"Column1\", Int64.Type}}),",
                "    #\"Removed Columns\" = Table.RemoveColumns(#\"Changed Type\",{\"Column1\"})",
                "in",
                "    #\"Removed Columns\""
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "%Diff",
            "expression": [
              "DIVIDE( [Difference Measure Value in USD], [Previous Measure Value In USD] )",
              ""
            ],
            "formatString": "0%;-0%;0%",
            "isHidden": true,
            "lineageTag": "473c0de3-39f0-41a9-8a62-19db012d2c08",
            "changedProperties": [
              {
                "property": "IsHidden"
              }
            ]
          },
          {
            "name": "3M AVG Measure Value In Reporting Currency Formatted",
            "expression": "DIVIDE([3M AVG Measure Value In Reporting Currency] , [Format Divisor])",
            "formatString": "#,##0.00",
            "isHidden": true,
            "lineageTag": "2d9937f8-01dd-4276-84c5-79115912659e"
          },
          {
            "name": "3M AVG Measure Value In Reporting Currency",
            "expression": [
              "",
              "var currentCob = SELECTEDVALUE (",
              "    'Reporting Date'[Reporting Date],",
              "    MAX('Reporting Date'[Reporting Date])",
              "    )",
              "var FromDate = currentCob - 30",
              "",
              "var cobs = ",
              "    SUMMARIZE(",
              "        FILTER(",
              "            ALL('Reporting Date'), ",
              "            'Reporting Date'[Reporting Date] > FromDate && 'Reporting Date'[Reporting Date] <= currentCob",
              "        ) ",
              "        , 'Reporting Date'[COBID], ",
              "        \"value\", [Sensi Summary Import USD]",
              "    )",
              "return",
              "    AVERAGEX(cobs, [value])"
            ],
            "formatString": "#,##0.00",
            "isHidden": true,
            "lineageTag": "2d8a839c-e3b9-48f6-8d7a-ca9c87f7d4e0"
          },
          {
            "name": "Absolute Measure Value",
            "expression": "ABS([Measure Value In Reporting Currency])",
            "isHidden": true,
            "lineageTag": "ebc46a1c-39a9-49db-b179-488c4534e3ea",
            "changedProperties": [
              {
                "property": "IsHidden"
              }
            ],
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "Difference Measure Value In Reporting Currency Formatted",
            "expression": "DIVIDE([Difference Measure Value in reporting Currency],[Format Divisor])",
            "formatString": "#,##0.00",
            "lineageTag": "cfd7a5e4-9647-4f27-a2a1-a160d6ca902b"
          },
          {
            "name": "Difference Measure Value In Reporting Currency",
            "expression": "[Measure Value In Reporting Currency] - [Previous Measure Value In Reporting Currency]",
            "formatString": "#,##0.00",
            "lineageTag": "1c2a258d-0a78-4368-95d5-417d1a17f4cf"
          },
          {
            "name": "Difference Measure Value In USD",
            "expression": "[Measure Value in USD] - [Previous Measure Value In USD]",
            "formatString": "#,##0.00",
            "lineageTag": "aa15f66e-2df3-4992-ad83-2f55a796fef2"
          },
          {
            "name": "Difference Value in USD non_GovG4",
            "expression": [
              "",
              "    IF( ",
              "        SELECTEDVALUE('Reporting Measure Type'[Measure Type Name]) IN {\"CS01\",\"CS1%\",\"Market Value\"} && SELECTEDVALUE('Business Line 2'[Business Line])=\"Credit\"",
              "            ,CALCULATE([Difference Measure Value In USD],NOT(Instrument[Gov G4 Flag]))",
              "            ,[Difference Measure Value In USD]",
              "    )"
            ],
            "isHidden": true,
            "lineageTag": "3d7c42cd-2827-4c9b-8bf5-f9a7723a4989",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "Difference Value in USD non_GovG4_dynamic",
            "expression": "[Difference Value in USD non_GovG4]",
            "isHidden": true,
            "lineageTag": "45638b99-d662-4c84-9b2d-b858d51667d3",
            "formatStringDefinition": {
              "expression": [
                "SWITCH(TRUE(),",
                "ABS(SELECTEDMEASURE()) <1E6, \"#,0,.0k\",",
                "ABS(SELECTEDMEASURE()) <1E9, \"#,0,,.0m\",",
                "\"#,0,,,.0b\")"
              ]
            }
          },
          {
            "name": "Display Sensi",
            "expression": "[Date Filtered]=TRUE",
            "formatString": "\"TRUE\";\"TRUE\";\"FALSE\"",
            "isHidden": true,
            "lineageTag": "60a73c93-9a3a-4f35-9d58-538ba3c22259",
            "changedProperties": [
              {
                "property": "IsHidden"
              }
            ]
          },
          {
            "name": "FxExpTminus1 Original",
            "expression": [
              "",
              "var PrevDate = PREVIOUSDAY('Reporting Date'[Reporting Date])",
              "VAR checkFriday = IF(ISBLANK(PrevDate),dateadd('Reporting Date'[Reporting Date],-3,DAY), PrevDate)",
              "RETURN",
              "CALCULATE(",
              "    [Original USD Tenor Selection], ",
              "    filter(ALL('Reporting Measure Type'), 'Reporting Measure Type'[Reporting Measure Name]=\"Fx Exposure\"),",
              "    filter(All('Reporting Date'), 'Reporting Date'[Reporting Date] = checkFriday)",
              "    )"
            ],
            "isHidden": true,
            "displayFolder": "CalculatedMeasures",
            "lineageTag": "62e6ab46-bfff-4636-9a5c-3acf903a02a2",
            "changedProperties": [
              {
                "property": "IsHidden"
              }
            ],
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "FxExpTminus1",
            "expression": [
              "",
              "var PrevDate = PREVIOUSDAY('Reporting Date'[Reporting Date])",
              "VAR checkFriday = IF(ISBLANK(PrevDate),dateadd('Reporting Date'[Reporting Date],-3,DAY), PrevDate)",
              "RETURN",
              "CALCULATE(",
              "    [Measure Value In USD Tenor Selection], ",
              "    filter(ALL('Reporting Measure Type'), 'Reporting Measure Type'[Reporting Measure Name]=\"Fx Exposure\"),",
              "    filter(All('Reporting Date'), 'Reporting Date'[Reporting Date] = checkFriday)",
              "    )"
            ],
            "isHidden": true,
            "displayFolder": "CalculatedMeasures",
            "lineageTag": "5b2f06d5-65a3-40b8-ada8-b5cca8ee4955",
            "changedProperties": [
