            "isDataTypeInferred": true,
            "sourceColumn": "Window Element Historic[ENTITY_CODE]",
            "isAvailableInMdx": false
          },
          {
            "type": "calculatedTableColumn",
            "name": "VAR_WINDOW_ID",
            "dataType": "int64",
            "isNameInferred": true,
            "isDataTypeInferred": true,
            "sourceColumn": "Window Element Historic[VAR_WINDOW_ID]",
            "isAvailableInMdx": false,
            "summarizeBy": "none"
          },
          {
            "type": "calculatedTableColumn",
            "name": "VAR_WINDOW_NAME",
            "dataType": "string",
            "isNameInferred": true,
            "isDataTypeInferred": true,
            "sourceColumn": "[VAR_WINDOW_NAME]",
            "isAvailableInMdx": false
          },
          {
            "type": "calculatedTableColumn",
            "name": "VAR_WINDOW_NAME_DISPLAY",
            "dataType": "string",
            "isNameInferred": true,
            "isDataTypeInferred": true,
            "sourceColumn": "[VAR_WINDOW_NAME_DISPLAY]",
            "isAvailableInMdx": false
          },
          {
            "type": "calculatedTableColumn",
            "name": "WINDOW_RANK",
            "dataType": "int64",
            "isNameInferred": true,
            "isDataTypeInferred": true,
            "sourceColumn": "[WINDOW_RANK]",
            "isAvailableInMdx": false
          }
        ],
        "partitions": [
          {
            "name": "New Calculated Table",
            "mode": "import",
            "source": {
              "type": "calculated",
              "expression": [
                "ADDCOLUMNS (",
                "    SUMMARIZECOLUMNS (",
                "        'Window Element Historic'[ENTITY_CODE],",
                "        'Window Element Historic'[VAR_WINDOW_ID]",
                "    ),",
                "    \"VAR_WINDOW_NAME\",",
                "        SWITCH (",
                "            TRUE (),",
                "            'Window Element Historic'[VAR_WINDOW_ID] IN { 6, 21, 43, 52 }, \"1 Year VaR\",",
                "            'Window Element Historic'[VAR_WINDOW_ID] IN { 7, 22, 36, 44 }, \"2 Year VaR\",",
                "            'Window Element Historic'[VAR_WINDOW_ID] IN { 17, 32, 42, 51 }, \"Stressed VaR\",",
                "            BLANK ()",
                "        ),",
                "    \"VAR_WINDOW_NAME_DISPLAY\",",
                "        SWITCH (",
                "            TRUE (),",
                "            'Window Element Historic'[VAR_WINDOW_ID] IN { 6, 21, 43, 52 }, \"1Y 95%\",",
                "            'Window Element Historic'[VAR_WINDOW_ID] IN { 7, 22, 36, 44 }, \"2Y 99%\",",
                "            'Window Element Historic'[VAR_WINDOW_ID] IN { 17, 32, 42, 51 }, \"Stressed VaR 99%\",",
                "            BLANK ()",
                "        ),",
                "    \"WINDOW_RANK\",",
                "        SWITCH (",
                "            'Window Element Historic'[ENTITY_CODE],",
                "            \"MUSI\", 1,",
                "            \"MUSUSA\", 2,",
                "            \"MUSCAN\", 3,",
                "            \"MUSEU\", 4,",
                "            5",
                "        ),",
                "    \"CCY\",",
                "        SWITCH (",
                "            'Window Element Historic'[ENTITY_CODE],",
                "            \"MUSUSA\", \"USD\",",
                "            \"MUSCAN\", \"USD\",",
                "            \"MUSI\", \"GBP\",",
                "            \"MUSEU\", \"EUR\",",
                "            \"USD\"",
                "        ),",
                "    \"CCY_RANK\",",
                "        SWITCH (",
                "            'Window Element Historic'[ENTITY_CODE],",
                "            \"MUSUSA\", 1,",
                "            \"MUSCAN\", 2,",
                "            \"MUSI\", 3,",
                "            \"MUSEU\", 4,",
                "            5",
                "        )",
                ")"
              ]
            }
          }
        ]
      },
