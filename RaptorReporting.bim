          {
            "name": "Max_Limit_Amount",
            "expression": [
              "CALCULATE (",
              "    MAX ( 'Limit Department'[Amount] ),",
              "    USERELATIONSHIP ( 'Reporting Date'[COBID], 'Limit Department'[COBID] )",
              ")"
            ],
