            "    #\"Renamed Columns\" = Table.RenameColumns(STRESS_MEASURES_SUMMARY_IMPORT_CYCLIC_View,{{\"SIMULATION_PL_IN_USD\", \"Simulation PL in USD\"},{\"SIMULATION_PL_IN_USD_INT\", \"Simulation PL in USD INT\"},{\"SIMULATION_PL_IN_USD_DECIMAL\", \"Simulation PL in USD DECIMAL\"}}),",
            "    #\"Changed Type\" = Table.TransformColumnTypes(#\"Renamed Columns\",{{\"COB_DATE\", type datetime}}),",
