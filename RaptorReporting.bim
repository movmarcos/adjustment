            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText(\"i45WMlTSUTJUcEmsVIrVAfIMQFwDEL9YKTYWAA==\", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [#\"VaR Scaling Days\" = _t, #\"VaR Scaling Name\" = _t]),",
                "    #\"Changed Type\" = Table.TransformColumnTypes(Source,{{\"VaR Scaling Days\", Int64.Type}, {\"VaR Scaling Name\", type text}})",
                "in",
                "    #\"Changed Type\""
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "VaR Scaling Value",
            "expression": [
              "IF(NOT(HASONEVALUE('VaR Scaling'[VaR Scaling Days])), 1,",
              "        IF(MIN('VaR Sub Component'[VaR Sub Component Day Type])=10 && MAX('VaR Scaling'[VaR Scaling Days])=10, 1,",
              "            IF(MIN('VaR Sub Component'[VaR Sub Component Day Type])=10 && MAX('VaR Scaling'[VaR Scaling Days])=1, POWER(10,-0.5),",
              "                IF(MIN('VaR Sub Component'[VaR Sub Component Day Type])=1 && MAX('VaR Scaling'[VaR Scaling Days])=10, POWER(10,0.5),1))))"
            ],
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"General\" />"
              }
            ]
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          },
          {
            "name": "PBI_DescriptionAtRefresh"
          }
        ]
      },
