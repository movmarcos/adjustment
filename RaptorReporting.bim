          {
            "name": "Simulation Pl MRM_GLB_StdCP_Combined_Gain",
            "expression": [
              "SQRT(",
              "((",
              "SUMX({",
              "    [Simulation Pl MRM_GLB_StdCP_CR_C_Gain],",
              "    [Simulation Pl MRM_GLB_StdCP_RT_C_Gain],",
              "    [Simulation Pl MRM_GLB_StdCP_EQ_C_Gain],",
              "    [Simulation Pl MRM_GLB_StdCP_FX_C_Gain],",
              "    [Simulation Pl MRM_GLB_StdCP_MG_C_Gain],",
              "    [Simulation Pl MRM_GLB_StdCP_IF_C_Gain],",
              "    [Simulation Pl MRM_GLB_StdCP_FB_C_Gain]",
              "    },[Value])",
              ")*[Stress Correlation Factor])^2",
              "   +",
              "(1-([Stress Correlation Factor])^2)*(",
              "([Simulation Pl MRM_GLB_StdCP_CR_C_Gain])^2 +",
              "([Simulation Pl MRM_GLB_StdCP_RT_C_Gain])^2 +",
              "([Simulation Pl MRM_GLB_StdCP_EQ_C_Gain])^2 +",
              "([Simulation Pl MRM_GLB_StdCP_FX_C_Gain])^2 +",
              "([Simulation Pl MRM_GLB_StdCP_MG_C_Gain])^2 +",
              "([Simulation Pl MRM_GLB_StdCP_IF_C_Gain])^2 +",
