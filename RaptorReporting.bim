          {
            "type": "calculatedTableColumn",
            "name": "Count_Orig_Ent",
            "dataType": "int64",
            "isNameInferred": true,
            "isDataTypeInferred": true,
            "sourceColumn": "[Count_Orig_Ent]",
            "lineageTag": "a3ddc36d-b392-4b6d-9bea-b731de9fac72",
