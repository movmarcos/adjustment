        "partitions": [
          {
            "name": "BAMSignOff",
            "mode": "directQuery",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Snowflake.Databases(\"tj90313.west-europe.azure.snowflakecomputing.com\",SF_Warehouse),",
                "    MUSBI_Database = Source{[Name=SF_DBName,Kind=\"Database\"]}[Data],",
                "    GLOBAL_Schema = MUSBI_Database{[Name=\"GLOBAL\",Kind=\"Schema\"]}[Data],",
                "    BAMWORKFLOW_Table = GLOBAL_Schema{[Name=\"BAMWORKFLOW\",Kind=\"Table\"]}[Data],",
                "    #\"Filtered Rows\" = Table.SelectRows(BAMWORKFLOW_Table, each ([NAMEDESC] = \"Daily MRM VaR Report Approval\" or [NAMEDESC] = \"Daily MRM Stress Report Approval\" or [NAMEDESC] = \"Daily MRM Sensitivities Report Approval\" or [NAMEDESC] = \"Daily MRM Combined Metrics Report Approval\" or [NAMEDESC] = \"Daily MRM Comment\") and ([ISCURRENTROW] = 1) and ([STATUSCODE] <> \"WorkflowCancelled\")),",
                "    #\"Removed Columns\" = Table.RemoveColumns(#\"Filtered Rows\",{\"VERSION\", \"REGIONCODE\", \"ORGANISATIONLEVEL\", \"NAMEID\", \"TRIGGERMETHOD\", \"OWNER\", \"ENTRYDATE\", \"EFFECTIVESTARTDATE\", \"EFFECTIVEENDDATE\", \"ENTRYCOBID\"}),",
                "    #\"Renamed Columns\" = Table.RenameColumns(#\"Removed Columns\",{{\"ENTITYCODE\", \"EntityCode\"}, {\"ORGANISATIONVALUE\", \"OrganisationValue\"}, {\"NAMEDESC\", \"NameDesc\"}, {\"ISCURRENTROW\", \"IsCurrentRow\"}, {\"AUDIT\", \"User\"}, {\"STATUSCODE\", \"StatusCode\"}, {\"ENTRYTIME\", \"EntryTime\"}, {\"COMMENT\", \"Comment\"}})",
                "in",
                "    #\"Renamed Columns\""
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Blank_Measure",
            "expression": "\"\"",
            "isHidden": true,
            "lineageTag": "7757adcc-63c5-4387-9ac3-42737e624a6b"
          },
          {
            "name": "Block_SignOff",
            "expression": [
              "VAR _PENDING_ADJ = ",
              "IF(ISBLANK(COUNTROWS(FILTER('Pending Adjustments','Pending Adjustments'[Organisation Value] IN VALUES('Book'[Book Code]) || 'Pending Adjustments'[Organisation Value] IN VALUES('Department 2'[Entity Department Original]) || 'Pending Adjustments'[Organisation Value] IN VALUES('Department 2'[Entity Code Original])))), 0, 1)",
              "VAR _PENDING_ADJ_COMBINED = ",
              "IF(ISBLANK(CALCULATE(COUNTROWS(FILTER('Pending Adjustments','Pending Adjustments'[Organisation Value] IN VALUES('Book'[Book Code]) || 'Pending Adjustments'[Organisation Value] IN VALUES('Department 2'[Entity Department Original]) || 'Pending Adjustments'[Organisation Value] IN VALUES('Department 2'[Entity Code Original]))),REMOVEFILTERS('Sign-Off Types'))), 0, 1)",
              "RETURN",
              "IF(SELECTEDVALUE('Sign-Off Types'[Metric])= \"Combined\",_PENDING_ADJ_COMBINED,_PENDING_ADJ)"
            ],
            "isHidden": true,
            "lineageTag": "1e059215-70a2-49db-860b-22a3bfe4126e"
          },
          {
            "name": "signoff_icon",
            "expression": [
              "VAR _ORG_SIGNOFF =",
              "    UNION (",
              "        SELECTCOLUMNS ( BAMSignOff, \"OrganisationValue\", [OrganisationValue] ),",
              "        SELECTCOLUMNS (",
              "            CALCULATETABLE (",
              "                BAMSignOff,",
              "                REMOVEFILTERS ( 'Sign-Off Types' ),",
              "                'Sign-Off Types'[Metric] = \"Combined\"",
              "            ),",
              "            \"OrganisationValue\", [OrganisationValue]",
              "        )",
              "    )",
              "VAR _COLOUR =",
              "    SWITCH (",
              "        TRUE (),",
              "        ISBLANK (",
              "            COUNTROWS (",
              "                FILTER (",
              "                    'Department 2',",
              "                    NOT ( 'Department 2'[Entity Department] IN _ORG_SIGNOFF )",
              "                        && NOT ( 'Department 2'[Volcker Desk] IN _ORG_SIGNOFF )",
              "                        && NOT ( 'Department 2'[Entity Business Code] IN _ORG_SIGNOFF )",
              "                )",
              "            )",
              "        ), \"green\",",
              "        [Block_SignOff] = 1, \"rgb(230,0,0)\",",
              "        \"rgb(235,144,66)\"",
              "    )",
              "RETURN",
              "    \"data:image/svg+xml;utf8, <svg width='100' height='100' xmlns='http://www.w3.org/2000/svg'> <circle cx='50%' cy='50%' r='35%' stroke='black' stroke-width='3' fill='\" & _COLOUR & \"'/> </svg>\""
            ],
            "isHidden": true,
            "lineageTag": "3da6dd36-71dd-409c-af97-555053259c11",
            "dataCategory": "ImageUrl"
          },
          {
            "name": "signoff_icon_tooltip",
            "expression": [
              "VAR _ORG_SIGNOFF =",
              "    UNION (",
              "        SELECTCOLUMNS ( BAMSignOff, \"OrganisationValue\", [OrganisationValue] ),",
              "        SELECTCOLUMNS (",
              "            CALCULATETABLE (",
              "                BAMSignOff,",
              "                REMOVEFILTERS ( 'Sign-Off Types' ),",
              "                'Sign-Off Types'[Metric] = \"Combined\"",
              "            ),",
              "            \"OrganisationValue\", [OrganisationValue]",
              "        )",
              "    )",
              "VAR _COLOUR =",
              "    SWITCH (",
              "        TRUE (),",
              "        ISBLANK (",
              "            COUNTROWS (",
              "                FILTER (",
              "                    'Department 2',",
              "                    NOT ( 'Department 2'[Entity Department] IN _ORG_SIGNOFF )",
              "                        && NOT ( 'Department 2'[Volcker Desk] IN _ORG_SIGNOFF )",
              "                        && NOT ( 'Department 2'[Entity Business Code] IN _ORG_SIGNOFF )",
              "                )",
              "            )",
              "        ), \"green\",",
              "        [Block_SignOff] = 1, \"rgb(230,0,0)\",",
              "        \"rgb(235,144,66)\"",
              "    )",
              "RETURN",
              "    IF (",
              "        SELECTEDVALUE ( 'Department 2'[Entity Department] )",
              "            IN VALUES ( 'Department 2'[Entity Department] ),",
              "        \"data:image/svg+xml;utf8, <svg width='100' height='100' xmlns='http://www.w3.org/2000/svg'> <circle cx='50%' cy='50%' r='35%' stroke='black' stroke-width='3' fill='\" & _COLOUR & \"'/> </svg>\",",
              "        BLANK ()",
              "    )"
            ],
            "isHidden": true,
            "lineageTag": "9f9bbebe-ea7d-418e-8847-c7135e461dbf",
            "dataCategory": "ImageUrl"
          }
        ],
        "annotations": [
          {
            "name": "PBI_NavigationStepName",
            "value": "Navigation"
          },
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
