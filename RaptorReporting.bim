            "    #\"Renamed Columns\" = Table.RenameColumns(SENSITIVITY_SUMMARY_IMPORT_View,{{\"BASE_BETA_BAND_KEY\", \"Base Beta Band Key\"}, {\"BASE_SPREAD_BAND_KEY\", \"Base Spread Band Key\"}, {\"BOOK_KEY\", \"Book Key\"}, {\"COMMON_INSTRUMENT_KEY\", \"Common Instrument Key\"}, {\"CORRELATION_KEY\", \"Correlation Key\"}, {\"CURRENCY_CODE\", \"Currency Code\"}, {\"CURRENCY_PAIR_KEY\", \"Currency Pair Key\"}, {\"CURVE_CURRENCY_KEY\", \"Curve Key\"}, {\"ENTITY_KEY\", \"Entity Key\"}, {\"IS_OFFICIAL_SOURCE\", \"Is Official Source\"}, {\"MEASURE_TYPE_KEY\", \"Measure Type Key\"}, {\"MEASURE_VALUE_USD\", \"Measure Value USD\"}, {\"PRODUCT_CATEGORY_ATTRIBUTES_KEY\", \"Product Category Attributes Key\"}, {\"REGION_AREA_KEY\", \"Region Area Key\"}, {\"SKEW_KEY\", \"Skew Key\"}, {\"SOURCE_SYSTEM_CODE\", \"Source System Code\"}, {\"TENOR_CURRENCY_KEY\", \"Tenor Currency Key\"}, {\"UNDERLYING_TENOR_CURRENCY_KEY\", \"Underlying Tenor Currency Key\"}, {\"COUNTERPARTY_KEY\", \"Counterparty Key\"}, {\"COMMON_INSTRUMENT_FCD_KEY\", \"Common Instrument FCD Key\"}, {\"IS_DECOMPOSED\", \"Is Decomposed\"}}),",
            "    #\"Changed Type\" = Table.TransformColumnTypes(#\"Renamed Columns\",{{\"COBID\", Int64.Type}, {\"Entity Key\", Int64.Type}, {\"Book Key\", Int64.Type}, {\"Tenor Currency Key\", Int64.Type}, {\"Underlying Tenor Currency Key\", Int64.Type}, {\"Curve Key\", Int64.Type}, {\"Counterparty Key\", Int64.Type}, {\"Measure Type Key\", Int64.Type}, {\"Common Instrument Key\", Int64.Type}, {\"Common Instrument FCD Key\", Int64.Type}, {\"Currency Pair Key\", Int64.Type}, {\"Skew Key\", Int64.Type}, {\"Correlation Key\", Int64.Type}, {\"Region Area Key\", Int64.Type}, {\"Product Category Attributes Key\", Int64.Type}, {\"Base Spread Band Key\", Int64.Type}, {\"Base Beta Band Key\", Int64.Type}}),",
            "    #\"Filtered Rows\" = Table.SelectRows(SENSITIVITY_SUMMARY_IMPORT_View, each [COBID] >= DateKey(RangeStart) and [COBID] < DateKey(RangeEnd))",
            "in",
            "    #\"Filtered Rows\""
          ]
        },
