                "    #\"Renamed Columns1\""
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "VaR Component Level",
            "expression": [
              "IF(ISBLANK([VaR In Reporting Currency]),BLANK(),",
              "\tIF(NOT(ISFILTERED('VaR Sub Component')), \"All\",",
              "    IF(ISFILTERED('VaR Sub Component'[VaR Component Name]), \"VaR Component\",",
              "    IF(HASONEVALUE('VaR Sub Component'[VaR Component Group HO]), \"VaR Component Group HO\", \"All\"))))"
            ],
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"Text\" />"
              }
            ]
          }
        ],
