              "type": "m",
              "expression": [
                "let",
                "    Source = Snowflake.Databases(\"tj90313.west-europe.azure.snowflakecomputing.com\", WarehouseName, null),",
                "    RAPTOR_Database = Source{[Name=DBName,Kind=\"Database\"]}[Data],",
                "    DIMENSION_Schema = RAPTOR_Database{[Name=\"DIMENSION\",Kind=\"Schema\"]}[Data],",
                "    VW_ADJUSTMENT_View = DIMENSION_Schema{[Name=\"VW_PENDING_ADJ\",Kind=\"View\"]}[Data],",
                "    #\"Renamed Columns\" = Table.RenameColumns(VW_ADJUSTMENT_View,{{\"ADJUSTMENT_ID\", \"Adjustment Id\"}, {\"PROCESS_TYPE\", \"Process Type\"}, {\"PROCESS_DATETIME\", \"Process DateTime\"}, {\"ORGANISATIONVALUE\", \"Organisation Value\"}})",
                "in",
                "    #\"Renamed Columns\""
              ]
            }
          }
        ],
