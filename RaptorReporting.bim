          {
            "name": "Sensi 6M Max Detail",
            "expression": [
              "VAR _DIVISOR = SELECTEDVALUE('Reporting Measure Type'[PBI Format Divisor],1)",
              "RETURN",
              "    DIVIDE ( [Candlesticks_6M_Max_Detail], _DIVISOR )"
            ],
            "formatString": "#,0.0",
            "isHidden": true,
            "lineageTag": "8b81b2e2-dfb9-4767-9720-ae9a466e1226"
          },
          {
            "name": "Sensi 6M Min Detail",
            "expression": [
              "VAR _DIVISOR = SELECTEDVALUE('Reporting Measure Type'[PBI Format Divisor],1)",
              "RETURN",
              "    DIVIDE ( [Candlesticks_6M_Min_Detail], _DIVISOR )"
            ],
            "formatString": "#,0.0",
            "isHidden": true,
            "lineageTag": "368ca997-4a29-4f29-90c3-60db24f745b1"
          },
          {
            "name": "Sensi Change Detail",
            "expression": [
              "VAR _SENSI =",
              "    IF( SELECTEDVALUE ( 'Tenor Group'[Tenor Group Type Code] ) = \"STANDARD3\", CALCULATE ( SUM ( 'Sensitivity Detail Fields'[ST3 Value in USD] ),'Historic COB List'[COBID] = SELECTEDVALUE ( 'Reporting Date'[COBID] ) ),CALCULATE ( SUM ( 'Sensitivity Detail Fields'[ST1 Value in USD] ),'Historic COB List'[COBID] = SELECTEDVALUE ( 'Reporting Date'[COBID] ) ))",
              "VAR _DIFF =     ",
              "    _SENSI - IF( SELECTEDVALUE ( 'Tenor Group'[Tenor Group Type Code] ) = \"STANDARD3\", CALCULATE (SUM ( 'Sensitivity Detail Fields'[ST3 Value in USD] ),'Historic COB List'[COBID]= SELECTEDVALUE ( 'Previous Reporting Date'[Previous COBID] )),CALCULATE (SUM ( 'Sensitivity Detail Fields'[ST1 Value in USD] ),'Historic COB List'[COBID]= SELECTEDVALUE ( 'Previous Reporting Date'[Previous COBID] )))",
              "    ",
              "VAR _DIVISOR = SELECTEDVALUE('Reporting Measure Type'[PBI Format Divisor],1)",
              "RETURN",
              "    DIVIDE ( _DIFF, _DIVISOR )"
            ],
            "formatString": "#,0.0",
            "isHidden": true,
            "lineageTag": "49f2676a-fe3f-43f7-9a6b-b7cacf60afda"
          },
          {
            "name": "Sensi Current Detail",
            "expression": [
              "VAR _SENSI =",
              "    IF( SELECTEDVALUE ( 'Tenor Group'[Tenor Group Type Code] ) = \"STANDARD3\", CALCULATE ( SUM ( 'Sensitivity Detail Fields'[ST3 Value in USD] ),'Historic COB List'[COBID] = SELECTEDVALUE ( 'Reporting Date'[COBID] ) ),CALCULATE ( SUM ( 'Sensitivity Detail Fields'[ST1 Value in USD] ),'Historic COB List'[COBID] = SELECTEDVALUE ( 'Reporting Date'[COBID] ) ))",
              "VAR _DIVISOR = SELECTEDVALUE('Reporting Measure Type'[PBI Format Divisor],1)",
              "RETURN",
              "    DIVIDE ( _SENSI, _DIVISOR )"
            ],
            "formatString": "#,0.0",
            "isHidden": true,
            "lineageTag": "6cca673a-e787-4361-82f6-d33d46727d8b"
          }
        ],
