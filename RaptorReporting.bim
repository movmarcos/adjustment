        "measures": [
          {
            "name": "VaR Box Format",
            "expression": [
              "VAR _WINDOW_TABLE =",
              "    FILTER (",
              "        'VaR Window Historic',",
              "        'VaR Window Historic'[ENTITY_CODE] IN VALUES ( 'Department 2'[Entity Code Original] )",
              "    )",
              "VAR _WINDOW_ID =",
              "    MAXX ( TOPN ( 1, _WINDOW_TABLE, 'VaR Window Historic'[WINDOW_RANK], ASC ), 'VaR Window Historic'[VAR_WINDOW_ID] )",
              "VAR _CCY =",
              "    MAXX ( TOPN ( 1, _WINDOW_TABLE, 'VaR Window Historic'[CCY_RANK], ASC ), 'VaR Window Historic'[CCY] )",
              "VAR _CCY_SYMBOL =",
              "    SWITCH ( _CCY, \"USD\", \"$\", \"EUR\", \"€\", \"GBP\", \"£\" )",
              "VAR _FirstElementWeight =",
              "    CALCULATE (",
              "        MAX ( 'Fact Percentile Calc'[PERCENTILEFRACTIONFIRSTORDINALVALUE] ),",
              "        'Fact Percentile Calc'[VAR_WINDOW_ID] = _WINDOW_ID",
              "    )",
              "VAR _SecondElementWeight = 1 - _FirstElementWeight",
              "VAR _FirstElementRow =",
              "    CALCULATE (",
              "        MAX ( 'Fact Percentile Calc'[PERCENTILE_RANK_INTEGER_VALUE] ),",
              "        'Fact Percentile Calc'[VAR_WINDOW_ID] = _WINDOW_ID",
              "    )",
              "VAR _SecondElementRow = _FirstElementRow + 1",
              "VAR _ScenarioTable =",
              "    SUMMARIZECOLUMNS (",
              "        'VAR_SUMMARY_REPORT'[Scenario Date ID],",
              "        \"PnlVector\",",
              "            CALCULATE (",
              "                SUM ( 'VAR_SUMMARY_REPORT'[PNL Vector] ),",
              "                'Window Element Historic'[VAR_WINDOW_ID] = _WINDOW_ID,",
              "                'Historic COB List'[COBID] = SELECTEDVALUE ( 'Reporting Date'[COBID] )",
              "            )",
              "    )",
              "VAR _VaRVectors =",
              "    TOPN (",
              "        2,",
              "        TOPN ( _SecondElementRow, _ScenarioTable, [PnlVector], ASC ),",
              "        [PnlVector], DESC",
              "    )",
              "VAR _VaR =",
              "    DIVIDE (",
              "        (",
              "            (",
              "                ( CALCULATE ( MINX ( _VaRVectors, [PnlVector] ) ) * _FirstElementWeight )",
              "                    + ( CALCULATE ( MAXX ( _VaRVectors, [PnlVector] ) ) * _SecondElementWeight )",
              "            ) * -1",
              "        ),",
              "        CALCULATE (",
              "            MAX ( 'Exchange Rate'[EXCHANGE_RATE] ),",
              "            'Exchange Rate'[FROM_CURRENCY_CODE] = _CCY",
              "        )",
              "    )",
              "VAR _LIMIT_FORMAT = [Current_Limit_Amount_Format]",
              "VAR _DISPLAY_UNITS =",
              "    SWITCH (",
              "        TRUE (),",
              "        ABS ( _VaR ) < 1E6, \"#,0,.0k\",",
              "        ABS ( _VaR ) < 1E9, \"#,0,,.0m\",",
              "        \"#,0,,,.0b\"",
              "    )",
              "VAR _FORMAT =",
              "    IF ( ISBLANK ( _Limit_Format ), _CCY_SYMBOL & _DISPLAY_UNITS, _Limit_Format )",
              "RETURN",
              "    FORMAT ( _VaR, _FORMAT )"
            ],
            "isHidden": true,
            "lineageTag": "46e0d4c8-3746-449c-8163-7a54b8d09921"
          },
          {
            "name": "VaR Historical Graph",
            "expression": [
              "VAR _COBS =",
              "    FILTER ( 'Historic COB List', [6M_window_flag] = 1 )",
              "VAR _WINDOW_TABLE =",
              "    FILTER (",
              "        'VaR Window Historic',",
              "        'VaR Window Historic'[ENTITY_CODE] IN VALUES ( 'Department 2'[Entity Code Original] )",
              "    )",
              "VAR _WINDOW_ID =",
              "    MAXX (",
              "        TOPN ( 1, _WINDOW_TABLE, 'VaR Window Historic'[WINDOW_RANK], ASC ),",
              "        'VaR Window Historic'[VAR_WINDOW_ID]",
              "    )",
              "VAR _CCY =",
              "    MAXX (",
              "        TOPN ( 1, _WINDOW_TABLE, 'VaR Window Historic'[CCY_RANK], ASC ),",
              "        'VaR Window Historic'[CCY]",
              "    )",
              "VAR _FirstElementWeight =",
              "    CALCULATE (",
              "        MAX ( 'Fact Percentile Calc'[PERCENTILEFRACTIONFIRSTORDINALVALUE] ),",
              "        REMOVEFILTERS ( 'Reporting Date'[Default Date] ),",
              "        USERELATIONSHIP ( 'Historic COB List'[COBID], 'Fact Percentile Calc'[COBID] ),",
              "        'Fact Percentile Calc'[VAR_WINDOW_ID] = _WINDOW_ID,",
              "        _COBS",
              "    )",
              "VAR _SecondElementWeight = 1 - _FirstElementWeight",
              "VAR _FirstElementRow =",
              "    CALCULATE (",
              "        MAX ( 'Fact Percentile Calc'[PERCENTILE_RANK_INTEGER_VALUE] ),",
              "        REMOVEFILTERS ( 'Reporting Date'[Default Date] ),",
              "        USERELATIONSHIP ( 'Historic COB List'[COBID], 'Fact Percentile Calc'[COBID] ),",
              "        'Fact Percentile Calc'[VAR_WINDOW_ID] = _WINDOW_ID,",
              "        _COBS",
              "    )",
              "VAR _SecondElementRow = _FirstElementRow + 1",
              "VAR _ScenarioTable =",
              "    SUMMARIZECOLUMNS (",
              "        'VAR_SUMMARY_REPORT'[Scenario Date ID],",
              "        \"PnlVector\",",
              "            CALCULATE (",
              "                SUM ( 'VAR_SUMMARY_REPORT'[PNL Vector] ),",
              "                'Window Element Historic'[VAR_WINDOW_ID] = _WINDOW_ID,",
              "                _COBS",
              "            )",
              "    )",
              "VAR _VaRVectors =",
              "    TOPN (",
              "        2,",
              "        TOPN ( _SecondElementRow, _ScenarioTable, [PnlVector], ASC ),",
              "        [PnlVector], DESC",
              "    )",
              "RETURN",
              "    DIVIDE (",
              "        (",
              "            (",
              "                ( CALCULATE ( MINX ( _VaRVectors, [PnlVector] ) ) * _FirstElementWeight )",
              "                    + ( CALCULATE ( MAXX ( _VaRVectors, [PnlVector] ) ) * _SecondElementWeight )",
              "            ) * -1",
              "        ),",
              "        CALCULATE (",
              "            MAX ( 'Exchange Rate'[EXCHANGE_RATE] ),",
              "            REMOVEFILTERS ( 'Reporting Date'[Default Date] ),",
              "            USERELATIONSHIP ( 'Historic COB List'[COBID], 'Exchange Rate'[COBID] ),",
              "            'Exchange Rate'[FROM_CURRENCY_CODE] = _CCY",
              "        )",
              "    )"
            ],
            "formatString": "#,0.##",
            "isHidden": true,
            "lineageTag": "75844e97-d53f-4a3c-962d-f80d9cd4b25b"
          },
          {
            "name": "VaR Current",
            "expression": [
              "VAR _WINDOW_TABLE =",
              "    FILTER (",
              "        'VaR Window Historic',",
              "        'VaR Window Historic'[ENTITY_CODE]",
              "            IN VALUES ( 'Department 2'[Entity Code Original] )",
              "    )",
              "VAR _WINDOW_ID =",
              "    MAXX (",
              "        TOPN ( 1, _WINDOW_TABLE, 'VaR Window Historic'[WINDOW_RANK], ASC ),",
              "        'VaR Window Historic'[VAR_WINDOW_ID]",
              "    )",
              "VAR _CCY =",
              "    MAXX (",
              "        TOPN ( 1, _WINDOW_TABLE, 'VaR Window Historic'[CCY_RANK], ASC ),",
              "        'VaR Window Historic'[CCY]",
              "    )",
              "VAR _CCY_SYMBOL =",
              "    SWITCH ( _CCY, \"USD\", \"$\", \"EUR\", \"€\", \"GBP\", \"£\" )",
              "VAR _FirstElementWeight =",
              "    CALCULATE (",
              "        MAX ( 'Fact Percentile Calc'[PERCENTILEFRACTIONFIRSTORDINALVALUE] ),",
              "        'Fact Percentile Calc'[VAR_WINDOW_ID] = _WINDOW_ID",
              "    )",
              "VAR _SecondElementWeight = 1 - _FirstElementWeight",
              "VAR _FirstElementRow =",
              "    CALCULATE (",
              "        MAX ( 'Fact Percentile Calc'[PERCENTILE_RANK_INTEGER_VALUE] ),",
              "        'Fact Percentile Calc'[VAR_WINDOW_ID] = _WINDOW_ID",
              "    )",
              "VAR _SecondElementRow = _FirstElementRow + 1",
              "VAR _ScenarioTable =",
              "    SUMMARIZECOLUMNS (",
              "        'VAR_SUMMARY_REPORT'[Scenario Date ID],",
              "        \"PnlVector\",",
              "            CALCULATE (",
              "                SUM ( 'VAR_SUMMARY_REPORT'[PNL Vector] ),",
              "                'Window Element Historic'[VAR_WINDOW_ID] = _WINDOW_ID,",
              "                'Historic COB List'[COBID] = SELECTEDVALUE ( 'Reporting Date'[COBID] )",
              "            )",
              "    )",
              "VAR _VaRVectors =",
              "    TOPN (",
              "        2,",
              "        TOPN ( _SecondElementRow, _ScenarioTable, [PnlVector], ASC ),",
              "        [PnlVector], DESC",
              "    )",
              "RETURN",
              "    DIVIDE (",
              "        (",
              "            (",
              "                ( CALCULATE ( MINX ( _VaRVectors, [PnlVector] ) ) * _FirstElementWeight )",
              "                    + ( CALCULATE ( MAXX ( _VaRVectors, [PnlVector] ) ) * _SecondElementWeight )",
              "            ) * -1",
              "        ),",
              "        CALCULATE (",
              "            MAX ( 'Exchange Rate'[EXCHANGE_RATE] ),",
              "            'Exchange Rate'[FROM_CURRENCY_CODE] = _CCY",
              "        )",
              "    )"
            ],
            "formatString": "#,0.##",
            "isHidden": true,
            "lineageTag": "46f938b5-c833-4fd1-b2f0-7c9fcb452b7d"
          }
        ],
