            "source": {
              "type": "calculated",
              "expression": [
                "DATATABLE (",
                "    \"NameOrder\", INTEGER,",
                "    \"TRY Name\", STRING,",
                "    \"TRY Display Name\", STRING,",
                "    \"Format Divisor\", INTEGER,",
                "    {",
                "        { 1, \"Market Value\", \"Market Value ($m)\", 1000000 },",
                "        { 2, \"IR01\", \"IR01 ($k/-bp)\", 1000 },",
                "        { 3, \"CS01\", \"CS01 ($k/-bp)\", 1000 },",
                "        { 4, \"CS1%\", \"CS1% ($k/-1%)\", 1000 },",
                "        { 5, \"FX BASIS ORIGINAL\", \"FX Basis ($k/bp)\", 1000 },",
                "        { 6, \"Equity Delta\", \"Equity Delta ($m)\", 1000000 },",
                "        { 7, \"Fx Exposure\", \"FX Exposure ($m)\", 1000000 }",
                "    }",
                ")"
              ]
            }
          }
        ]
