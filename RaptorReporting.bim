        "measures": [
          {
            "name": "Current_Limit_Amount_Format",
            "expression": [
              "VAR _COBS =",
              "    FILTER (",
              "        'Historic COB List',",
              "        'Historic COB List'[COBID] = SELECTEDVALUE ( 'Reporting Date'[COBID] )",
              "    )",
              "VAR _ORG_LVL_MEAS = [Organization_level]",
              "VAR _ENTITY =",
              "    SWITCH (",
              "        TRUE (),",
              "        ISBLANK ( _ORG_LVL_MEAS ), BLANK (),",
              "        _ORG_LVL_MEAS IN { \"VOLCKER\", \"VOLCKER_MULTI\" },",
              "            IF (",
              "                LEFT ( RIGHT ( SELECTEDVALUE ( 'Department 2'[Volcker Desk] ), 4 ), 2 ) = \"UK\",",
              "                \"MUSI\",",
              "                SELECTEDVALUE ( 'Department 2'[Entity Code Original] )",
              "            ),",
              "        _ORG_LVL_MEAS",
              "            IN {",
              "                \"ENT\",",
              "                \"ENT_BU\",",
              "                \"ENT_VOLCKER\",",
              "                \"ENT_MULTI\",",
              "                \"ENT_BU_MULTI\",",
              "                \"ENT_VOLCKER_MULTI\"",
              "            }, SELECTEDVALUE ( 'Entity 2'[Entity Code Original] ),",
              "        _ORG_LVL_MEAS IN { \"ENT_DEP\", \"ENT_DEP_MULTI\" }, SELECTEDVALUE ( 'Department 2'[Entity Code Original] ),",
              "        \"MUS\"",
              "    )",
              "VAR _ORGANISATION =",
              "    SWITCH (",
              "        TRUE (),",
              "        _ORG_LVL_MEAS = \"ENT_DEP\", SELECTEDVALUE ( 'Department 2'[Department Code] ),",
              "        _ORG_LVL_MEAS IN { \"VOLCKER\", \"ENT_VOLCKER\" }, SELECTEDVALUE ( 'Department 2'[Volcker Desk] ),",
              "        _ORG_LVL_MEAS IN { \"BU\", \"ENT_BU\" }, SELECTEDVALUE ( 'Business Line 2'[Business Unit Code] ),",
              "        _ORG_LVL_MEAS = \"ENT\", _ENTITY,",
              "        _ORG_LVL_MEAS = \"INT\", \"MUS\"",
              "    )",
              "VAR _SENSI_SELECTED =",
              "    SELECTEDVALUE ( 'Reporting Measure Type'[Reporting Measure Name] )",
              "VAR _STRESS_SELECTED =",
              "    SELECTEDVALUE ( 'Stress Simulation PBI Report'[Simulation Name Simple] )",
              "VAR _VAR_SELECTED =",
              "    SELECTEDVALUE ( 'VaR Window Historic'[VAR_WINDOW_NAME] )",
              "VAR _COMPARATIVE =",
              "    SELECTEDVALUE ( 'Limit Department'[Comparative] )",
              "VAR _USAGE =",
              "    SWITCH (",
              "        _COMPARATIVE,",
              "        \"Sensitivity\", _SENSI_SELECTED,",
              "        \"Stress\", _STRESS_SELECTED,",
              "        _VAR_SELECTED",
              "    )",
              "VAR _DETAIL =",
              "    SWITCH(",
              "        _COMPARATIVE,",
              "        \"VaR\", LEFT ( SELECTEDVALUE ( 'VaR Percentile'[VaR Percentile Value], BLANK () ), 4 ),",
              "        \"Stress\",SELECTEDVALUE ( 'Stress Simulation PBI Report'[Stress Simulation Name] ),",
              "        BLANK ()",
              "    )",
              "VAR _LIMIT_CCY_CODE =",
              "    BLANK ()",
              "RETURN",
              "    CALCULATE (",
              "        MIN ( 'Limit Department'[Current Limit Format] ),",
              "        _COBS,",
              "        'Limit Department'[Usage] = _USAGE,",
              "        'Limit Department'[Entity] = _ENTITY,",
              "        'Limit Department'[Organisation] = _ORGANISATION,",
              "        'Limit Department'[Detail] = _DETAIL,",
              "        'Limit Department'[Limit Currency Code] = _LIMIT_CCY_CODE",
              "    )"
            ],
            "isHidden": true,
            "lineageTag": "0824bcdb-b2c3-4709-8970-70fdbaeb63ee"
          },
          {
            "name": "Current_Limit_Amount_Long",
            "expression": [
              "CALCULATE (",
              "    [Limit_Amount_Long],",
              "    'Historic COB List'[COBID] = SELECTEDVALUE ( 'Reporting Date'[COBID] )",
              ")"
            ],
            "isHidden": true,
            "lineageTag": "aa34d543-dcf1-45d6-b5ea-a26887d21b95",
            "formatStringDefinition": {
              "expression": "[Current_Limit_Amount_Format]"
            }
          },
          {
            "name": "Current_Limit_Amount_Short",
            "expression": [
              "CALCULATE (",
              "    [Limit_Amount_Short],",
              "    'Historic COB List'[COBID] = SELECTEDVALUE ( 'Reporting Date'[COBID] )",
              ")"
            ],
            "isHidden": true,
            "lineageTag": "e8e0ab2e-d425-4b0a-8394-ae58e4e0b826",
            "formatStringDefinition": {
              "expression": "[Current_Limit_Amount_Format]"
            }
          },
          {
            "name": "Limit_Amount_Long",
            "expression": [
              "VAR _COBS =",
              "    FILTER ( 'Historic COB List', [6M_window_flag] = 1 )",
              "VAR _ORG_LVL_MEAS = [Organization_level]",
              "VAR _ENTITY =",
              "    SWITCH (",
              "        TRUE (),",
              "        ISBLANK ( _ORG_LVL_MEAS ), BLANK (),",
              "        _ORG_LVL_MEAS IN { \"VOLCKER\", \"VOLCKER_MULTI\" },",
              "            IF (",
              "                LEFT ( RIGHT ( SELECTEDVALUE ( 'Department 2'[Volcker Desk] ), 4 ), 2 ) = \"UK\",",
              "                \"MUSI\",",
              "                SELECTEDVALUE ( 'Department 2'[Entity Code Original] )",
              "            ),",
              "        _ORG_LVL_MEAS",
              "            IN {",
              "                \"ENT\",",
              "                \"ENT_BU\",",
              "                \"ENT_VOLCKER\",",
              "                \"ENT_MULTI\",",
              "                \"ENT_BU_MULTI\",",
              "                \"ENT_VOLCKER_MULTI\"",
              "            }, SELECTEDVALUE ( 'Entity 2'[Entity Code Original] ),",
              "        _ORG_LVL_MEAS IN { \"ENT_DEP\", \"ENT_DEP_MULTI\" }, SELECTEDVALUE ( 'Department 2'[Entity Code Original] ),",
              "        \"MUS\"",
              "    )",
              "VAR _ORGANISATION =",
              "    SWITCH (",
              "        TRUE (),",
              "        _ORG_LVL_MEAS = \"ENT_DEP\", SELECTEDVALUE ( 'Department 2'[Department Code] ),",
              "        _ORG_LVL_MEAS IN { \"VOLCKER\", \"ENT_VOLCKER\" }, SELECTEDVALUE ( 'Department 2'[Volcker Desk] ),",
              "        _ORG_LVL_MEAS IN { \"BU\", \"ENT_BU\" }, SELECTEDVALUE ( 'Business Line 2'[Business Unit Code] ),",
              "        _ORG_LVL_MEAS = \"ENT\", _ENTITY,",
              "        _ORG_LVL_MEAS = \"INT\", \"MUS\"",
              "    )",
              "VAR _SENSI_SELECTED =",
              "    SELECTEDVALUE ( 'Reporting Measure Type'[Reporting Measure Name] )",
              "VAR _STRESS_SELECTED =",
              "    SELECTEDVALUE ( 'Stress Simulation PBI Report'[Simulation Name Simple] )",
              "VAR _VAR_SELECTED =",
              "    SELECTEDVALUE ( 'VaR Window Historic'[VAR_WINDOW_NAME] )",
              "VAR _COMPARATIVE =",
              "    SELECTEDVALUE ( 'Limit Department'[Comparative] )",
              "VAR _USAGE =",
              "    SWITCH (",
              "        _COMPARATIVE,",
              "        \"Sensitivity\", _SENSI_SELECTED,",
              "        \"Stress\", _STRESS_SELECTED,",
              "        _VAR_SELECTED",
              "    )",
              "VAR _DETAIL =",
              "    SWITCH(",
              "        _COMPARATIVE,",
              "        \"VaR\", LEFT ( SELECTEDVALUE ( 'VaR Percentile'[VaR Percentile Value], BLANK () ), 4 ),",
              "        \"Stress\",SELECTEDVALUE ( 'Stress Simulation PBI Report'[Stress Simulation Name] ),",
              "        BLANK ()",
              "    )",
              "VAR _LIMIT_CCY_CODE =",
              "    BLANK ()",
              "RETURN",
              "    CALCULATE (",
              "        MIN ( 'Limit Department'[AMOUNT] ),",
              "        _COBS,",
              "        'Limit Department'[Usage] = _USAGE,",
              "        'Limit Department'[Entity] = _ENTITY,",
              "        'Limit Department'[Organisation] = _ORGANISATION,",
              "        'Limit Department'[Detail] = _DETAIL,",
              "        'Limit Department'[Limit Currency Code] = _LIMIT_CCY_CODE",
              "    )"
            ],
            "isHidden": true,
            "lineageTag": "6aba5785-3c0a-4d60-8264-4d8035f751b7",
            "formatStringDefinition": {
              "expression": "IF( SELECTEDVALUE('Limit Department'[Comparative]) = \"VaR\", \"#,0.##\", \"$#,0.##\")"
            }
          },
