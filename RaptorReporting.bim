          {
            "name": "PUBLISHVAR_COMPLETED",
            "mode": "directQuery",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Snowflake.Databases(\"tj90313.west-europe.azure.snowflakecomputing.com\", WarehouseName, null),",
                "    RAPTOR_Database = Source{[Name=DBName,Kind=\"Database\"]}[Data],",
                "    BATCH_Schema = RAPTOR_Database{[Name=\"BATCH\",Kind=\"Schema\"]}[Data],",
                "    PUBLISHVAR_COMPLETED_View = BATCH_Schema{[Name=\"PUBLISHVAR_COMPLETED\",Kind=\"View\"]}[Data],",
                "    #\"Renamed Columns\" = Table.RenameColumns(PUBLISHVAR_COMPLETED_View,{{\"ENTITY\", \"Entity\"}, {\"SOURCESYSTEM\", \"Source System\"}, {\"REGIONAREA\", \"Region Area\"}, {\"SUBCOMPONENT\", \"Sub Component\"}, {\"BATCHACTION\", \"Batch Action\"}, {\"COMPLETED\", \"Completed\"}})",
                "in",
                "    #\"Renamed Columns\""
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "DB Load Time",
            "expression": "MAX(PUBLISHVAR_COMPLETED[END_TIME])",
            "formatString": "dd-mmm-yyyy hh:nn",
            "isHidden": true
          },
          {
            "name": "PublishVaR Complete%",
            "expression": "DIVIDE(COUNTA(PUBLISHVAR_COMPLETED[END_TIME]),[PublishVaR Count])",
            "formatString": "0 %;-0 %;0 %",
            "isHidden": true,
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"Percentage\" Accuracy=\"0\" />"
              }
            ]
          },
          {
            "name": "PublishVaR Count",
            "expression": "COUNTROWS(PUBLISHVAR_COMPLETED)",
            "formatString": "0",
            "isHidden": true,
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"NumberWhole\" Accuracy=\"0\" />"
              }
            ]
          },
          {
            "name": "Staging Files%",
            "expression": "DIVIDE(SUM(PUBLISHVAR_COMPLETED[Completed]), [PublishVaR Count],0)",
            "formatString": "0 %;-0 %;0 %",
            "isHidden": true,
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"Percentage\" Accuracy=\"0\" />"
              }
            ]
          }
        ],
