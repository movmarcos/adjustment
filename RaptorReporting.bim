        "measures": [
          {
            "name": "Sensi Change Detail ST1",
            "expression": [
              "VAR _SENSI =",
              "    CALCULATE ( SUM ( 'Sensitivity Detail Fields'[ST1 Value in USD] ),'Historic COB List'[COBID] = SELECTEDVALUE ( 'Reporting Date'[COBID] ) )",
              "VAR _DIFF =     ",
              "    _SENSI - CALCULATE (SUM ( 'Sensitivity Detail Fields'[ST1 Value in USD] ),'Historic COB List'[COBID]= SELECTEDVALUE ( 'Previous Reporting Date'[Previous COBID] ))",
              "    ",
              "VAR _DIVISOR = SELECTEDVALUE('Reporting Measure Type'[PBI Format Divisor],1)",
              "RETURN",
              "    DIVIDE ( _DIFF, _DIVISOR )",
              ""
            ],
            "formatString": "#,0.0",
            "isHidden": true,
            "lineageTag": "8cd43aa5-581b-49e2-a05c-b68661c87ff9"
          },
          {
            "name": "Sensi Change Detail ST3",
            "expression": [
              "VAR _SENSI =",
              "    CALCULATE ( SUM ( 'Sensitivity Detail Fields'[ST3 Value in USD] ),'Historic COB List'[COBID] = SELECTEDVALUE ( 'Reporting Date'[COBID] ) )",
              "VAR _DIFF =     ",
              "    _SENSI - CALCULATE (SUM ( 'Sensitivity Detail Fields'[ST3 Value in USD] ),'Historic COB List'[COBID]= SELECTEDVALUE ( 'Previous Reporting Date'[Previous COBID] ))",
              "    ",
              "VAR _DIVISOR = SELECTEDVALUE('Reporting Measure Type'[PBI Format Divisor],1)",
              "RETURN",
              "    DIVIDE ( _DIFF, _DIVISOR )",
              ""
            ],
            "formatString": "#,0.0",
            "isHidden": true,
            "lineageTag": "2d74038b-f810-4a7c-9fcf-e7b76ace1841"
          },
          {
            "name": "Sensi Current Detail ST1",
            "expression": [
              "VAR _SENSI =",
              "    CALCULATE ( SUM ( 'Sensitivity Detail Fields'[ST1 Value in USD] ), 'Historic COB List'[COBID] = SELECTEDVALUE ( 'Reporting Date'[COBID] ) )",
              "VAR _DIVISOR = SELECTEDVALUE('Reporting Measure Type'[PBI Format Divisor],1)",
              "RETURN",
              "    DIVIDE ( _SENSI, _DIVISOR )"
            ],
            "formatString": "#,0.0",
            "isHidden": true,
            "lineageTag": "6b4c681f-2308-4ab4-a527-969886d3af12"
          },
          {
            "name": "Sensi Current Detail ST3",
            "expression": [
              "VAR _SENSI =",
              "    CALCULATE ( SUM ( 'Sensitivity Detail Fields'[ST3 Value in USD] ), 'Historic COB List'[COBID] = SELECTEDVALUE ( 'Reporting Date'[COBID] ) )",
              "VAR _DIVISOR = SELECTEDVALUE('Reporting Measure Type'[PBI Format Divisor],1)",
              "RETURN",
              "    DIVIDE ( _SENSI, _DIVISOR )"
            ],
            "formatString": "#,0.0",
            "isHidden": true,
            "lineageTag": "71647bc4-bc87-4b32-a161-9ff83942453e"
          },
          {
            "name": "Candlesticks Detail",
            "expression": [
              "VAR _HEIGHT = 25",
              "VAR _WIDTH = 80",
              "VAR _MARGIN_X = 2",
              "VAR _MARGIN_Y = 0",
              "VAR _VIEWBOX = \"'\"&-_MARGIN_X&\" \"&-_MARGIN_Y&\" \"&_WIDTH+_MARGIN_X&\" \"& _HEIGHT+_MARGIN_Y&\"'\"",
              "//Setting measures and positions for graphs (relative to dimensions)",
              "VAR _TOTAL_ROW = IF(ISINSCOPE('Spread Band'[Spread Band] ) ||",
              "ISINSCOPE( 'Rating Band'[Rating]) ||",
              "ISINSCOPE( 'Sensitivity Detail Fields'[Product Category Name]) ||",
              "ISINSCOPE('Sensitivity Detail Fields'[Entity Department Display]),",
              "0,1)",
              "VAR _DIVISOR = SELECTEDVALUE('Reporting Measure Type'[PBI Format Divisor],1)",
              "VAR _EOD_Value =  IF( SELECTEDVALUE ( 'Tenor Group'[Tenor Group Type Code] ) = \"STANDARD3\", CALCULATE ( SUM ( 'Sensitivity Detail Fields'[ST3 Value in USD] ),'Historic COB List'[COBID] = SELECTEDVALUE ( 'Reporting Date'[COBID] ) ),CALCULATE ( SUM ( 'Sensitivity Detail Fields'[ST1 Value in USD] ),'Historic COB List'[COBID] = SELECTEDVALUE ( 'Reporting Date'[COBID] ) ))",
              "VAR _Row_Values = CALCULATE([Candlesticks_6M_Min_Detail],REMOVEFILTERS('Department 2'[Entity Department]), REMOVEFILTERS('Entity 2'[Entity Code]), REMOVEFILTERS('Department 2'[Volcker Desk]))",
              "VAR _DIFF = _EOD_Value - IF( SELECTEDVALUE ( 'Tenor Group'[Tenor Group Type Code] ) = \"STANDARD3\", CALCULATE (SUM ( 'Sensitivity Detail Fields'[ST3 Value in USD] ),'Historic COB List'[COBID]= SELECTEDVALUE ( 'Previous Reporting Date'[Previous COBID] )),CALCULATE (SUM ( 'Sensitivity Detail Fields'[ST1 Value in USD] ),'Historic COB List'[COBID]= SELECTEDVALUE ( 'Previous Reporting Date'[Previous COBID] )))",
              "VAR _OPEN_VALUE = IF(_DIFF<0, _EOD_Value, _EOD_Value-_DIFF)",
              "VAR _CLOSE_VALUE = IF(_DIFF>0,_EOD_Value, _EOD_Value-_DIFF)",
              "VAR _MIN_VALUE= IF(_TOTAL_ROW = 0, [Candlesticks_6M_Min_Detail], [Candlesticks_6M_Min])",
              "VAR _MAX_VALUE= IF(_TOTAL_ROW = 0, [Candlesticks_6M_Max_Detail], [Candlesticks_6M_Max])",
              "VAR _ALL_MIN_VALUE_ROWS  = SWITCH(TRUE(),",
              "ISINSCOPE('Spread Band'[Spread Band] ), MINX(ADDCOLUMNS(ALLSELECTED('Spread Band'),\"MIN\",[Candlesticks_6M_Min_Detail]),[MIN]), ",
              "ISINSCOPE( 'Rating Band'[Rating]), MINX(ADDCOLUMNS(ALLSELECTED('Rating Band'),\"MIN\",[Candlesticks_6M_Min_Detail]),[MIN]),",
              "ISINSCOPE( 'Sensitivity Detail Fields'[Product Category Name]), MINX(SUMMARIZE(ALLSELECTED('Sensitivity Detail Fields'),'Sensitivity Detail Fields'[Product Category Name],\"MIN\",[Candlesticks_6M_Min_Detail]),[MIN]),",
              "ISINSCOPE('Sensitivity Detail Fields'[Entity Department Display]), MINX(SUMMARIZE(ALLSELECTED('Sensitivity Detail Fields'),'Sensitivity Detail Fields'[Entity Department Display],\"MIN\",[Candlesticks_6M_Min_Detail]),[MIN]),",
              "BLANK())",
              "VAR _ALL_MAX_VALUE_ROWS  = SWITCH(TRUE(),",
              "ISINSCOPE('Spread Band'[Spread Band] ), MAXX(ADDCOLUMNS(ALLSELECTED('Spread Band'),\"MAX\",[Candlesticks_6M_Max_Detail]),[MAX]), ",
              "ISINSCOPE( 'Rating Band'[Rating]), MAXX(ADDCOLUMNS(ALLSELECTED('Rating Band'),\"MAX\",[Candlesticks_6M_Max_Detail]),[MAX]),",
              "ISINSCOPE( 'Sensitivity Detail Fields'[Product Category Name]), MAXX(SUMMARIZE(ALLSELECTED('Sensitivity Detail Fields'),'Sensitivity Detail Fields'[Product Category Name],\"MAX\",[Candlesticks_6M_Max_Detail]),[MAX]),",
              "ISINSCOPE('Sensitivity Detail Fields'[Entity Department Display]), MAXX(SUMMARIZE(ALLSELECTED('Sensitivity Detail Fields'),'Sensitivity Detail Fields'[Entity Department Display],\"MAX\",[Candlesticks_6M_Max_Detail]),[MAX]),",
              "BLANK())",
              "VAR _ALL_MIN_VALUE  = IF(_TOTAL_ROW = 0,MIN(_ALL_MIN_VALUE_ROWS,0) , MIN(_MIN_VALUE,0))",
              "VAR _ALL_MAX_VALUE  = IF(_TOTAL_ROW = 0,MAX(_ALL_MAX_VALUE_ROWS,0) , MAX(_MAX_VALUE,0))",
              "VAR _RATIO = DIVIDE(_WIDTH, (_ALL_MAX_VALUE - _ALL_MIN_VALUE))",
              "VAR _AXIS_RANGE = (_MAX_VALUE - _MIN_VALUE) * _RATIO",
              "VAR _AXIS_START = (_MIN_VALUE - _ALL_MIN_VALUE) * _RATIO",
              "VAR _BOX_END = (_CLOSE_VALUE - _ALL_MIN_VALUE) * _RATIO",
              "VAR _BOX_START = (_OPEN_VALUE - _ALL_MIN_VALUE) * _RATIO",
              "VAR _BOX_WIDTH = _BOX_END - _BOX_START",
              "VAR _ZERO_SPOT = (0  - _ALL_MIN_VALUE)*_RATIO",
              "VAR _BAR_COLOUR = IF(_DIFF<0,\"#E60000\",\"#2AABA0\")",
              "VAR _TEXT_COLOUR = IF(_DIFF<0,\"#E60000\",\"#000000\")",
              "RETURN",
              "SWITCH(TRUE(),",
              "ISBLANK(_Row_Values), BLANK(), ",
              "SELECTEDVALUE('View Type'[Change column display])=\"Numbers\",",
              "\"data:image/svg+xml;utf8,\" & ",
              "\"<svg width='\"&_WIDTH&\"' height='\"&_HEIGHT&\"' viewBox=\"&_viewbox&\" xmlns='http://www.w3.org/2000/svg' xmlns:xlink='http://www.w3.org/1999/xlink' overflow='visible'>",
              "<text alignment-baseline='hanging' text-anchor='middle' y='\"&_MARGIN_Y+3&\"' x='\"&_WIDTH/2&\"' font-size='14PX' font-style='italic' font-family='Calibri' fill='\"&_TEXT_COLOUR&\"'>\"&round(DIVIDE(_DIFF,_DIVISOR),1)&\"</text> </svg>\",",
              "\"data:image/svg+xml;utf8,\" & ",
              "\"<svg width='\"&_WIDTH&\"' height='\"&_height&\"' viewBox=\"&_viewbox&\" xmlns='http://www.w3.org/2000/svg' xmlns:xlink='http://www.w3.org/1999/xlink' overflow='visible'>",
              "<rect id='range' x='\"& _axis_start&\"' y='\"&_height*7.5/16&\"' width='\"&_axis_range&\"' height='\"&_height/16&\"' fill='black'/>",
              "<rect id='box' x='\"& _box_start &\"' y='\"&_height/3&\"' width='\"& _box_width &\"' height='\"&_height/3&\"' fill='\"& _bar_colour &\"'></rect> ",
              "<line stroke-dasharray='10, 5' x1='\"& _zero_spot&\"' y1='0' x2='\"& _zero_spot&\"' y2='\"&_height&\"' style='stroke-width: 2px; stroke: rgb(90, 90, 90)'></line>",
              "</svg>\")"
            ],
            "isHidden": true,
            "lineageTag": "64939b74-ffb9-4340-b345-6de7564b095b",
            "dataCategory": "ImageUrl"
          },
          {
            "name": "Candlesticks_6M_Max_Detail",
            "expression": [
              "VAR _COBS =",
              "    FILTER ( 'Historic COB List', [6M_window_flag] = 1 )",
              "RETURN",
              "    SWITCH (",
              "        TRUE (),",
              "        ISINSCOPE ( 'Spread Band'[Spread Band] ),",
              "            MAXX (",
              "                SUMMARIZECOLUMNS (",
              "                    'Sensitivity Detail Fields'[COBID],",
              "                    'Spread Band'[Spread Band],",
              "                    \"SUM\",",
              "                        IF (",
              "                            SELECTEDVALUE ( 'Tenor Group'[Tenor Group Type Code] ) = \"STANDARD3\",",
              "                            CALCULATE ( SUM ( 'Sensitivity Detail Fields'[ST3 Value in USD] ), _COBS ),",
              "                            CALCULATE ( SUM ( 'Sensitivity Detail Fields'[ST1 Value in USD] ), _COBS )",
              "                        )",
              "                ),",
              "                [SUM]",
              "            ),",
              "        ISINSCOPE ( 'Rating Band'[Rating] ),",
              "            MAXX (",
              "                SUMMARIZECOLUMNS (",
              "                    'Sensitivity Detail Fields'[COBID],",
              "                    'Rating Band'[Rating],",
              "                    \"SUM\",",
              "                        IF (",
              "                            SELECTEDVALUE ( 'Tenor Group'[Tenor Group Type Code] ) = \"STANDARD3\",",
              "                            CALCULATE ( SUM ( 'Sensitivity Detail Fields'[ST3 Value in USD] ), _COBS ),",
              "                            CALCULATE ( SUM ( 'Sensitivity Detail Fields'[ST1 Value in USD] ), _COBS )",
              "                        )",
              "                ),",
              "                [SUM]",
              "            ),",
              "        ISINSCOPE ( 'Sensitivity Detail Fields'[Product Category Name] ),",
              "            MAXX (",
              "                SUMMARIZECOLUMNS (",
              "                    'Sensitivity Detail Fields'[COBID],",
              "                    'Sensitivity Detail Fields'[Product Category Name],",
              "                    \"SUM\",",
              "                        IF (",
              "                            SELECTEDVALUE ( 'Tenor Group'[Tenor Group Type Code] ) = \"STANDARD3\",",
              "                            CALCULATE ( SUM ( 'Sensitivity Detail Fields'[ST3 Value in USD] ), _COBS ),",
              "                            CALCULATE ( SUM ( 'Sensitivity Detail Fields'[ST1 Value in USD] ), _COBS )",
              "                        )",
              "                ),",
              "                [SUM]",
              "            ),",
              "        ISINSCOPE ( 'Sensitivity Detail Fields'[Entity Department Display] ),",
              "            MAXX (",
              "                SUMMARIZECOLUMNS (",
              "                    'Sensitivity Detail Fields'[COBID],",
              "                    'Sensitivity Detail Fields'[Entity Department Display],",
              "                    \"SUM\",",
              "                        IF (",
              "                            SELECTEDVALUE ( 'Tenor Group'[Tenor Group Type Code] ) = \"STANDARD3\",",
              "                            CALCULATE ( SUM ( 'Sensitivity Detail Fields'[ST3 Value in USD] ), _COBS ),",
              "                            CALCULATE ( SUM ( 'Sensitivity Detail Fields'[ST1 Value in USD] ), _COBS )",
              "                        )",
              "                ),",
              "                [SUM]",
              "            ),",
              "        MAXX (",
              "            SUMMARIZECOLUMNS (",
              "                'Sensitivity Detail Fields'[COBID],",
              "                \"SUM\",",
              "                    IF (",
              "                        SELECTEDVALUE ( 'Tenor Group'[Tenor Group Type Code] ) = \"STANDARD3\",",
              "                        CALCULATE ( SUM ( 'Sensitivity Detail Fields'[ST3 Value in USD] ), _COBS ),",
              "                        CALCULATE ( SUM ( 'Sensitivity Detail Fields'[ST1 Value in USD] ), _COBS )",
              "                    )",
              "            ),",
              "            [SUM]",
              "        )",
              "    )"
            ],
            "isHidden": true,
            "lineageTag": "f8d18fa1-658b-45f5-a0a3-621ea27d9243"
