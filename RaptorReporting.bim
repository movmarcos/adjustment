          },
          {
            "type": "calculatedTableColumn",
            "name": "Ent_Priority",
            "dataType": "int64",
            "isNameInferred": true,
            "isDataTypeInferred": true,
            "sourceColumn": "[Ent_Priority]",
            "lineageTag": "9c574c41-60a9-417e-a45c-faa126c4c353",
            "isAvailableInMdx": false
          },
          {
            "type": "calculatedTableColumn",
            "name": "Entity Code",
            "dataType": "string",
            "isNameInferred": true,
            "isDataTypeInferred": true,
            "sourceColumn": "[Entity Code]",
            "lineageTag": "af028da9-336f-42b2-b976-eb32f063fc4b",
            "isAvailableInMdx": false
          }
        ],
        "partitions": [
          {
            "name": "Dep_count_table",
            "mode": "import",
            "source": {
              "type": "calculated",
              "expression": [
                "VAR COUNT_DEP = ",
                "    FILTER(",
                "        SELECTCOLUMNS(",
                "            SUMMARIZECOLUMNS(",
                "                'Department 2'[Business Unit Code],",
                "                'Department 2'[Entity Code Original],",
                "                \"Count_Orig_Dep\",COUNT('Department 2'[Entity Department Original])",
                "            ),",
                "            \"Entity Code\", 'Department 2'[Entity Code Original],",
                "            \"Business Unit Code\", 'Department 2'[Business Unit Code],",
                "            \"Count_Orig_Dep\",[Count_Orig_Dep]",
                "            ),",
                "        LEFT([Entity Code],3)=\"MUS\"",
                "        )",
                "RETURN",
                "ADDCOLUMNS(",
                "    COUNT_DEP,",
                "    \"Ent_Priority\",SWITCH([Entity Code],\"MUSI\",1,\"MUSUSA\",2,\"MUSEU\",3,\"MUSCAN\",4,5),",
                "    \"Count_Orig_Ent\",SUMX(FILTER(COUNT_DEP,EARLIER([Entity Code]) = [Entity Code]),[Count_Orig_Dep]),",
                "    \"Count_Orig_BU\", SUMX(FILTER(COUNT_DEP,EARLIER([Business Unit Code]) = [Business Unit Code]),[Count_Orig_Dep])",
                "    )"
              ]
            }
          }
        ]
      },
