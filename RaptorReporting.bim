            "expression": [
              "",
              "IF([Display PNL],",
              "    IF([Use Stress Trade Level DQ], [Simulation Pl DQ Unadjusted],",
              "        IF([Use Stress Summary Level DQ], [Simulation Pl Summary DQ Unadjusted] , [Simulation Pl Import Unadjusted] + [Sim Pl cyclic SUM])",
