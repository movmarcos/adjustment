        "measures": [
          {
            "name": "ASPD",
            "expression": "MAX('Instrument Measure'[_ASPD])",
            "lineageTag": "53417522-8bfe-43dd-b766-552b65918466"
          },
          {
            "name": "CSPD CAPPED",
            "expression": "MAX('Instrument Measure'[_CSPD_CAPPED])",
            "lineageTag": "84e2c229-13cf-4249-a09b-ad656d00cc77"
          },
          {
            "name": "CSPD QS",
            "expression": "MAX('Instrument Measure'[_CSPD_QS])",
            "lineageTag": "168bf54c-45d3-4fdb-98a7-2ebab19c824e"
          },
          {
            "name": "CSPD",
            "expression": "MAX('Instrument Measure'[_CSPD])",
            "lineageTag": "b8f2231a-b95e-4a37-ac3a-9f42af0936c7"
          },
          {
            "name": "Discount Margin",
            "expression": "MAX('Instrument Measure'[_DISCOUNT_MARGIN])",
            "lineageTag": "52d909fc-61d7-4aae-b747-421aa9ed8c13"
          },
          {
            "name": "Equity Raw Beta With Default",
            "expression": [
              "IF(",
              "    ISBLANK([Equity Raw Beta]) || [Equity Raw Beta] = 0,",
              "    1,",
              "    [Equity Raw Beta]",
              ")"
            ],
            "lineageTag": "9e6f9500-f014-4c87-bc50-fb62a732d736"
          },
          {
            "name": "Equity Raw Beta",
            "expression": "MAX('Instrument Measure'[_EQUITY_RAW_BETA])",
            "lineageTag": "16a6b5e1-e204-4d5e-beed-4aaa001f5e54"
          },
          {
            "name": "Max CSPD",
            "expression": " ABS(MAX('Instrument Measure'[_CSPD]))",
            "isHidden": true,
            "lineageTag": "d907eb0a-0558-4c11-9026-d9e4d9e8bc77"
          },
          {
            "name": "OAS Capped",
            "expression": [
              " IF(",
              "     ABS([OAS]) > 500, ",
              "     500 * SIGN([OAS]), ",
              "     [OAS]",
              " )"
            ],
            "lineageTag": "258b9ab6-9d48-46db-ad9e-84a606e691c2"
          },
          {
            "name": "OAS",
            "expression": "MAX('Instrument Measure'[_OAS])",
            "lineageTag": "8a4206ee-c2f3-4a04-81ce-28d9ddca126a"
          },
          {
            "name": "ZSPD",
            "expression": "MAX('Instrument Measure'[_ZSPD])",
            "lineageTag": "b9b72fb3-b5e8-4625-ab5f-a12cb85503f0"
          },
          {
            "name": "Average Volume 30Day",
            "expression": "MAX('Instrument Measure'[_AVERAGE_VOLUME_30DAY])",
            "lineageTag": "c27ad5a0-bc59-4c66-829d-06ccdc0ad1fa"
          },
          {
            "name": "Current Market Cap USD",
            "expression": "MAX('Instrument Measure'[_CURRENT_MARKET_CAP])",
            "lineageTag": "2d55bb3c-ecf0-4ee7-9d01-de52c3f02795"
          },
          {
            "name": "PX Last",
            "expression": "MAX('Instrument Measure'[_PX_LAST])",
            "lineageTag": "5f13b66b-2a3b-46e3-a4f2-49d344a714a6"
          },
          {
            "name": "Market Cap Categories",
            "expression": [
              "SWITCH (",
              "    TRUE (),",
              "    ISBLANK ( [Current Market Cap USD] ), \"Unclassified Cap\",",
              "    [Current Market Cap USD] < 5000, \"Small Cap\",",
              "    [Current Market Cap USD] < 10000, \"Mid Cap\",",
              "    [Current Market Cap USD] < 200000, \"Large Cap\",",
              "    \"Mega Cap\"",
              ")"
            ],
            "lineageTag": "ef413de1-fd63-4598-ac98-1a683b027c72"
          }
        ],
