            "mode": "directQuery",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Snowflake.Databases(\"tj90313.west-europe.azure.snowflakecomputing.com\",SF_Warehouse),",
                "    MUSBI_Database = Source{[Name=SF_DBName,Kind=\"Database\"]}[Data],",
                "    GLOBAL_Schema = MUSBI_Database{[Name=\"GLOBAL\",Kind=\"Schema\"]}[Data],",
                "    BAMWORKFLOW_Table = GLOBAL_Schema{[Name=\"BAMWORKFLOW\",Kind=\"Table\"]}[Data],",
                "    #\"Filtered Rows\" = Table.SelectRows(BAMWORKFLOW_Table, each ([NAMEDESC] = \"Daily MRM Comment\") and ([ISCURRENTROW] = 1)),",
                "    #\"Removed Columns\" = Table.RemoveColumns(#\"Filtered Rows\",{\"VERSION\", \"REGIONCODE\", \"ORGANISATIONLEVEL\", \"NAMEID\", \"TRIGGERMETHOD\", \"AUDIT\", \"OWNER\", \"STATUSCODE\", \"ENTRYTIME\", \"ENTRYDATE\", \"EFFECTIVESTARTDATE\", \"EFFECTIVEENDDATE\", \"ENTRYCOBID\"}),",
                "    #\"Renamed Columns\" = Table.RenameColumns(#\"Removed Columns\",{{\"ENTITYCODE\", \"EntityCode\"}, {\"ORGANISATIONVALUE\", \"OrganisationValue\"}, {\"NAMEDESC\", \"NameDesc\"}, {\"COMMENT\", \"Comment\"}, {\"ISCURRENTROW\", \"IsCurrentRow\"}})",
                "in",
                "    #\"Renamed Columns\""
              ]
            }
          }
        ],
