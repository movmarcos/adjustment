      {
        "name": "VaR Window Historic",
        "isHidden": true,
        "lineageTag": "543c2e5c-e285-4452-bb9d-f9af56d43eb8",
        "columns": [
          {
            "type": "calculatedTableColumn",
            "name": "CCY",
