    "expressions": [
      {
        "name": "DBName",
        "kind": "m",
        "expression": "\"DVLP_RAPTOR_RAPTOR_3106_EQDELTADECOM_2\" meta [IsParameterQuery = true, IsParameterQueryRequired = true, Type = \"Text\"]",
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Text"
          },
          {
            "name": "PBI_DescriptionAtRefresh"
          },
          {
            "name": "PBI_NavigationStepName",
            "value": "Navigation"
          }
        ]
      },
      {
        "name": "WarehouseName",
        "kind": "m",
        "expression": "\"DVLP_RAPTOR_WH_M\" meta [IsParameterQuery = true, IsParameterQueryRequired = true, Type = \"Text\"]",
        "annotations": [
          {
            "name": "PBI_NavigationStepName",
            "value": "Navigation"
          },
          {
            "name": "PBI_ResultType",
            "value": "Text"
          },
          {
            "name": "PBI_DescriptionAtRefresh"
          }
        ]
      },
      {
        "name": "DateKey",
        "kind": "m",
        "expression": [
          "let",
          "    Source = (x as datetime) => Date.Year(x)*10000 + Date.Month(x)*100 + Date.Day(x)",
          "in",
          "    Source"
        ],
        "queryGroup": "DateKey",
        "annotations": [
          {
            "name": "PBI_DescriptionAtRefresh"
          },
          {
            "name": "PBI_NavigationStepName",
            "value": "Navigation"
          },
          {
            "name": "PBI_ResultType",
            "value": "Function"
          }
        ]
      },
      {
        "name": "LastUpdated",
        "kind": "m",
        "expression": [
          "let",
          "    Source = Snowflake.Databases(\"tj90313.west-europe.azure.snowflakecomputing.com\", WarehouseName, null),",
          "    RAPTOR_Database = Source{[Name=DBName,Kind=\"Database\"]}[Data],",
          "    METADATA_Schema = RAPTOR_Database{[Name=\"METADATA\",Kind=\"Schema\"]}[Data],",
          "    PUBLISHINFO_Table = METADATA_Schema{[Name=\"POWERBI_PUBLISH_INFO\",Kind=\"Table\"]}[Data],",
          "    #\"Filtered Rows\" = Table.SelectRows(PUBLISHINFO_Table, each ([DATASET_NAME] = \"RaptorReporting\" and [DATA_GROUP_NAME]=\"var\")),",
          "    FilteredData = Table.SelectRows(#\"Filtered Rows\", each [COBID] >= DateKey(RangeStart) and [COBID] < DateKey(RangeEnd)),",
          "    MaxlastUpdateTime = List.Max(#\"FilteredData\"[LAST_UPDATED]),",
          "    accountForNull = if MaxlastUpdateTime = null then #datetime(1901,1,01,00,00,00) else MaxlastUpdateTime",
          "in",
          "   accountForNull"
        ],
        "queryGroup": "DateKey",
        "annotations": [
          {
            "name": "PBI_DescriptionAtRefresh"
          },
          {
            "name": "PBI_NavigationStepName",
            "value": "Navigation"
          },
          {
            "name": "PBI_ResultType",
            "value": "Exception"
          }
        ]
      },
      {
        "name": "LastUpdatedAdjust",
        "kind": "m",
        "expression": [
