        "partitions": [
          {
            "name": "VaR Trade Direct Query",
            "mode": "directQuery",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Snowflake.Databases(\"tj90313.west-europe.azure.snowflakecomputing.com\", WarehouseName, null),",
                "    RAPTOR_Database = Source{[Name=DBName,Kind=\"Database\"]}[Data],",
                "    FACT_Schema = RAPTOR_Database{[Name=\"FACT\",Kind=\"Schema\"]}[Data],",
                "    VAR_MEASURES_COMBINED_View = FACT_Schema{[Name=\"VAR_MEASURES_COMBINED\",Kind=\"View\"]}[Data],",
                "    #\"Renamed Columns\" = Table.RenameColumns(VAR_MEASURES_COMBINED_View,{{\"COMMON_INSTRUMENT_FCD_KEY\", \"COMMON_INSTRUMENT_FCD_KEY\"}})",
                "in",
                "    #\"Renamed Columns\""
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "PnL Vector Value Adjusted",
            "expression": "SUM('VaR Trade Direct Query'[PNL_VECTOR_VALUE_IN_USD])",
            "isHidden": true,
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"General\" />"
              }
            ]
          },
          {
            "name": "PnL Vector Value Unadjusted",
            "expression": [
              "",
              "CALCULATE(",
              "    SUM('VaR Trade Direct Query'[PNL_VECTOR_VALUE_IN_USD]), ",
              "    FILTER(ALL('IsAdjustment'), IsAdjustment[Is Adjustment] = 0)",
              "    )"
            ],
            "isHidden": true,
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"General\" />"
              }
            ]
          },
          {
            "name": "VaR Trade Adjusted",
            "expression": [
              "VAR SecondElementFraction = 1-[First Element Fraction]",
              "VAR ScenarioTable =  SUMMARIZE('VaR Trade Direct Query','VaR Trade Direct Query'[SCENARIO_DATE_ID] ,\"PnlVector\", [PnL Vector Value Adjusted])",
              "VAR VaRVectors = TOPN(2,TOPN([Second Element Sl No Summary],ScenarioTable,[PnlVector],ASC),[PnlVector],DESC)",
              "RETURN  (((CALCULATE(MINX(VaRVectors,[PnlVector])) * [First Element Fraction]) +  (CALCULATE(MAXX(VaRVectors,[PnlVector])) * SecondElementFraction)) * [VaR Scaling Value] *-1)"
            ],
            "formatString": "#,0.00",
            "isHidden": true,
            "lineageTag": "b27294f1-d47b-471d-802f-051fae412033",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"NumberDecimal\" Accuracy=\"2\" ThousandSeparator=\"True\" />"
              }
            ]
          },
          {
            "name": "VaR Trade UnAdjusted",
            "expression": [
              "VAR SecondElementFraction = 1-[First Element Fraction]",
              "VAR ScenarioTable =  SUMMARIZE('VaR Trade Direct Query','VaR Trade Direct Query'[SCENARIO_DATE_ID] ,\"PnlVector\", [PnL Vector Value Unadjusted])",
              "VAR VaRVectors = TOPN(2,TOPN([Second Element Sl No Summary],ScenarioTable,[PnlVector],ASC),[PnlVector],DESC)",
              "RETURN  (((CALCULATE(MINX(VaRVectors,[PnlVector])) * [First Element Fraction]) +  (CALCULATE(MAXX(VaRVectors,[PnlVector])) * SecondElementFraction)) * [VaR Scaling Value] *-1)"
            ],
            "isHidden": true,
            "lineageTag": "15ddce1e-c2ec-4fbe-ab20-1cf1173ee6e6",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"General\" />"
              }
            ]
          },
          {
            "name": "PnL Adjustment DQ",
            "expression": [
              "",
              "CALCULATE(",
              "    SUM('VaR Trade Direct Query'[PNL_VECTOR_VALUE_IN_USD]), ",
              "    FILTER(ALL('IsAdjustment'), IsAdjustment[Is Adjustment] = 1)",
              "    )"
            ],
            "isHidden": true,
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"General\" />"
              }
            ]
          },
          {
            "name": "OneTrade",
            "expression": "HASONEVALUE(Trade[Trade Code])",
            "formatString": "\"TRUE\";\"TRUE\";\"FALSE\"",
            "isHidden": true,
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"Boolean\" />"
              }
            ]
          },
          {
            "name": "Pnl Row DQ Count",
            "expression": "COUNTROWS('VaR Trade Direct Query')",
            "formatString": "0",
            "isHidden": true,
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"NumberWhole\" Accuracy=\"0\" />"
              }
            ]
          },
          {
            "name": "PnL Trade VaR Senario",
            "expression": [
              "",
              "CALCULATE(",
              "    SUM('VaR Trade Direct Query'[PNL_VECTOR_VALUE_IN_USD]), ",
              "    FILTER(ALL('VaR Trade Direct Query'[SCENARIO_DATE_ID]), 'VaR Trade Direct Query'[SCENARIO_DATE_ID] = [VaR Scenario Date])",
              "    )"
            ],
            "isHidden": true,
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"General\" />"
              }
            ]
          },
          {
            "name": "Previous PnL Trade Scenario",
            "expression": [
              "",
              "CALCULATE(",
              "    [Previous PnL DQ],",
              "    FILTER(ALL('Reporting Date'), 'Reporting Date'[COBId] = MIN('Previous Reporting Date'[Previous COBId]))",
              "    )"
            ],
            "isHidden": true,
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"General\" />"
              }
            ]
          },
          {
            "name": "Diff PnL Trade Scenario",
            "expression": "[PnL Trade VaR Senario]-[Previous PnL Trade Scenario]",
            "isHidden": true,
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"General\" />"
              }
            ]
          },
          {
            "name": "Previous PnL DQ",
            "expression": [
              "",
              "CALCULATE(",
              "    [PnL Vector Value Adjusted],",
              "    FILTER(ALL('Reporting Date'), 'Reporting Date'[COBId] = MIN('Previous Reporting Date'[Previous COBId]))",
              "    )"
            ],
            "isHidden": true,
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"General\" />"
              }
            ]
          },
          {
            "name": "Adjustment PnL Row DQ Count",
            "expression": [
              "",
              "CALCULATE(",
              "    COUNTROWS('VaR Trade Direct Query'), ",
              "    FILTER(ALL('IsAdjustment'), IsAdjustment[Is Adjustment] = 1)",
              "    )"
            ],
            "formatString": "0",
            "isHidden": true,
            "lineageTag": "6088f738-77be-4c64-856f-75719ea19eda",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"NumberWhole\" Accuracy=\"0\" />"
              }
            ]
          },
          {
            "name": "VaR Trade Adjusted MUSECon",
            "expression": [
              "VAR SecondElementFraction = 1 - [First Element Fraction]",
              "VAR ScenarioTable =",
              "    SUMMARIZE(",
              "        FILTER(",
              "            'VaR Trade Direct Query',",
              "            'VaR Trade Direct Query'[ENTITY_CODE] = \"MUSI\" || 'VaR Trade Direct Query'[ENTITY_CODE] = \"MUSEU\"",
              "        ),",
              "        'VaR Trade Direct Query'[SCENARIO_DATE_ID],",
              "        \"PnlVector\", [PnL Vector Value Adjusted]",
              "    )",
              "VAR VaRVectors = TOPN( 2, TOPN( [Second Element Sl No Summary], ScenarioTable, [PnlVector], ASC ), [PnlVector], DESC )",
              "RETURN",
              "    ( ( ( CALCULATE( MINX( VaRVectors, [PnlVector] ) ) * [First Element Fraction] )",
              "        + ( CALCULATE( MAXX( VaRVectors, [PnlVector] ) ) * SecondElementFraction ) )",
              "        * [VaR Scaling Value]",
              "        * -1 )"
            ],
            "formatString": "#,0.00",
            "isHidden": true,
            "lineageTag": "f4840cfe-dbb3-4686-990b-b67a92c32893",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"NumberDecimal\" Accuracy=\"2\" ThousandSeparator=\"True\" />"
              }
            ]
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          },
          {
            "name": "PBI_DescriptionAtRefresh"
          }
        ]
      },
      {
        "name": "VaR Measures",
        "excludeFromModelRefresh": true,
        "lineageTag": "01afdbbf-70a1-4668-845b-8c4294e3c175",
        "partitions": [
          {
            "name": "VaR Measures",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText(\"i44FAA==\", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Column1 = _t]),",
                "    #\"Changed Type\" = Table.TransformColumnTypes(Source,{{\"Column1\", type text}}),",
                "    #\"Removed Columns\" = Table.RemoveColumns(#\"Changed Type\",{\"Column1\"})",
                "in",
                "    #\"Removed Columns\""
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Display VAR",
            "expression": "([Date One Value]=TRUE && [Window One Value]=TRUE && [Percentile One Value]=TRUE)",
            "formatString": "\"TRUE\";\"TRUE\";\"FALSE\"",
            "isHidden": true,
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"Boolean\" />"
              }
            ]
          },
          {
            "name": "Original PnL Vector Value In USD",
            "expression": [
              "IF([Display PNL],",
              "IF([Use Trade Level DQ], [PnL Vector Value Unadjusted], IF([Use VaR Summary Level DQ],[Pnl Original Summary], [PnL Vector Value Import Unadjusted])), BLANK())"
            ],
            "formatString": "#,0.00",
            "lineageTag": "867f6d9f-da67-4021-b999-e20462c550d2",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"NumberDecimal\" Accuracy=\"2\" ThousandSeparator=\"True\" />"
              }
            ]
          },
          {
            "name": "Highlight VaR Change",
            "expression": [
              "IF(",
              "    ABS( [VaR DoD Change %] ) > 0,",
              "    IF(",
              "        ABS( [VaR DoD Change %] ) > MIN( 'FlashVaR%'[Highlight%] )",
              "            && ABS( [VaR DoD Change] ) >= DIVIDE( MIN( FlashVaRAmount[HighlightAmount] ) , [Currency Unit Value] ),",
              "        1,",
              "        0",
              "    ),",
              "    BLANK( )",
              ")"
            ],
            "formatString": "0",
            "isHidden": true,
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"NumberWhole\" Accuracy=\"0\" />"
              }
            ]
          },
          {
            "name": "PnL Row Count",
            "expression": "IF(ISCROSSFILTERED(Trade[Trade Key]),  COUNTROWS('VaR Trade Direct Query'), IF(ISCROSSFILTERED(Instrument[COMMON_INSTRUMENT_KEY]) || MIN('Reporting Date'[IMPORTED_VAR])=0,COUNTROWS('VaR Book Instrument DQ'), COUNTROWS('VaR Book Import')+COUNTROWS('VAR_SUMMARY_IMPORT_MAX')))",
            "formatString": "#,0",
            "lineageTag": "d45f0146-33d3-436a-9902-ae0b9296d0c3",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"NumberWhole\" Accuracy=\"0\" ThousandSeparator=\"True\" />"
              }
            ]
          },
          {
            "name": "Pnl Vector Value In USD",
            "expression": [
              "IF([Display PNL],",
              "IF([Use Trade Level DQ], [PnL Vector Value Adjusted], IF([Use VaR Summary Level DQ],[Pnl Summary], [PnL Vector Value Import Adjusted])),BLANK())"
            ],
            "formatString": "#,0.00",
            "lineageTag": "9db3b931-59fe-4e0f-b056-15850d940867",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"NumberDecimal\" Accuracy=\"2\" ThousandSeparator=\"True\" />"
              }
            ]
          },
          {
            "name": "Previous PnL",
            "expression": [
              "",
              "CALCULATE(",
              "    [Pnl Vector Value In USD],",
              "    FILTER(ALL('Reporting Date'), 'Reporting Date'[COBId] = MIN('Previous Reporting Date'[Previous COBId]))",
              "    )"
            ],
            "formatString": "#,0.00",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"NumberDecimal\" Accuracy=\"2\" ThousandSeparator=\"True\" />"
              }
            ]
          },
          {
            "name": "Previous PnL Original",
            "expression": [
              "",
              "CALCULATE(",
              "    [Original PnL Vector Value In USD],",
              "    FILTER(ALL('Reporting Date'), 'Reporting Date'[COBId] = MIN('Previous Reporting Date'[Previous COBId]))",
              "    )"
            ],
            "formatString": "#,0.00",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"NumberDecimal\" Accuracy=\"2\" ThousandSeparator=\"True\" />"
              }
            ]
          },
          {
            "name": "Previous VaR In USD",
            "expression": "CALCULATE([VaR In USD],FILTER(ALL('Reporting Date'), 'Reporting Date'[COBId] = MAX('Previous Reporting Date'[Previous COBId])))",
            "formatString": "#,0.00",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"NumberDecimal\" Accuracy=\"2\" ThousandSeparator=\"True\" />"
              }
            ]
          },
          {
            "name": "VaR DoD Change",
            "expression": "[VaR In USD] - [Previous VaR In USD]",
            "formatString": "#,0.00",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"NumberDecimal\" Accuracy=\"2\" ThousandSeparator=\"True\" />"
              }
            ]
          },
          {
            "name": "VaR DoD Change %",
            "expression": "DIVIDE(([VaR In USD]- [Previous VaR In USD]),[Previous VaR In USD])",
            "formatString": "0 %;-0 %;0 %",
            "isHidden": true,
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"Percentage\" Accuracy=\"0\" />"
              }
            ]
          },
          {
            "name": "VaR DoD Change Original",
            "expression": "IF( ISBLANK([Previous VaR In USD]),BLANK(),([VaR In USD Original] - [Previous VaR In USD]))",
            "isHidden": true,
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"General\" />"
              }
            ]
          },
          {
            "name": "VaR In USD",
            "expression": [
              "IF (",
              "    [Display VAR],",
              "    IF (",
              "        [Use Trade Level DQ],",
              "        [VaR Trade Adjusted],",
              "        IF (",
              "            [Use VaR Summary Level DQ],",
              "            [VaR In USD Summary Adjusted],",
              "            [VaR In USD Import Adjusted]",
              "        )",
              "    ),",
              "    BLANK ()",
              ")"
            ],
            "formatString": "#,0.00",
            "lineageTag": "a810e53c-75f0-409a-8cda-6646c4f6567f",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"NumberDecimal\" Accuracy=\"2\" ThousandSeparator=\"True\" />"
              }
            ]
          },
          {
            "name": "VaR In USD Original",
            "expression": "IF([Display VAR], IF([Use Trade Level DQ], [VaR Trade UnAdjusted], IF([Use VaR Summary Level DQ],[VaR In USD Summary Unadjusted],[VaR In USD Import Unadjusted])), BLANK())",
            "formatString": "#,0.00",
            "lineageTag": "5b5bcdf4-657c-437e-9e3b-8f960af72396",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"NumberDecimal\" Accuracy=\"2\" ThousandSeparator=\"True\" />"
              }
            ]
          },
          {
            "name": "Simulated PnL Adjustment In USD",
            "expression": [
              "IF(",
              "    [Date One Value],",
              "    IF(",
              "        [Use Trade Level DQ],",
              "        [PnL Adjustment DQ],",
              "        IF( [Use VaR Summary Level DQ], [Pnl Adjustment Summary], [PnL Adjustment Import] )",
              "    ),",
              "    BLANK( )",
              ")"
            ],
            "formatString": "#,0.00",
            "lineageTag": "ad3c8f0e-638e-4b19-b76d-e540e2c79815",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"NumberDecimal\" Accuracy=\"2\" ThousandSeparator=\"True\" />"
              }
            ]
          },
          {
            "name": "VaR DoD Change % Original",
            "expression": "DIVIDE(([VaR In USD Original]- [Previous VaR In USD]),[Previous VaR In USD])",
            "formatString": "0 %;-0 %;0 %",
            "isHidden": true,
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"Percentage\" Accuracy=\"0\" />"
              }
            ]
          },
          {
            "name": "Highlight VaR Change Original",
            "expression": [
              "IF(",
              "    ABS( [VaR DoD Change % Original] ) > MIN( 'FlashVaR%'[Highlight%] )",
              "        && ABS( [VaR DoD Change Original] ) >= DIVIDE( MIN( FlashVaRAmount[HighlightAmount] ) , [Currency Unit Value] ),",
              "    1,",
              "    0",
              ")"
            ],
            "formatString": "0",
            "isHidden": true,
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"NumberWhole\" Accuracy=\"0\" />"
              }
            ]
          },
          {
            "name": "Adjustment PnL Row Count",
            "expression": [
              "",
              "IF([Use Trade Level DQ],  [Adjustment PnL Row DQ Count], IF([Use VaR Summary Level DQ], [Adjustment PnL Row Count Summary], [Adjustment PnL Row Count Import]))"
            ],
            "formatString": "0",
            "lineageTag": "8d10f1b8-8345-486b-a26c-142cd3305247",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"NumberWhole\" Accuracy=\"0\" />"
              }
            ]
          },
          {
            "name": "VaR Adjustment Difference",
            "expression": "[VaR In USD Original]-[VaR In USD]",
            "isHidden": true,
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"General\" />"
              }
            ]
          },
          {
            "name": "VaR In Reporting Currency",
            "expression": "DIVIDE([VaR In USD], [Exchange Rate]) * [Currency Unit Value]",
            "formatString": "#,0.00",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"NumberDecimal\" Accuracy=\"2\" ThousandSeparator=\"True\" />"
              }
            ]
          },
          {
            "name": "UnAdjusted VaR In Reporting Currency",
            "expression": "DIVIDE([VaR In USD Original] , [Exchange Rate]) * [Currency Unit Value]",
            "formatString": "#,0.00",
            "lineageTag": "253a642d-ce14-47f2-93f4-a81921c6191e",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"NumberDecimal\" Accuracy=\"2\" ThousandSeparator=\"True\" />"
              }
            ]
          },
          {
            "name": "Original PnL In Reporting Currency",
            "expression": "DIVIDE([Original PnL Vector Value In USD],[Exchange Rate]) * [Currency Unit Value] * [VaR Scaling Value]",
            "formatString": "#,0.00",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"NumberDecimal\" Accuracy=\"2\" ThousandSeparator=\"True\" />"
              }
            ]
          },
          {
            "name": "VaR Scenario Date",
            "expression": [
              "VAR ScenarioTable =",
              "    SUMMARIZE(",
              "        'PnL Vector Element Ordinal',",
              "        'PnL Vector Element Ordinal'[SCENARIO_DATE_ID],",
              "        \"PnlVector\", [Pnl Vector Value In USD]",
              "    )",
              "VAR VaRVectors = TOPN( 2, TOPN( [Second Element Sl No Summary], ScenarioTable, [PnlVector], ASC ), [PnlVector], DESC )",
              "RETURN",
              "    CALCULATE( MAXX( VaRVectors, 'PnL Vector Element Ordinal'[SCENARIO_DATE_ID] ) )"
            ],
            "formatString": "0",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"NumberWhole\" Accuracy=\"0\" />"
              }
            ]
          },
          {
            "name": "Previous VaR Scenario Date",
            "expression": [
              "",
              "CALCULATE(",
              "    [VaR Scenario Date],",
              "    FILTER(ALL('Reporting Date'), 'Reporting Date'[COBId] = MAX('Previous Reporting Date'[Previous COBId]))",
              "    )"
            ],
            "formatString": "0",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"NumberWhole\" Accuracy=\"0\" />"
              }
            ]
          },
          {
            "name": "PnL Rank",
            "expression": "RANKX(ALL('PnL Vector Element Ordinal'[PnL Vector Element Date]),[Pnl Vector Value In USD],[Pnl Vector Value In USD],ASC,Skip)",
            "formatString": "0",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"NumberWhole\" Accuracy=\"0\" />"
              }
            ]
          },
          {
            "name": "Simulated PnL In Reporting Currency",
            "expression": "DIVIDE( [Pnl Vector Value In USD], [Exchange Rate] ) * [Currency Unit Value] * [VaR Scaling Value]",
            "formatString": "#,0.00",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"NumberDecimal\" Accuracy=\"2\" ThousandSeparator=\"True\" />"
              }
            ]
          },
          {
            "name": "Previous VaR In Reporting Currency",
            "expression": "CALCULATE([VaR In Reporting Currency],FILTER(ALL('Reporting Date'), 'Reporting Date'[COBId] = MAX('Previous Reporting Date'[Previous COBId])))",
            "formatString": "#,0.00",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"NumberDecimal\" Accuracy=\"2\" ThousandSeparator=\"True\" />"
              }
            ]
          },
          {
            "name": "VaR DoD Change Reporting Currency",
            "expression": "[VaR In Reporting Currency] - [Previous VaR In Reporting Currency]",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"General\" />"
              }
            ]
          },
          {
            "name": "Adjustment PnL In Reporting Currency",
            "expression": "DIVIDE([Simulated PnL Adjustment In USD], [Exchange Rate]) * [Currency Unit Value] * [VaR Scaling Value]",
            "formatString": "#,0.00",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"NumberDecimal\" Accuracy=\"2\" ThousandSeparator=\"True\" />"
              }
            ]
          },
          {
            "name": "Use Trade Level DQ",
            "expression": "ISCROSSFILTERED(Trade[Trade Key]) || (ISCROSSFILTERED('Official Source') && MIN('Official Source'[OfficialsourceValue]) = 0)",
            "formatString": "\"TRUE\";\"TRUE\";\"FALSE\"",
            "isHidden": true,
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"Boolean\" />"
              }
            ]
          },
          {
            "name": "Difference VaR",
            "expression": "[VaR In USD]-[VaR In USD Original]",
            "isHidden": true,
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"General\" />"
              }
            ]
          },
          {
            "name": "Display PNL",
            "expression": "[Date One Value]=TRUE",
            "formatString": "\"TRUE\";\"TRUE\";\"FALSE\"",
            "isHidden": true,
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"Boolean\" />"
              }
            ]
          },
          {
            "name": "P-Value",
            "expression": [
              "VAR tmp =",
              "    SUMMARIZE(",
              "        'PnL Vector Element Ordinal',",
              "        'PnL Vector Element Ordinal'[SCENARIO_DATE_ID],",
              "        \"value\", [Original PnL Vector Value In USD]",
              "    )",
              "VAR zeropnl = FILTER( tmp, [Original PnL Vector Value In USD] <> 0 )",
              "VAR lessthan = FILTER( zeropnl, [Original PnL Vector Value In USD] < [IPV HypoPnL] )",
              "VAR num = COUNTROWS( lessthan )",
              "RETURN",
              "    IF(",
              "        ISBLANK( [IPV HypoPnL] ) && NOT ( ISBLANK( [Original PnL Vector Value In USD] ) ),",
              "        -1,",
              "        IF(",
              "            ISBLANK( [Original PnL Vector Value In USD] ) && NOT ( ISBLANK( [IPV HypoPnL] ) ),",
              "            -1,",
              "            IF(",
              "                ISBLANK( [IPV HypoPnL] ) && ISBLANK( [Original PnL Vector Value In USD] ),",
              "                BLANK( ),",
              "                ( DIVIDE( ( num + 0.5 ),( [Number Of Scenarios] ) ) )",
              "            )",
              "        )",
              "    )"
            ],
            "formatString": "0.0000",
            "lineageTag": "3ec8d0a9-f454-42d8-af46-4672a2b23ab1",
            "annotations": [
              {
                "name": "PBI_ChangedProperties",
                "value": "[\"FormatString\"]"
              }
            ]
          },
          {
            "name": "UnAdjusted VaR In Reporting Currency 0dp",
            "expression": "[UnAdjusted VaR In Reporting Currency]",
            "formatString": "#,0",
            "isHidden": true,
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"NumberDecimal\" Accuracy=\"0\" ThousandSeparator=\"True\" />"
              }
            ]
          },
          {
            "name": "Use VaR Summary Level DQ",
            "expression": [
              "",
              "    ISCROSSFILTERED(Instrument[COMMON_INSTRUMENT_KEY]) || ",
              "    ISCROSSFILTERED('Instrument Other'[COMMON_INSTRUMENT_FCD_KEY]) || ",
              "    MIN('Reporting Date'[IMPORTED_VAR])=0"
            ],
            "formatString": "\"TRUE\";\"TRUE\";\"FALSE\"",
            "isHidden": true,
            "lineageTag": "d7d5cfad-1623-4ce2-9f75-0cc79f680dfb",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"Boolean\" />"
              }
            ]
          },
          {
            "name": "VaR DoD Change Original Reporting Currency 0dp",
