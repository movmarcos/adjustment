            "lineageTag": "4441eca8-9773-48ea-8257-90c2c4f4efc3"
          },
          {
            "name": "Sensi Change Summary",
            "expression": [
              "VAR _SENSI =",
              "    CALCULATE ( SUM ( 'Sensitivity Summary Fields'[MEASURE_VALUE_USD] ),'Historic COB List'[COBID] = SELECTEDVALUE ( 'Reporting Date'[COBID] ) )",
              "VAR _DIFF =     ",
              "    _SENSI - CALCULATE (SUM ( 'Sensitivity Summary Fields'[MEASURE_VALUE_USD] ),'Historic COB List'[COBID]= SELECTEDVALUE ( 'Previous Reporting Date'[Previous COBID] ))",
              "    ",
              "VAR _DIVISOR = SELECTEDVALUE('Reporting Measure Type'[PBI Format Divisor],1)",
              "RETURN",
              "    DIVIDE ( _DIFF, _DIVISOR )",
              ""
            ],
            "formatString": "#,0.0",
            "isHidden": true,
            "lineageTag": "94ad56e7-aba0-4e8d-a9a3-1f1e892a6a30"
          },
          {
            "name": "Sensi Current Summary",
            "expression": [
              "VAR _SENSI =",
              "    CALCULATE ( SUM ( 'Sensitivity Summary Fields'[MEASURE_VALUE_USD] ), 'Historic COB List'[COBID] = SELECTEDVALUE ( 'Reporting Date'[COBID] ) )",
              "VAR _DIVISOR = SELECTEDVALUE('Reporting Measure Type'[PBI Format Divisor],1)",
              "RETURN",
              "    DIVIDE ( _SENSI, _DIVISOR )"
            ],
            "formatString": "#,0.0",
            "isHidden": true,
            "lineageTag": "642942f9-53f4-46f0-ac4c-1b1a1b15f03f"
          }
        ],
