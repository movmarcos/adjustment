        "partitions": [
          {
            "name": "Sensitivity Summary DQ",
            "mode": "directQuery",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Snowflake.Databases(\"tj90313.west-europe.azure.snowflakecomputing.com\",WarehouseName),",
                "    Database = Source{[Name=DBName,Kind=\"Database\"]}[Data],",
                "    Schema = Database{[Name=\"FACT\",Kind=\"Schema\"]}[Data],",
                "    Data = Schema{[Name=\"SENSITIVITY_SUMMARY_COMBINED\",Kind=\"View\"]}[Data],",
                "    #\"Renamed Columns\" = Table.RenameColumns(Data,{{\"ENTITY_KEY\", \"Entity Key\"}, {\"SOURCE_SYSTEM_CODE\", \"Source System Code\"}, {\"BOOK_KEY\", \"Book Key\"}, {\"TENOR_CURRENCY_KEY\", \"Tenor Currency Key\"}, {\"UNDERLYING_TENOR_CURRENCY_KEY\", \"Underlying Tenor Currency Key\"}, {\"CURRENCY_CODE\", \"Currency Code\"}, {\"CURVE_CURRENCY_KEY\", \"Curve Key\"}, {\"COUNTERPARTY_KEY\", \"Counterparty Key\"}, {\"MEASURE_TYPE_KEY\", \"Measure Type Key\"}, {\"MEASURE_VALUE_USD\", \"Measure Value USD\"}, {\"COMMON_INSTRUMENT_KEY\", \"Common Instrument Key\"}, {\"COMMON_INSTRUMENT_FCD_KEY\", \"Common Instrument FCD Key\"}, {\"CURRENCY_PAIR_KEY\", \"Currency Pair Key\"}, {\"SKEW_KEY\", \"Skew Key\"}, {\"CORRELATION_KEY\", \"Correlation Key\"}, {\"REGION_AREA_KEY\", \"Region Area Key\"}, {\"PRODUCT_CATEGORY_ATTRIBUTES_KEY\", \"Product Categoty Attributes Key\"}, {\"IS_ADJUSTMENT\", \"Is Adjustment\"}, {\"ADJUSTMENT_ID\", \"Adjustment ID\"}, {\"BASE_SPREAD_BAND_KEY\", \"Base Spread Band Key\"}, {\"BASE_BETA_BAND_KEY\", \"Base Beta Band Key\"},{\"IS_OFFICIAL_SOURCE\", \"Is Official Source\"}, {\"IS_DECOMPOSED\", \"Is Decomposed\"}})",
                "in",
                "    #\"Renamed Columns\""
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Count Sensi Summary DQ",
            "expression": [
              "",
              "countrows('Sensitivity Summary DQ')"
            ],
            "isHidden": true,
            "lineageTag": "06e57668-df9e-470b-8953-41b91939231e"
          },
          {
            "name": "Sensi Summary DQ Adjustment USD",
            "expression": [
              "",
              "CALCULATE(",
              "    SUM('Sensitivity Summary DQ'[Measure Value USD]), ",
              "    FILTER(ALL('IsAdjustment'), IsAdjustment[Is Adjustment] = 1)",
              ")"
            ],
            "isHidden": true,
            "lineageTag": "0bcc04d7-2d6c-4c00-8408-3472614e3b92"
          },
          {
            "name": "Sensi Summary DQ Measure Value USD Original",
            "expression": [
              "",
              "CALCULATE(",
              "    SUM('Sensitivity Summary DQ'[Measure Value USD]), ",
              "    FILTER(ALL('IsAdjustment'), IsAdjustment[Is Adjustment] = 0)",
              ")"
            ],
            "isHidden": true,
            "lineageTag": "52795bcf-ba46-4dfd-ab58-6a24959b30a7"
          },
          {
            "name": "Sensi Summary DQ Measure Value USD",
            "expression": " SUM('Sensitivity Summary DQ'[Measure Value USD])",
            "isHidden": true,
            "lineageTag": "fb60e14b-5e00-487b-8efe-44b2acb05080"
          },
          {
            "name": "Cash Adjustment Original",
            "expression": [
              "IF (",
              "    [Use Sensi Trade Level DQ],",
              "    CALCULATE (",
              "        [Sensi Detail DQ Measure Value USD Original],",
              "        'Reporting Measure Type'[MeasureTypeKey] = 67",
              "    ),",
              "    CALCULATE (",
              "        [Sensi Summary DQ Measure Value USD Original],",
              "        'Reporting Measure Type'[MeasureTypeKey] = 67",
              "    )",
              ")"
            ],
            "isHidden": true,
            "lineageTag": "f58d77db-de64-4e7c-bd49-969b2560ae20"
          },
          {
            "name": "Cash Adjustment",
            "expression": [
              "IF (",
              "    [Use Sensi Trade Level DQ],",
              "    CALCULATE (",
              "        [Sensi Detail DQ Measure Value USD],",
              "        'Reporting Measure Type'[MeasureTypeKey] = 67",
              "    ),",
              "    CALCULATE (",
              "        [Sensi Summary DQ Measure Value USD],",
              "        'Reporting Measure Type'[MeasureTypeKey] = 67",
              "    )",
              ")"
            ],
            "isHidden": true,
            "lineageTag": "3677f947-efab-46d3-8621-d6f476155742"
          }
        ]
      },
