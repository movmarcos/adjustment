          {
            "name": "Original Simulation Pl MRM_S_PARA_StdCombinedStress_Calc",
            "expression": [
              "",
              "SUMX({",
              "    [Original Simulation Pl MRM_M_PARA_CreditStandard] * 0.8,",
              "    [Original Simulation Pl MRM_M_PARA_EQ_StdStress] * 0.9,",
              "    [Original Simulation Pl MRM_S_PARA_StdRatesStress] * 0.4 ",
              "    }",
              "    ,[Value]",
              "    )",
              ""
            ],
            "isHidden": true,
