            "    FACT_Schema = RAPTOR_Database{[Name=\"FACT\",Kind=\"Schema\"]}[Data],",
            "    VAR_SUMMARY_IMPORT_CYCLIC_View = FACT_Schema{[Name=\"VAR_SUMMARY_IMPORT_CYCLIC\",Kind=\"View\"]}[Data],",
