            "summarizeBy": "sum",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          }
        ],
        "partitions": [
          {
            "name": "Report Measures",
            "mode": "import",
            "source": {
              "type": "calculated",
              "expression": "Row(\"Column\", BLANK())"
            }
          }
        ],
        "measures": [
          {
            "name": "Limit_table_flag",
            "expression": [
              "VAR COBID =",
              "    SELECTEDVALUE ( 'Reporting Date'[COBID] )",
              "VAR _ORG_LVL_MEAS = [Organization_level]",
              "VAR Organization_Entity_limits =",
              "    VALUES ( 'Entity 2'[Entity Code Original] )",
              "VAR Organization_Ent_Dep_limits =",
              "    VALUES ( 'Department 2'[Entity Code Original] )",
              "VAR Organization_Dep_limits =",
              "    VALUES ( 'Department 2'[Department Code] )",
              "VAR Organization_BU_limits =",
              "    VALUES ( 'Business Line 2'[Business Unit Code] )",
              "VAR Organization_Volcker_limits =",
              "    VALUES ( 'Department 2'[Volcker Desk] )",
              "VAR Organization_Units_limits =",
              "    UNION (",
              "        Organization_Dep_limits,",
              "        Organization_BU_limits,",
              "        Organization_volcker_limits,",
              "        Organization_Entity_limits",
              "    )",
              "VAR LIMITS_TABLE_FILTERED =",
              "    SELECTCOLUMNS (",
              "        FILTER (",
              "            'Limit Department',",
              "            (",
              "                IF (",
              "                    CONTAINSSTRING(_ORG_LVL_MEAS,\"BU\"),",
              "                    (( 'Limit Department'[Entity] IN Organization_Entity_limits ) || 'Limit Department'[Entity] = \"MUS\")",
              "                        && ( 'Limit Department'[Organisation] IN Organization_Units_limits )",
              "                        && ( 'Limit Department'[Organisation Level]",
              "                        IN { \"Business Unit\"} ),",
              "                    IF (",
              "                        CONTAINSSTRING(_ORG_LVL_MEAS,\"VOLCKER\"),",
              "                        ( 'Limit Department'[Entity] IN Organization_Ent_Dep_limits )",
              "                            && ( 'Limit Department'[Organisation] IN Organization_Units_limits )",
              "                            && ( 'Limit Department'[Organisation Level] IN { \"Volcker Desk\" } ),",
              "                        IF (",
              "                            CONTAINSSTRING(_ORG_LVL_MEAS,\"DEP\"),",
              "                            ( 'Limit Department'[Entity] IN Organization_Ent_Dep_limits )",
              "                                && ( 'Limit Department'[Organisation] IN Organization_Units_limits )",
              "                                && ( 'Limit Department'[Organisation Level] IN { \"Department\" , \"Volcker Desk\" } )",
              "                        )",
              "                    )",
              "                )",
              "                    && 'Limit Department'[COBID] = COBID",
              "            )",
              "        ),",
              "        \"IDS\", 'Limit Department'[COBID] &\"_\"&'Limit Department'[ComparitiveID]",
              "    )",
              "RETURN",
              "    IF (",
              "        (SELECTEDVALUE ( 'Limit Department'[COBID] ) &\"_\"&SELECTEDVALUE ('Limit Department'[ComparitiveID])) IN LIMITS_TABLE_FILTERED,",
              "        1,",
              "        0",
              "    )"
            ],
            "lineageTag": "e8809c1c-ce5a-4c56-91fc-d57a1b5411a1"
          },
          {
            "name": "Top 10 Org Names by CS01/CS1%/MV Changes",
            "expression": [
              "VAR MEASURES_TABLE =",
              "    ADDCOLUMNS (",
              "        ALL ( Instrument[Ultimate Organisation Name], Instrument[Industry Name] ),",
              "        \"MV\",",
              "            ABS (",
              "                CALCULATE (",
              "                    [Sensi Change Detail ST1],",
              "                    'MeasureType Order CT'[CT Display Name] = \"Market Value ($m)\",",
              "                    'MeasureType Order CT'[NameOrder] = 2",
              "                )",
              "            ),",
              "        \"CS01\",",
              "            ABS (",
              "                CALCULATE (",
              "                    [Sensi Change Detail ST1],",
              "                    'MeasureType Order CT'[CT Display Name] = \"CS01 ($k/-bp)\",",
              "                    'MeasureType Order CT'[NameOrder] = 3",
              "                )",
              "            ),",
              "        \"CS1PC\",",
              "            ABS (",
              "                CALCULATE (",
              "                    [Sensi Change Detail ST1],",
              "                    'MeasureType Order CT'[CT Display Name] = \"CS1% ($k/-1%)\",",
              "                    'MeasureType Order CT'[NameOrder] = 4",
              "                )",
              "            )",
              "    )",
              "VAR TOP_MV =",
              "    TOPN (",
              "        10,",
              "        FILTER ( MEASURES_TABLE, NOT ( ISBLANK ( [MV] ) ) && [MV] <> 0 ),",
              "        [MV], DESC",
              "    )",
              "VAR TOP_CS01 =",
              "    TOPN (",
              "        10,",
              "        FILTER ( MEASURES_TABLE, NOT ( ISBLANK ( [CS01] ) ) && [CS01] <> 0 ),",
              "        [CS01], DESC",
              "    )",
              "VAR TOP_CS1PC =",
              "    TOPN (",
              "        10,",
              "        FILTER ( MEASURES_TABLE, NOT ( ISBLANK ( [CS1PC] ) ) && [CS1PC] <> 0 ),",
              "        [CS1PC], DESC",
              "    )",
              "VAR COMBINED =",
              "    SELECTCOLUMNS (",
              "        UNION ( UNION ( TOP_MV, TOP_CS01 ), TOP_CS1PC ),",
              "        \"NAME\",",
              "            Instrument[Ultimate Organisation Name] & \"_\" & Instrument[Industry Name]",
              "    )",
              "RETURN",
              "    IF (",
              "        SELECTEDVALUE ( Instrument[Ultimate Organisation Name] ) & \"_\"",
              "            & SELECTEDVALUE ( Instrument[Industry Name] ) IN COMBINED,",
              "        1,",
              "        0",
              "    )"
            ],
            "lineageTag": "250579b2-5f3c-4001-871f-85bb63d4a538"
          },
          {
            "name": "Top 10 Org Names by CS01/CS1%/MV",
            "expression": [
              "VAR MEASURES_TABLE =",
              "    ADDCOLUMNS (",
              "        ALL ( Instrument[Ultimate Organisation Name], Instrument[Industry Name] ),",
              "        \"MV\",",
              "            ABS (",
              "                CALCULATE (",
              "                    [Sensi Current Detail ST1],",
              "                    'MeasureType Order CT'[CT Display Name] = \"Market Value ($m)\",",
              "                    'MeasureType Order CT'[NameOrder] = 2",
              "                )",
              "            ),",
              "        \"CS01\",",
              "            ABS (",
              "                CALCULATE (",
              "                    [Sensi Current Detail ST1],",
              "                    'MeasureType Order CT'[CT Display Name] = \"CS01 ($k/-bp)\",",
              "                    'MeasureType Order CT'[NameOrder] = 3",
              "                )",
              "            ),",
              "        \"CS1PC\",",
              "            ABS (",
              "                CALCULATE (",
              "                    [Sensi Current Detail ST1],",
              "                    'MeasureType Order CT'[CT Display Name] = \"CS1% ($k/-1%)\",",
              "                    'MeasureType Order CT'[NameOrder] = 4",
              "                )",
              "            )",
              "    )",
              "VAR TOP_MV =",
              "    TOPN (",
              "        10,",
              "        FILTER ( MEASURES_TABLE, NOT ( ISBLANK ( [MV] ) ) && [MV] <> 0 ),",
              "        [MV], DESC",
              "    )",
              "VAR TOP_CS01 =",
              "    TOPN (",
              "        10,",
              "        FILTER ( MEASURES_TABLE, NOT ( ISBLANK ( [CS01] ) ) && [CS01] <> 0 ),",
              "        [CS01], DESC",
              "    )",
              "VAR TOP_CS1PC =",
              "    TOPN (",
              "        10,",
              "        FILTER ( MEASURES_TABLE, NOT ( ISBLANK ( [CS1PC] ) ) && [CS1PC] <> 0 ),",
              "        [CS1PC], DESC",
              "    )",
              "VAR COMBINED =",
              "    SELECTCOLUMNS (",
              "        UNION ( UNION ( TOP_MV, TOP_CS01 ), TOP_CS1PC ),",
              "        \"NAME\",",
              "            Instrument[Ultimate Organisation Name] & \"_\" & Instrument[Industry Name]",
              "    )",
              "RETURN",
              "    IF (",
              "        SELECTEDVALUE ( Instrument[Ultimate Organisation Name] ) & \"_\"",
              "            & SELECTEDVALUE ( Instrument[Industry Name] ) IN COMBINED,",
              "        1,",
              "        0",
              "    )"
            ],
            "lineageTag": "bb26bcd1-1912-49b4-b9a6-792a39738cbc"
          },
          {
            "name": "Top 5 Industry by CS01/CS1%/MV",
            "expression": [
              "VAR MEASURES_TABLE =",
              "    ADDCOLUMNS (",
              "        ALL ( Instrument[Industry Name] ),",
              "        \"MV\",",
              "            ABS (",
              "                CALCULATE (",
              "                    [Measure Value in USD Simple],",
              "                    'MeasureType Order CT'[CT Display Name] = \"Market Value ($m)\",",
              "                    'MeasureType Order CT'[NameOrder] = 2",
              "                )",
              "            ),",
              "        \"CS01\",",
              "            ABS (",
              "                CALCULATE (",
              "                    [Measure Value in USD Simple],",
              "                    'MeasureType Order CT'[CT Display Name] = \"CS01 ($k/-bp)\",",
              "                    'MeasureType Order CT'[NameOrder] = 3",
              "                )",
              "            ),",
              "        \"CS1PC\",",
              "            ABS (",
              "                CALCULATE (",
              "                    [Measure Value in USD Simple],",
              "                    'MeasureType Order CT'[CT Display Name] = \"CS1% ($k/-1%)\",",
              "                    'MeasureType Order CT'[NameOrder] = 4",
              "                )",
              "            )",
              "    )",
              "VAR TOP_CS01 =",
              "    TOPN ( 5, FILTER ( MEASURES_TABLE, NOT ( ISBLANK ( [CS01] ) ) ), [CS01], DESC )",
              "VAR TOP_CS1PC =",
              "    TOPN (",
              "        5,",
              "        FILTER ( MEASURES_TABLE, NOT ( ISBLANK ( [CS1PC] ) ) ),",
              "        [CS1PC], DESC",
              "    )",
              "VAR TOP_MV =",
              "    TOPN ( 5, FILTER ( MEASURES_TABLE, NOT ( ISBLANK ( [MV] ) ) ), [MV], DESC )",
              "VAR COMBINED =",
              "    SELECTCOLUMNS (",
              "        KEEPFILTERS ( UNION ( UNION ( TOP_CS01, TOP_MV ), TOP_CS1PC ) ),",
              "        \"NAME\", Instrument[Industry Name]",
              "    )",
              "RETURN",
              "    IF ( SELECTEDVALUE ( Instrument[Industry Name] ) IN COMBINED, 1, 0 )"
            ],
            "lineageTag": "7ef00a0e-956e-42a7-b549-f663f3f872d5"
          },
          {
            "name": "Top 5 Org Names by CS1% Basis",
            "expression": [
              "VAR ORG_TABLE =",
              "    SUMMARIZE (",
              "        ALL ( Instrument ),",
              "        Instrument[Ultimate Organisation Name],",
              "        Instrument[Organisation Name]",
              "    )",
              "VAR VALUES_TABLE =",
              "    ADDCOLUMNS (",
              "        ORG_TABLE,",
              "        \"VALUES\",",
              "            CALCULATE (",
              "                [Sensi Current Detail ST1],",
              "                'MeasureType Order CT'[CT Display Name] = \"CS1% ($k/-1%)\",",
              "                'MeasureType Order CT'[NameOrder] = 4",
              "            ),",
              "        \"ABS_VALUES\",",
              "            ABS (",
              "                CALCULATE (",
              "                    [Sensi Current Detail ST1],",
              "                    'MeasureType Order CT'[CT Display Name] = \"CS1% ($k/-1%)\",",
              "                    'MeasureType Order CT'[NameOrder] = 4",
              "                )",
              "            )",
              "    )",
              "VAR ULT_ORG_TABLE =",
              "    GROUPBY (",
              "        VALUES_TABLE,",
              "        Instrument[Ultimate Organisation Name],",
              "        \"SUM\", SUMX ( CURRENTGROUP (), [VALUES] ),",
              "        \"SUM_ABS\", SUMX ( CURRENTGROUP (), [ABS_VALUES] )",
              "    )",
              "VAR BASIS_TABLE =",
              "    FILTER (",
              "        ADDCOLUMNS (",
              "            ULT_ORG_TABLE,",
              "            \"DIFF\", ROUND ( [SUM_ABS], 1 ) - ROUND ( ABS ( [SUM] ), 1 )",
              "        ),",
              "        [DIFF] <> 0",
              "    )",
              "VAR TOP_TABLE =",
              "    SELECTCOLUMNS (",
              "        KEEPFILTERS ( TOPN ( 5, BASIS_TABLE, [DIFF], DESC ) ),",
              "        \"NAMES\", Instrument[Ultimate Organisation Name]",
              "    )",
              "RETURN",
              "    IF (",
              "        SELECTEDVALUE ( Instrument[Ultimate Organisation Name] ) IN TOP_TABLE,",
              "        1,",
              "        0",
              "    )"
            ],
            "lineageTag": "8ca20486-aec8-4a31-bbf2-c9485dd72d6a"
          },
          {
            "name": "Top 5 Org Names by EqDelta/Vega",
            "expression": [
              "VAR MEASURES_TABLE =",
              "    ADDCOLUMNS (",
              "        ALL ( Instrument[Ultimate Organisation Name] ),",
              "        \"DELTA\",",
              "            ABS (",
              "                CALCULATE (",
              "                    [Measure Value in USD Simple],",
              "                    'MeasureType Order EQ'[EQ Display Name] = \"Equity Delta ($m)\",",
              "                    'MeasureType Order EQ'[NameOrder] = 1",
              "                )",
              "            ),",
              "        \"VEGA\",",
              "            ABS (",
              "                CALCULATE (",
              "                    [Measure Value in USD Simple],",
              "                    'MeasureType Order EQ'[EQ Display Name] = \"Equity Vega ($k/1%)\",",
              "                    'MeasureType Order EQ'[NameOrder] = 4",
              "                )",
              "            )",
              "    )",
              "VAR TOP_DELTA =",
              "    TOPN (",
              "        5,",
              "        FILTER ( MEASURES_TABLE, NOT ( ISBLANK ( [DELTA] ) ) ),",
              "        [DELTA], DESC",
              "    )",
              "VAR TOP_VEGA =",
              "    TOPN ( 5, FILTER ( MEASURES_TABLE, NOT ( ISBLANK ( [VEGA] ) ) ), [VEGA], DESC )",
              "VAR COMBINED =",
              "    SELECTCOLUMNS (",
              "        KEEPFILTERS ( UNION ( TOP_DELTA, TOP_VEGA ) ),",
              "        \"NAME\", Instrument[Ultimate Organisation Name]",
              "    )",
              "RETURN",
              "    IF (",
              "        SELECTEDVALUE ( Instrument[Ultimate Organisation Name] ) IN COMBINED,",
              "        1,",
              "        0",
              "    )"
            ],
            "lineageTag": "371f44b4-38a4-4bd9-9fa4-e3bd1eb880ca"
          },
          {
            "name": "Top 1 Org/Cp OTC EQDelta Large Cap - Value",
            "expression": [
              "VAR MEASURES_TABLE =",
              "    SUMMARIZECOLUMNS (",
              "        Instrument[Organisation Name],",
              "        Counterparty[Counterparty Name],",
              "        \"Delta\", ABS ( CALCULATE ( [Measure Value in USD Simple] ) ),",
              "        \"Market Cap\", [Current Market Cap USD]",
              "    )",
              "RETURN",
              "    MAXX ( FILTER ( MEASURES_TABLE, [Market Cap] >= 10000 ), [Delta] )"
            ],
            "formatString": "#,##0.00",
            "lineageTag": "6bd035a9-d510-44a8-b4c2-28a9d1620030"
          },
          {
            "name": "Top 1 Org/Cp OTC EQDelta Mid Cap - Value",
            "expression": [
              "VAR MEASURES_TABLE =",
              "    SUMMARIZECOLUMNS (",
              "        Instrument[Organisation Name],",
              "        Counterparty[Counterparty Name],",
              "        \"Delta\", ABS ( CALCULATE ( [Measure Value in USD Simple] ) ),",
              "        \"Market Cap\", [Current Market Cap USD]",
              "    )",
              "RETURN",
              "    MAXX ( FILTER ( MEASURES_TABLE, [Market Cap] >= 5000 && [Market Cap] < 10000 ), [Delta] )"
            ],
            "formatString": "#,##0.00",
            "lineageTag": "fb760f29-cd6b-48fc-b983-a1f91ef58447"
          },
          {
            "name": "Top 1 Org/Cp OTC EQDelta Small Cap - Value",
            "expression": [
              "VAR MEASURES_TABLE =",
              "    SUMMARIZECOLUMNS (",
              "        Instrument[Organisation Name],",
              "        Counterparty[Counterparty Name],",
              "        \"Delta\", ABS ( CALCULATE ( [Measure Value in USD Simple] ) ),",
              "        \"Market Cap\", [Current Market Cap USD]",
              "    )",
              "RETURN",
              "    MAXX ( FILTER ( MEASURES_TABLE, [Market Cap] < 5000 ), [Delta] )"
            ],
            "formatString": "#,##0.00",
            "lineageTag": "1f123206-eada-47d4-874c-2042d60aabac"
          }
        ],
