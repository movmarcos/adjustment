          {
            "name": "Pnl All Department Import",
            "expression": "CALCULATE([PnL Vector Value Import Adjusted],ALL('Book'[Department Code]))",
            "isHidden": true,
            "lineageTag": "a1db67f9-a29d-4695-ac83-7073ef0c45e0",
            "annotations": [
              {
                "name": "Format",
