        "partitions": [
          {
            "name": "Adjustment",
            "mode": "directQuery",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Snowflake.Databases(\"tj90313.west-europe.azure.snowflakecomputing.com\", WarehouseName, null),",
                "    RAPTOR_Database = Source{[Name=DBName,Kind=\"Database\"]}[Data],",
                "    DIMENSION_Schema = RAPTOR_Database{[Name=\"DIMENSION\",Kind=\"Schema\"]}[Data],",
                "    VW_ADJUSTMENT_View = DIMENSION_Schema{[Name=\"VW_ADJUSTMENT\",Kind=\"View\"]}[Data],",
                "    #\"Renamed Columns\" = Table.RenameColumns(VW_ADJUSTMENT_View,{{\"ADJUSTMENT_ID\", \"Adjustment Id\"}, {\"ADJUSTMENT_TYPE\", \"Type\"}, {\"ADJUSTMENT_VALUE_IN_USD\", \"Value\"}, {\"APPROVAL_ID\", \"Approval Id\"}, {\"BOOK_CODE\", \"Book Code\"}, {\"CREATED_DATE\", \"Created Date\"}, {\"CURRENCY_CODE\", \"Currency\"}, {\"DELETED_BY\", \"Deleted By\"}, {\"DELETED_DATE\", \"Deleted date\"}, {\"DEPARTMENT_CODE\", \"Department\"}, {\"ENTITY_CODE\", \"Entity\"}, {\"ERRORMESSAGE\", \"Error Message\"}, {\"GLOBAL_REFERENCE\", \"Global Reference\"}, {\"GUARANTEED_ENTITY\", \"Guaranteed Entity\"}, {\"INSTRUMENT_CODE\", \"Instrument\"}, {\"IS_DELETED\", \"Is Deleted\"}, {\"PROCESS_DATE\", \"Process Date\"}, {\"PROCESS_TYPE\", \"Process Type\"}, {\"REASON\", \"Reason\"}, {\"RECORD_COUNT\", \"Record Count\"}, {\"REGION_CODE\", \"Region Code\"}, {\"RUN_STATUS\", \"Status\"}, {\"SCALE_FACTOR\", \"Scale Factor\"}, {\"SCENARIO_DATE_ID\", \"Scenario Date\"}, {\"STRATEGY\", \"Strategy\"}, {\"TRADE_CODE\", \"Trade Code\"}, {\"TRADE_TYPOLOGY\", \"Typology\"}, {\"SOURCE_COBID\", \"Source COB\"}, {\"SOURCE_SYSTEM_CODE\", \"Source System\"}, {\"TRADER_CODE\", \"Trader\"}, {\"USERNAME\", \"Username\"}, {\"VAR_COMPONENT_NAME\", \"Component\"}, {\"VAR_SUB_COMPONENT_NAME\", \"Sub Component\"}, {\"PROCESS_TIME\", \"Process Time2\"}, {\"PROCESS_DATETIME\", \"Process DateTime\"}, {\"SIMULATION_NAME\", \"Simulation\"}, {\"PRODUCT_CATEGORY_ATTRIBUTES\", \"Product Category Attributes\"}, {\"FREQUENCY\", \"Frequency\"}, {\"ADJUSTMENT_COMPONENT_DAY_TYPE\", \"Adjustment Component Day Type\"}})",
                "in",
                "    #\"Renamed Columns\""
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Adjustment Count",
            "expression": "COUNTROWS(Adjustment)",
            "formatString": "0",
            "isHidden": true,
            "lineageTag": "33cd94fd-7721-44c2-9908-ac30232d5a00",
            "changedProperties": [
              {
