      },
      {
        "name": "Market Risk Measure Summary Adjustment",
        "lineageTag": "b9cb3617-8e70-4c0d-b2c9-a242df8259ef",
        "partitions": [
          {
            "name": "Market Risk Measure Summary Adjustment",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText(\"i45WMlCKjQUA\", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Column1 = _t]),",
                "    #\"Changed Type\" = Table.TransformColumnTypes(Source,{{\"Column1\", Int64.Type}}),",
                "    #\"Removed Columns\" = Table.RemoveColumns(#\"Changed Type\",{\"Column1\"})",
                "in",
                "    #\"Removed Columns\""
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Adjustment Both Tenor Group Weighting",
            "expression": [
              "VAR TenorGrp =",
              "    SUMMARIZECOLUMNS (",
              "        TenorGroupMapping[Weighting],",
              "        UnderlyingTenorGroupMapping[Weighting],",
              "        \"value\",",
              "        [Adjustment Value in USD Simple]",
              "    )",
              "RETURN",
              "    SUMX ( TenorGrp, [value] * TenorGroupMapping[Weighting] * UnderlyingTenorGroupMapping[Weighting] )"
            ],
            "isHidden": true,
            "displayFolder": "TenorMeasures",
            "lineageTag": "df2d45bf-8cd3-435c-838f-b02d372f4836",
            "changedProperties": [
              {
                "property": "IsHidden"
              }
            ],
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "Adjustment Tenor Group Weighting",
            "expression": [
              "VAR TenorGrp =",
              "    SUMMARIZECOLUMNS (",
              "        TenorGroupMapping[Weighting],",
              "        \"value\",",
              "        [Adjustment Value in USD Simple]",
              "    )",
              "RETURN",
              "    SUMX ( TenorGrp, [value] * TenorGroupMapping[Weighting] )"
            ],
            "isHidden": true,
            "displayFolder": "TenorMeasures",
            "lineageTag": "e742359c-e94f-49d3-81b8-d3b7a6dd78e7",
            "changedProperties": [
              {
                "property": "IsHidden"
              }
            ],
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "Adjustment Tenor Selection",
            "expression": [
              "",
              "SWITCH(",
              "       [Tenor Selection value],",
              "    0, [Adjustment Value in USD Simple],",
              "    1, [Adjustment Tenor Group Weighting],",
              "    2, [Adjustment Underlying Tenor Group Weighting],",
              "    3, [Adjustment Both Tenor Group Weighting]",
              ")",
              ""
            ],
            "isHidden": true,
            "displayFolder": "TenorMeasures",
            "lineageTag": "3d36f26f-762d-4c56-b0ce-d5725ec2eae0",
            "changedProperties": [
              {
                "property": "IsHidden"
              }
            ],
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "Adjustment Underlying Tenor Group Weighting",
            "expression": [
              "VAR TenorGrp =",
              "    SUMMARIZECOLUMNS (",
              "        UnderlyingTenorGroupMapping[Weighting],",
              "        \"value\",",
              "            [Adjustment Value in USD Simple]",
              "    )",
              "RETURN",
              "    SUMX ( TenorGrp, [value] * UnderlyingTenorGroupMapping[Weighting] )"
            ],
            "isHidden": true,
            "displayFolder": "TenorMeasures",
            "lineageTag": "224c0517-cc28-4783-aac2-3e8f95ebabf9",
            "changedProperties": [
              {
                "property": "IsHidden"
              }
            ],
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "Adjustment Value in USD Simple",
            "expression": [
              "",
              "IF([Display Sensi],",
              "    IF([Use Sensi Trade Level DQ], ",
              "        IF(",
              "            MIN( 'Reporting Date'[IMPORTED_SENSITIVITY_DETAIL] ) = 1 ,",
              "            [Sensi Detail Import Adjustment USD],",
              "            [Sensi Detail DQ Adjustment USD]",
              "        ),",
              "        IF([Use Sensi Summary Level DQ],",
              "            [Sensi Summary DQ Adjustment USD], ",
              "            [Sensi Summary Adjustment Import USD]",
              "        ) ",
              "    )",
              "    , BLANK()",
              ")"
            ],
            "formatString": "#,##0.00",
            "isHidden": true,
            "displayFolder": "TenorMeasures",
            "lineageTag": "bff76d15-d9ff-4d73-bffa-33fbe39c8a5d"
          },
          {
            "name": "Measure Adjustment Count",
            "expression": [
              "",
              "IF([Display Sensi],",
              "    IF([Use Sensi Trade Level DQ], [Count Sensi Detail DQ], ",
              "        IF([Use Sensi Summary Level DQ],[Count Sensi Summary DQ], [Count Sensi Summary Adjustment import]) ",
              "        )",
              "    , BLANK()",
              ")"
            ],
            "formatString": "0",
            "lineageTag": "14bc6723-f6cc-4a5a-86d4-52fb601f665f"
          },
          {
            "name": "Measure Adjustment Value In Reporting Currency",
            "expression": "DIVIDE([Measure Adjustment Value in USD], [Exchange Rate])",
            "formatString": "#,##0.00",
            "lineageTag": "ae13e489-524f-4e8a-b853-29e14aa0eda7"
          },
          {
            "name": "Measure Adjustment Value in USD",
            "expression": [
              "",
              "SWITCH(",
              "       [Tenor Selection value],",
              "    0, [Adjustment Value in USD Simple],",
              "    1, [Adjustment Tenor Group Weighting],",
              "    2, [Adjustment Underlying Tenor Group Weighting],",
              "    3, [Adjustment Both Tenor Group Weighting]",
              ")",
              ""
            ],
            "formatString": "#,##0.00",
            "lineageTag": "675ba667-c33a-4eb7-9957-2cc67d78a112"
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ]
