        "partitions": [
          {
            "name": "Historic COB List",
            "mode": "import",
            "source": {
              "type": "calculated",
              "expression": [
                "",
                "",
                "\tADDCOLUMNS(",
                "\t\tSUMMARIZE(",
                "\t\t\tFILTER(",
                "\t\t\t\t'Reporting Date',",
                "\t\t\t\tISBLANK('Reporting Date'[COBID]) = FALSE",
                "\t\t\t),",
                "\t\t\t'Reporting Date'[COBID],",
                "\t\t\t'Reporting Date'[Reporting Date]",
                "\t\t),",
                "\t\t\"Display Date\", 'Reporting Date'[Reporting Date]",
                "\t)"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "6M_window_flag",
            "expression": [
              "",
              "VAR window =",
              "    DATESINPERIOD (",
              "        'Reporting Date'[Reporting Date],",
              "        SELECTEDVALUE ( 'Reporting Date'[Reporting Date] ),",
              "        -6,",
              "        MONTH",
              "    )",
              "VAR first_date =",
              "    CALCULATE (",
              "        MIN ( 'Reporting Date'[COBID] ),",
              "        window,",
              "        REMOVEFILTERS ( 'Reporting Date'[Default Date] )",
              "    )",
              "RETURN",
              "    IF (",
              "        SELECTEDVALUE ( 'Historic COB List'[COBID] ) >= first_date",
              "            && SELECTEDVALUE ( 'Historic COB List'[COBID] )",
              "                <= SELECTEDVALUE ( 'Reporting Date'[COBID] ),",
              "        1,",
              "        0",
              "    )"
            ],
            "formatString": "0",
            "isHidden": true,
            "lineageTag": "ebb51a88-9dac-4e34-8ceb-2af502d94025"
          }
        ],
        "annotations": [
