      {
        "name": "Limit Department",
        "isHidden": true,
        "lineageTag": "a95fb16d-bbd0-4191-b243-7bb3e33c3e48",
        "refreshPolicy": {
          "policyType": "basic",
          "rollingWindowGranularity": "year",
          "rollingWindowPeriods": 2,
          "incrementalGranularity": "day",
          "incrementalPeriods": 5,
          "incrementalPeriodsOffset": -1,
          "pollingExpression": "let MaxUpdateTime = List.Max(#\"Limit Department\"[UpdateTime]), accountForNull = if MaxUpdateTime = null then #datetime(1901, 01, 01, 00, 00, 00) else MaxUpdateTime in accountForNull",
          "sourceExpression": [
            "let",
            "    Source = Snowflake.Databases(\"tj90313.west-europe.azure.snowflakecomputing.com\", SF_Warehouse),",
            "    MUSBI_Database = Source{[Name=SF_DBName,Kind=\"Database\"]}[Data],",
            "    RAPTOR_Schema = MUSBI_Database{[Name=\"RAPTOR\",Kind=\"Schema\"]}[Data],",
            "    VW_LIMITS_DEPARTMENT_View = RAPTOR_Schema{[Name=\"VW_LIMITS_DEPARTMENT\",Kind=\"View\"]}[Data],",
            "    #\"Filtered Rows\" = Table.SelectRows(VW_LIMITS_DEPARTMENT_View, each [COBID] >= DateKey(RangeStart) and [COBID] < DateKey(RangeEnd)),",
            "    #\"Renamed Columns\" = Table.RenameColumns(#\"Filtered Rows\",{{\"LONGSHORT\", \"LongShort\"}, {\"CURRENT_LIMIT_FORMAT\", \"Current Limit Format\"}, {\"AMOUNT\", \"Amount\"}, {\"LIMITCURRENCYCODE\", \"Limit Currency Code\"}, {\"DETAIL\", \"Detail\"}, {\"REGULATIONTYPE\", \"Regulation Type\"}, {\"CURRENCY\", \"Currency\"}, {\"ORGANISATIONDISPLAY\", \"Organisation Display\"}, {\"ORGANISATION\", \"Organisation\"}, {\"ORGANISATIONLEVEL\", \"Organisation Level\"}, {\"DESCRIPTION\", \"Description\"}, {\"ENTITY\", \"Entity\"}, {\"CLASS\", \"Class\"}, {\"USAGE\", \"Usage\"}, {\"VERSION\", \"Version\"}, {\"COMPARATIVE\", \"Comparative\"}, {\"EXPOSUREOPERATOR\", \"Exposure Operator\"}, {\"EXPOSURETYPE\", \"Exposure Type\"}, {\"PARTY\", \"Issuer\"}, {\"RISK_TYPE_BU\", \"Risk Type BU\"}, {\"RISK_TYPE_CONSOLIDATED\", \"Risk Type Consolidated\"}, {\"RATING\", \"Rating\"} ,{\"USAGE_AMOUNT\", \"Usage Amount\"}, {\"UTILISATION\", \"UItilisation\"}, {\"UPDATETIME\", \"UpdateTime\"}, {\"COMPARATIVEID\", \"ComparitiveID\"}, {\"FORMATVALUE\", \"FormatValue\"}})",
            "",
            "in",
            "    #\"Renamed Columns\""
          ]
        },
