          {
            "type": "calculated",
            "name": "PBI Format Divisor",
            "dataType": "int64",
            "isDataTypeInferred": true,
            "isHidden": true,
            "expression": [
              "SWITCH (",
              "    TRUE (),",
              "    'Reporting Measure Type'[Reporting Measure Name]",
              "        IN {",
              "            \"Beta Adjusted Eq Delta\",",
              "            \"CVA\",",
              "            \"Equity Delta\",",
              "            \"Equity Gamma\",",
              "            \"Fx Exposure\",",
              "            \"FX Exposure T-1\",",
              "            \"Market Value\",",
              "            \"Payup Expense\",",
              "            \"Position\",",
              "            \"Gross MV\",",
              "            \"CB Eq Delta\",",
              "            \"Long MV\",",
              "            \"Short MV\",",
              "            \"Adj MV\",",
              "            \"TradedQuantity\",",
              "            \"FailingQuantity\"",
              "        }, 1000000,",
              "    'Reporting Measure Type'[Reporting Measure Name]",
              "        IN {",
              "            \"WAS\",",
              "            \"WASPerf-ABSCS01CSPD\",",
              "            \"WASPerf-ABSCS01\",",
              "            \"DownSideTwist\",",
              "            \"UpSideTwist\"",
              "        }, 1,",
              "    1000",
              ")"
            ],
            "lineageTag": "a3633132-2675-4cb9-a746-dc4b6b0c5bf3",
            "isAvailableInMdx": false
          }
        ],
        "partitions": [
          {
            "name": "Reporting Measure Type",
            "mode": "dual",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Snowflake.Databases(\"tj90313.west-europe.azure.snowflakecomputing.com\",WarehouseName),",
                "    RAPTOR_Database = Source{[Name=DBName,Kind=\"Database\"]}[Data],",
                "    DIMENSION_Schema = RAPTOR_Database{[Name=\"DIMENSION\",Kind=\"Schema\"]}[Data],",
                "    MEASURE_TYPE_Table = DIMENSION_Schema{[Name=\"MEASURE_TYPE\",Kind=\"Table\"]}[Data],",
                "    #\"Renamed Columns\" = Table.RenameColumns(MEASURE_TYPE_Table,{{\"MEASURE_TYPE_KEY\", \"MeasureTypeKey\"}, {\"MEASURE_TYPE_CODE\", \"Measure Type Code\"}, {\"MEASURE_TYPE_NAME\", \"Measure Type Name\"}, {\"MEASURE_TYPE_GROUP_NAME\", \"Measure Type Group Name\"}}),",
                "    #\"Removed Columns\" = Table.RemoveColumns(#\"Renamed Columns\",{\"IS_CREDIT_RISK_MEASURE\", \"IS_MARKET_RISK_MEASURE\", \"IS_VAR_COMPONENT\", \"IS_VAR_SUB_COMPONENT\", \"PARTITION_MEASURE_TYPE\"}),",
                "    #\"Renamed Columns1\" = Table.RenameColumns(#\"Removed Columns\",{{\"MEASURE_CATEGORY_NAME\", \"Reporting Measure Category Name\"}, {\"MEASURE_CHANGE_DESCRIPTION\", \"MeasureChangeDescription\"}, {\"REPORTING_MEASURE_KEY\", \"ReportingMeasureKey\"}, {\"REPORTING_MEASURE_NAME\", \"Reporting Measure Name\"}, {\"MEASURE_CALCULATION_TYPE\", \"Measure Calculation Type\"}}),",
                "    #\"Removed Columns1\" = Table.RemoveColumns(#\"Renamed Columns1\",{\"MEASURE_USAGE_TYPE\"})",
                "in",
                "    #\"Removed Columns1\""
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Format Divisor",
            "expression": [
              "    IF(",
              "        ISINSCOPE('Reporting Measure Type'[Reporting Measure Category Name]) || ISINSCOPE('Reporting Measure Type'[Reporting Measure Name]),",
              "        MAX('Reporting Measure Type'[FORMAT_DIVISOR]), ",
              "        1",
              "    )"
            ],
            "isHidden": true,
            "lineageTag": "68511741-ed7a-4e46-bde0-6154a934927f"
          }
        ],
