          {
            "name": "Original Simulation Pl MRM_S_PARA_StdCombinedStress",
            "expression": [
              "",
              "MINX({",
              "    [Original Simulation Pl MRM_M_PARA_CreditStandard],",
              "    [Original Simulation Pl MRM_M_PARA_EQ_StdStress],",
              "    [Original Simulation Pl MRM_S_PARA_StdRatesStress],",
              "    [Original Simulation Pl MRM_S_PARA_StdCombinedStress_Calc]",
              "},[Value])",
