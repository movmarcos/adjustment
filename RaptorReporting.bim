        "measures": [
          {
            "name": "Stress_Current",
            "expression": [
              "DIVIDE (",
              "    IF (",
              "        ISFILTERED ( 'Stress Simulation PBI Report'[Simulation Name Simple] ),",
              "        CALCULATE (",
              "            [Stress_Historic_6M],",
              "            'Historic COB List'[COBID] = SELECTEDVALUE ( 'Reporting Date'[COBID] )",
              "        ),",
              "        MINX (",
              "            SUMMARIZECOLUMNS (",
              "                'Stress Simulation PBI Report'[Simulation Name Simple],",
              "                \"STRESS\",",
              "                    CALCULATE (",
              "                        [Stress_Historic_6M],",
              "                        'Historic COB List'[COBID] = SELECTEDVALUE ( 'Reporting Date'[COBID] )",
              "                    )",
              "            ),",
              "            [STRESS]",
              "        )",
              "    ),",
              "    1000000",
              ")"
            ],
            "formatString": "#,0.0",
            "isHidden": true,
            "lineageTag": "901c55b4-70d9-4b4d-8d79-f788c4f7e94e"
          },
          {
            "name": "Stress_Historic_6M",
            "expression": [
              "VAR _COBS =",
              "    FILTER ( 'Historic COB List', [6M_window_flag] = 1 )",
              "RETURN",
              "    IF (",
              "        SELECTEDVALUE ( 'Stress Simulation PBI Report'[Calc Flag] ) = \"Y\",",
              "        MINX (",
              "            SUMMARIZECOLUMNS (",
              "                'Stress Summary PBI Report'[COBID],",
              "                'Stress Summary PBI Report'[Stress Simulation Key],",
              "                \"PL\",",
              "                    CALCULATE (",
              "                        SUM ( 'Stress Summary PBI Report'[Simulation Pl in USD] ),",
              "                        _COBS,",
              "                        USERELATIONSHIP ( 'Stress Simulation PBI Report'[Stress Simulation Key], 'Stress Summary PBI Report'[Parent Stress Simulation Key] )",
              "                    )",
              "            ),",
              "            [PL]",
              "        ),",
              "        CALCULATE (",
              "            SUM ( 'Stress Summary PBI Report'[Simulation Pl in USD] ),",
              "            _COBS,",
              "            USERELATIONSHIP ( 'Stress Simulation PBI Report'[Stress Simulation Key], 'Stress Summary PBI Report'[Stress Simulation Key] )",
              "        )",
              "    )"
            ],
            "formatString": "$#,0.##",
            "isHidden": true,
            "lineageTag": "9b257494-db36-43f3-b529-6be734bbef5d"
          },
          {
            "name": "Stress_tooltip",
            "expression": [
              "IF (",
              "    SELECTEDVALUE ( 'Stress Simulation PBI Report'[Parent Simulation Flag] ) = \"Y\",",
              "    CALCULATE (",
              "        SUM ( 'Stress Summary PBI Report'[Simulation Pl in USD] ),",
              "        USERELATIONSHIP ( 'Stress Simulation PBI Report'[Stress Simulation Key], 'Stress Summary PBI Report'[Parent Stress Simulation Key] )",
              "    ),",
              "    CALCULATE (",
              "        SUM ( 'Stress Summary PBI Report'[Simulation Pl in USD] ),",
              "        USERELATIONSHIP ( 'Stress Simulation PBI Report'[Stress Simulation Key], 'Stress Summary PBI Report'[Stress Simulation Key] )",
              "    )",
              ")"
            ],
            "formatString": "$#,0.##",
            "isHidden": true,
            "lineageTag": "fe9ba2cf-be1e-4716-a94d-948a9f4d1013"
          },
          {
            "name": "Stress Current Box Format",
            "expression": [
              "VAR _STRESS = CALCULATE([Stress_Historic_6M],'Historic COB List'[COBID] = SELECTEDVALUE('Reporting Date'[COBID]))",
              "VAR _LIMIT_FORMAT = [Current_Limit_Amount_Format]",
              "VAR _DISPLAY_UNITS =",
              "    SWITCH (",
              "        TRUE (),",
              "        ABS ( _STRESS ) < 1E6, \"$#,0,.0k\",",
              "        ABS ( _STRESS ) < 1E9, \"$#,0,,.0m\",",
              "        \"#,0,,,.0b\"",
              "    )",
              "VAR _FORMAT =",
              "    IF ( ISBLANK ( _Limit_Format ), _DISPLAY_UNITS, _Limit_Format )",
              "RETURN",
              "    FORMAT ( _STRESS, _FORMAT )"
            ],
            "isHidden": true,
            "lineageTag": "b427fcb0-ccb0-4a27-ac9e-efd421e21ef2"
          },
          {
            "name": "Stress_Current_change",
            "expression": [
              "VAR _CURRENT =",
              "    IF (",
              "        ISFILTERED ( 'Stress Simulation PBI Report'[Simulation Name Simple] ),",
              "        CALCULATE (",
              "            [Stress_Historic_6M],",
              "            'Historic COB List'[COBID] = SELECTEDVALUE ( 'Reporting Date'[COBID] )",
              "        ),",
              "        MINX (",
              "            SUMMARIZECOLUMNS (",
              "                'Stress Simulation PBI Report'[Simulation Name Simple],",
              "                \"STRESS\",",
              "                    CALCULATE (",
              "                        [Stress_Historic_6M],",
              "                        'Historic COB List'[COBID] = SELECTEDVALUE ( 'Reporting Date'[COBID] )",
              "                    )",
              "            ),",
              "            [STRESS]",
              "        )",
              "    )",
              "VAR _DIFF =",
              "    _CURRENT",
              "        - IF (",
              "            ISFILTERED ( 'Stress Simulation PBI Report'[Simulation Name Simple] ),",
              "            CALCULATE (",
              "                [Stress_Historic_6M],",
              "                'Historic COB List'[COBID]",
              "                    = SELECTEDVALUE ( 'Previous Reporting Date'[Previous COBID] )",
              "            ),",
              "            MINX (",
              "                SUMMARIZECOLUMNS (",
              "                    'Stress Simulation PBI Report'[Simulation Name Simple],",
              "                    \"STRESS\",",
              "                        CALCULATE (",
              "                            [Stress_Historic_6M],",
              "                            'Historic COB List'[COBID]",
              "                                = SELECTEDVALUE ( 'Previous Reporting Date'[Previous COBID] )",
              "                        )",
              "                ),",
              "                [STRESS]",
              "            )",
              "        )",
              "RETURN",
              "    DIVIDE ( _DIFF, 1000000 )"
            ],
            "formatString": "#,0.0",
            "isHidden": true,
            "lineageTag": "8f3b05a0-102f-4073-b892-d9f678a42565"
          },
          {
            "name": "Stress_Historic_graph",
            "expression": [
              "IF (",
              "    ISFILTERED ( 'Stress Simulation PBI Report'[Simulation Name Simple] ),",
              "    [Stress_Historic_6M],",
              "    MINX (",
              "        SUMMARIZECOLUMNS (",
              "            'Stress Simulation PBI Report'[Simulation Name Simple],",
              "            \"STRESS\", [Stress_Historic_6M]",
              "        ),",
              "        [STRESS]",
              "    )",
              ")"
            ],
            "formatString": "$#,0.##",
            "isHidden": true,
            "lineageTag": "c5b22636-2547-49c5-9074-d252ffd4d05b"
          }
        ],
