        "partitions": [
          {
            "name": "New Calculated Table",
            "mode": "import",
            "source": {
              "type": "calculated",
              "expression": [
                "DATATABLE (",
                "    \"NameOrder\", INTEGER,",
                "    \"SF Name\", STRING,",
                "    \"SF Display Name\", STRING,",
                "    \"Format Divisor\", INTEGER,",
                "    {",
                "        { 1, \"IR01\", \"IR01 ($k/-bp)\", 1000 },",
                "        { 2, \"CS01\", \"Gov01 ($k/-bp)\", 1000 },",
                "        { 3, \"REPO BASIS\", \"Repo Basis ($k/-bp)\", 1000 },",
                "        { 4, \"Equity Delta\", \"Equity Delta ($m)\", 1000000 },",
                "        { 5, \"FX BASIS ORIGINAL\", \"FX Basis ($k/bp)\", 1000 },",
                "        { 6, \"Beta Adjusted Eq Delta\", \"Beta Adjusted Eq Delta ($m)\", 1000000 },",
                "        { 7, \"Equity Div Total\", \"Equity Div Total ($k/1%)\", 1000 },",
                "        { 8, \"Equity Div Projected\", \"Equity Div Projected ($k/1%)\", 1000 },",
                "        { 9, \"Equity Div Announced\", \"Equity Div Announced ($k/1%)\", 1000 }",
                "    }",
                ")"
              ]
            }
          }
        ]
      },
