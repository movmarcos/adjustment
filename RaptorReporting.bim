        "measures": [
          {
            "name": "Stress Group Value Calc",
            "expression": [
              "VAR x = SUMMARIZE(",
              "            'Stress Report Group',",
              "            'Stress Report Group'[SimID], ",
              "            \"value\", ",
              "             CALCULATE(",
              "                SWITCH(",
              "                    SELECTEDVALUE( 'Stress Report Group'[SimID] ),",
              "                    -35, CALCULATE( [Simulation Pl MRM_GLB_Std_CR_C_Loss], REMOVEFILTERS( 'Stress Report Group' ) ),",
              "                    -41, CALCULATE( [Simulation Pl MRM_GLB_Std_EQ_C_Loss], REMOVEFILTERS( 'Stress Report Group' ) ),",
              "                    -38, CALCULATE( [Simulation Pl MRM_GLB_Std_RT_C_Loss], REMOVEFILTERS( 'Stress Report Group' ) ),",
              "                    -59, CALCULATE( [Simulation Pl MRM_GLB_Std_Combined_Loss], REMOVEFILTERS( 'Stress Report Group' ) ),",
              "                    [Simulation Pl Levels]",
              "                ),",
              "                USERELATIONSHIP('Stress Report Group'[SimID], 'Stress Simulation'[STRESS_SIMULATION_KEY])",
              "            )",
              ")",
              "",
              "RETURN SUMX(x,[value])"
            ],
            "formatString": "#,##0.00",
            "isHidden": true,
            "lineageTag": "ad537a4d-fefe-4de2-afa3-e22cc7d94bad"
          },
          {
            "name": "Stress Group Value",
            "expression": [
              "ROUND(DIVIDE(",
              "IF(",
              "    SELECTEDVALUE( 'Stress Report Group'[SimulationNameReadable] ) =  \"Worst CUSO Stress\",",
              "    CALCULATE(",
              "        [WorstCUSO], ",
              "        ALLEXCEPT('Stress Report Group','Stress Report Group'[SimulationGroup])",
              "    ),",
              "    [Stress Group Value Calc]",
              ")",
              ", 1000000 ),1)",
              ""
            ],
            "formatString": "#,##0.00",
            "isHidden": true,
            "lineageTag": "ccd807a5-3983-4ac5-b000-0cb22e9eddc7"
          },
          {
            "name": "WorstCUSO",
            "expression": [
              "VAR lowest_cuso =",
              "    SUMMARIZE( ",
              "        'Stress Report Group', ",
              "        'Stress Report Group'[SimulationNameReadable], ",
              "        \"value\", CALCULATE( [Stress Group Value Calc], 'Stress Report Group'[SimulationNameReadable] <> \"New Std Combined Stress\" )",
              "    )",
              "RETURN",
              "    MINX( lowest_cuso, [value])",
              "\t"
            ],
            "isHidden": true,
            "lineageTag": "20006b58-4e2c-4869-a3dd-4724ed23ddf0"
          },
          {
            "name": "WorstCUSO_Name",
            "expression": [
              "VAR lowest_cuso =",
              "    SUMMARIZE(",
              "        FILTER('Stress Report Group', 'Stress Report Group'[SimulationNameReadable] <> \"New Std Combined Stress\" ),",
              "        'Stress Report Group'[SimulationNameReadable],",
              "        \"value\", ",
              "        [Stress Group Value Calc]",
              "    )",
              " ",
              "VAR FindLowest = TOPN(1,lowest_cuso, [value],asc)",
              "    ",
              "RETURN",
              "    MAXX( FindLowest, 'Stress Report Group'[SimulationNameReadable] )",
              "\t",
              "    ",
              "    /*",
              "VAR SecondElementFraction = 1-[First Element Fraction]",
              "VAR ScenarioTable =  SUMMARIZE('PnL Vector Element Ordinal','PnL Vector Element Ordinal'[SCENARIO_DATE_ID],\"PnlVector\",  [PnL Vector Value Import Adjusted])",
              "VAR VaRVectors = TOPN(2,TOPN([Second Element Sl No Summary],ScenarioTable,[PnlVector],ASC),[PnlVector],DESC)",
              "RETURN  (((CALCULATE(MINX(VaRVectors,[PnlVector])) * [First Element Fraction]) +  (CALCULATE(MAXX(VaRVectors,[PnlVector])) * SecondElementFraction)) * [VaR Scaling Value] *-1)",
              "*/"
            ],
            "isHidden": true,
            "lineageTag": "78107503-cdd5-4083-9ee7-79c0dd54fe0a"
          }
        ]
      },
