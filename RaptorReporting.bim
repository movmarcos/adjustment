        "partitions": [
          {
            "name": "VaR Book Instrument DQ",
            "mode": "directQuery",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Snowflake.Databases(\"tj90313.west-europe.azure.snowflakecomputing.com\", WarehouseName, null),",
                "    RAPTOR_Database = Source{[Name=DBName,Kind=\"Database\"]}[Data],",
                "    FACT_Schema = RAPTOR_Database{[Name=\"FACT\",Kind=\"Schema\"]}[Data],",
                "    VAR_SUMMARY_COMBINED_View = FACT_Schema{[Name=\"VAR_SUMMARY_COMBINED\",Kind=\"View\"]}[Data],",
                "    #\"Renamed Columns\" = Table.RenameColumns(VAR_SUMMARY_COMBINED_View,{{\"COMMON_INSTRUMENT_FCD_KEY\", \"COMMON_INSTRUMENT_FCD_KEY\"}})",
                "in",
                "    #\"Renamed Columns\""
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "PnL Row Count Summary",
            "expression": "COUNTROWS('VaR Book Instrument DQ')",
            "formatString": "0",
            "isHidden": true,
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"NumberWhole\" Accuracy=\"0\" />"
              }
            ]
          },
          {
            "name": "Previous Pnl Summary Unadjusted",
            "expression": [
              "",
              "CALCULATE(",
              "    [Pnl Summary],",
              "    FILTER(ALL('Reporting Date'), 'Reporting Date'[COBId] = MAX('Previous Reporting Date'[Previous COBId])),",
              "    FILTER(ALL('IsAdjustment'), IsAdjustment[Is Adjustment] = 0",
              "    )",
              ")"
            ],
            "isHidden": true,
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"General\" />"
              }
            ]
          },
          {
            "name": "Previous Pnl Summary Adjusted",
            "expression": [
              "",
              "CALCULATE(",
              "    [Pnl Summary],",
              "    FILTER(ALL('Reporting Date'), 'Reporting Date'[COBId] = MAX('Previous Reporting Date'[Previous COBId])),",
              "    ALL('IsAdjustment')",
              "    )",
              ""
            ],
            "isHidden": true,
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"General\" />"
              }
            ]
          },
          {
            "name": "VaR In USD Summary Unadjusted",
            "expression": [
              "VAR SecondElementFraction = 1-[First Element Fraction]",
              "VAR ScenarioTable =  SUMMARIZE('VaR Book Instrument DQ', 'VaR Book Instrument DQ'[SCENARIO_DATE_ID] ,\"PnlVector\", [Pnl Original Summary])",
              "VAR VaRVectors = TOPN(2,TOPN([Second Element Sl No Summary],ScenarioTable,[PnlVector],ASC),[PnlVector],DESC)",
              "RETURN  (((CALCULATE(MINX(VaRVectors,[PnlVector])) * [First Element Fraction]) +  (CALCULATE(MAXX(VaRVectors,[PnlVector])) * SecondElementFraction)) * [VaR Scaling Value] *-1)"
            ],
            "isHidden": true,
            "lineageTag": "a222008d-90f4-44c1-a4b6-56fa0f6e74e0",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"General\" />"
              }
            ]
          },
          {
            "name": "VaR In USD Summary Adjusted",
            "expression": [
              "VAR SecondElementFraction = 1-[First Element Fraction]",
              "VAR ScenarioTable =  SUMMARIZE('VaR Book Instrument DQ', 'VaR Book Instrument DQ'[SCENARIO_DATE_ID] ,\"PnlVector\", [Pnl Summary])",
              "VAR VaRVectors = TOPN(2,TOPN([Second Element Sl No Summary],ScenarioTable,[PnlVector],ASC),[PnlVector],DESC)",
              "RETURN  (((CALCULATE(MINX(VaRVectors,[PnlVector])) * [First Element Fraction]) +  (CALCULATE(MAXX(VaRVectors,[PnlVector])) * SecondElementFraction)) * [VaR Scaling Value] *-1)"
            ],
            "isHidden": true,
            "lineageTag": "6ec81434-593e-41ea-b978-75692ec167f6",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"General\" />"
              }
            ]
          },
          {
            "name": "VaR DoD Change DQ",
            "expression": "DIVIDE( ( [VaR In USD Summary] - [Previous VaR Adjusted DQ] ), 1000 )",
            "formatString": "#,0",
            "isHidden": true,
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"NumberWhole\" Accuracy=\"0\" ThousandSeparator=\"True\" />"
              }
            ]
          },
          {
            "name": "Previous VaR Adjusted DQ",
            "expression": [
              "",
              "CALCULATE(",
              "    [VaR In USD Summary Adjusted],",
              "    FILTER(ALL('Reporting Date'), 'Reporting Date'[COBId] = MAX('Previous Reporting Date'[Previous COBId]))",
              "    )",
              ""
            ],
            "isHidden": true,
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"General\" />"
              }
            ]
          },
          {
            "name": "Pnl Summary",
            "expression": "SUM('VaR Book Instrument DQ'[PNL_VECTOR_VALUE_IN_USD])",
            "isHidden": true,
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"General\" />"
              }
            ]
          },
          {
            "name": "VaR In USD Summary",
            "expression": [
              "VAR SecondElementFraction = 1-[First Element Fraction]",
              "VAR ScenarioTable =  SUMMARIZE('VaR Book Instrument DQ', 'VaR Book Instrument DQ'[SCENARIO_DATE_ID] ,\"PnlVector\",[Pnl Summary])",
              "VAR VaRVectors = TOPN(2,TOPN([Second Element Sl No Summary],ScenarioTable,[PnlVector],ASC),[PnlVector],DESC)",
              "RETURN  (((CALCULATE(MINX(VaRVectors,[PnlVector])) * [First Element Fraction]) +  (CALCULATE(MAXX(VaRVectors,[PnlVector])) * SecondElementFraction)) * [VaR Scaling Value] *-1)"
            ],
            "isHidden": true,
            "lineageTag": "e226e411-dffe-4359-9b03-bdba4542a069",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"General\" />"
              }
            ]
          },
          {
            "name": "VaR In Reporting Currency Summary",
            "expression": "DIVIDE([VaR In USD Summary], [Exchange Rate]) * [Currency Unit Value]",
            "formatString": "#,0",
            "isHidden": true,
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"NumberDecimal\" Accuracy=\"0\" ThousandSeparator=\"True\" />"
              }
            ]
          },
          {
            "name": "Highlight VaR Dept DQ",
            "expression": [
              "IF(",
              "    ABS( [VaR DoD Change DQ] ) >= MIN( FlashVaRAmount[HighlightAmount] )",
              "        && ( DIVIDE( [VaR DoD Change DQ], 1000 ) ) > MIN( 'FlashVaR%'[Highlight%] ),",
              "    1,",
              "    0",
              ")"
            ],
            "formatString": "0",
            "isHidden": true,
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"NumberWhole\" Accuracy=\"0\" />"
              }
            ]
          },
          {
            "name": "Pnl Adjustment Summary",
            "expression": [
              "",
              "CALCULATE(",
              "    [Pnl Summary],",
              "    FILTER(ALL('IsAdjustment'), IsAdjustment[Is Adjustment] = 1)",
              "    )"
            ],
            "isHidden": true,
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"General\" />"
              }
            ]
          },
          {
            "name": "Pnl Original Summary",
            "expression": [
              "",
              "CALCULATE(",
              "    [Pnl Summary],",
              "    FILTER(ALL('IsAdjustment'), IsAdjustment[Is Adjustment] = 0)",
              "    )"
            ],
            "isHidden": true,
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"General\" />"
              }
            ]
          },
          {
            "name": "VaR In Reporting Currency DoD Change DQ",
            "expression": "DIVIDE([VaR DoD Change DQ], [Exchange Rate])* [Currency Unit Value]",
            "formatString": "#,0",
            "isHidden": true,
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"NumberDecimal\" Accuracy=\"0\" ThousandSeparator=\"True\" />"
              }
            ]
          },
          {
            "name": "Adjustment PnL Row Count Summary",
            "expression": [
              "",
              "CALCULATE(",
              "    COUNTROWS('VaR Book Instrument DQ'),",
              "    FILTER(ALL('IsAdjustment'), IsAdjustment[Is Adjustment] = 1)",
              "    )"
            ],
            "formatString": "0",
            "isHidden": true,
            "lineageTag": "f432efde-95b8-40d1-afd5-76b4ae0af784",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"NumberWhole\" Accuracy=\"0\" />"
              }
            ]
          },
          {
            "name": "VaR In USD Summary Adjusted MUSECon",
            "expression": [
              "VAR SecondElementFraction = 1 - [First Element Fraction]",
              "VAR ScenarioTable =",
              "    SUMMARIZE(",
              "        FILTER(",
              "            'VaR Book Instrument DQ',",
              "            'VaR Book Instrument DQ'[ENTITY_CODE] = \"MUSI\" || 'VaR Book Instrument DQ'[ENTITY_CODE] = \"MUSEU\"",
              "        ),",
              "        'VaR Book Instrument DQ'[SCENARIO_DATE_ID],",
              "        \"PnlVector\", [Pnl Summary]",
              "    )",
              "VAR VaRVectors = TOPN( 2, TOPN( [Second Element Sl No Summary], ScenarioTable, [PnlVector], ASC ), [PnlVector], DESC )",
              "RETURN",
              "    ( ( ( CALCULATE( MINX( VaRVectors, [PnlVector] ) ) * [First Element Fraction] )",
              "        + ( CALCULATE( MAXX( VaRVectors, [PnlVector] ) ) * SecondElementFraction ) )",
              "        * [VaR Scaling Value]",
              "        * -1 )"
            ],
            "isHidden": true,
            "lineageTag": "d6b6261d-ddfc-41b1-9e3e-ecd4a381b8bb",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"General\" />"
              }
            ]
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          },
          {
            "name": "PBI_DescriptionAtRefresh"
          }
        ]
      },
