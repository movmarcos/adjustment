          {
            "name": "Simulation Pl MRM_S_PARA_RemoteCombinedStress",
            "expression": [
              "",
              "IF([Use Stress Trade Level DQ], ",
              "    Blank(),     ",
              "    SUMX({",
              "    CALCULATE(",
              "        [Simulation Pl Levels],",
              "        FILTER(ALL('Stress Simulation'), 'Stress Simulation'[Simulation Name]=\"MRM_M_PARA_EQ_Remote2_EQdnEVup\")",
              "    ),",
              "    CALCULATE(",
              "        [Simulation Pl Levels],",
              "        FILTER(ALL('Stress Simulation'), 'Stress Simulation'[Simulation Name]=\"MRM_S_PARA_CR_Remote_Bearflattener\")",
              "    ),",
              "    CALCULATE(",
              "        [Simulation Pl MRM_S_PARA_RemoteRatesStress],",
              "        ALL('Stress Simulation')",
              "    )",
              "    },[Value])",
              ")"
            ],
            "isHidden": true,
            "displayFolder": "Calculated",
            "lineageTag": "1b943d90-9559-40b8-b3ef-1194164e7b81",
            "annotations": [
