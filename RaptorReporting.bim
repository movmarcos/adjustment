          },
          {
            "type": "calculated",
            "name": "Alias",
            "dataType": "string",
            "isDataTypeInferred": true,
            "expression": [
              "SWITCH (",
              "    'Department 2'[Entity Department Original],",
              "    \"MUSI-CTG\", \"LN DM\",",
              "    \"MUSI-CEA\", \"HK EM\",",
              "    \"MUSI-CEM\", \"LN EM\",",
              "    \"MUSUSA-CTG\", \"NY IG\",",
              "    \"MUSUSA-CHY\", \"NY HY\",",
              "    \"MUSUSA-ECG\", \"NY CBs\",",
              "    \"MUSUSA-CPD\", \"NY CP\",",
              "    \"MUSUSA-CLO\", \"NY CLO\",",
              "    \"MUSUSA-LTG\", \"NY Loans\",",
              "    \"MUSEU-CEN\", \"AM B2B\",",
              "    \"MUSEU-CTN\", \"AM B2B\",",
              "    \"\"",
              ")"
            ],
            "lineageTag": "d2018b5f-f39f-4462-ba9d-ea5b19f5ca97",
            "isAvailableInMdx": false
          },
          {
            "type": "calculatedTableColumn",
            "name": "Order",
            "dataType": "int64",
            "isNameInferred": true,
            "isDataTypeInferred": true,
            "sourceColumn": "[Order]"
          },
          {
            "type": "calculated",
            "name": "Entity Code",
            "dataType": "string",
            "isDataTypeInferred": true,
            "expression": "IF ( 'Department 2'[Entity Code Original] = \"MUSI\", \"MUSE\", 'Department 2'[Entity Code Original] )",
            "lineageTag": "b7b3749d-8875-4cd5-a13a-f275e4351c8e",
            "isAvailableInMdx": false
          },
          {
            "type": "calculated",
            "name": "Entity Department",
            "dataType": "string",
            "isDataTypeInferred": true,
            "expression": "'Department 2'[Entity Code] & \"-\"& 'Department 2'[Department Code]",
            "sortByColumn": "Order",
            "lineageTag": "130e833b-c0a7-4da8-8b04-37a140d78ccd",
            "isAvailableInMdx": false
          },
          {
            "type": "calculated",
            "name": "Entity Business Code",
            "dataType": "string",
            "isDataTypeInferred": true,
            "expression": "'Department 2'[Entity Code] & \"-\"& RELATED('Business Line 2'[Business Unit Code])",
            "lineageTag": "14a67f25-2a82-43fb-965b-eb70f72a8612",
            "isAvailableInMdx": false
          },
          {
            "type": "calculated",
            "name": "Entity Business",
            "dataType": "string",
            "isDataTypeInferred": true,
            "expression": "'Department 2'[Entity Code] & \" - \"& RELATED('Business Line 2'[Business Line])",
            "lineageTag": "ed82f03d-9df8-4feb-857a-546599051aa3",
            "isAvailableInMdx": false
          }
        ],
        "partitions": [
          {
            "name": "Department 2",
            "mode": "import",
            "source": {
              "type": "calculated",
              "expression": [
                "",
                "VAR DATES_KEYS =",
                "    FILTER (",
                "        SUMMARIZECOLUMNS (",
                "            'Reporting Date'[COBID],",
                "            ENTITY_DEPARTMENT[Business Unit Code],",
                "            ENTITY_DEPARTMENT[Department Code],",
                "            ENTITY_DEPARTMENT[Entity Code],",
                "            ENTITY_DEPARTMENT[Entity Department],",
                "            ENTITY_DEPARTMENT[Volcker Desk],",
                "            \"FLAG\", CALCULATE ( [Count Sensi Summary Import] )",
                "        ),",
                "        NOT ( ISBLANK ( [FLAG] ) )",
                "            && ENTITY_DEPARTMENT[Department Code] <> \"N/A\"",
                "            && NOT ( ISBLANK ( ENTITY_DEPARTMENT[Entity Code] ) )",
                "                && NOT ( ISBLANK ( ENTITY_DEPARTMENT[Department Code] ) )",
                "    )",
                "VAR KEYS_RANKING =",
                "    ADDCOLUMNS (",
                "        DATES_KEYS,",
                "        \"RANK\",",
                "            RANKX (",
                "                FILTER (",
                "                    DATES_KEYS,",
                "                    ENTITY_DEPARTMENT[Entity Department]",
                "                        = EARLIER ( ENTITY_DEPARTMENT[Entity Department] )",
                "                ),",
                "                'Reporting Date'[COBID],",
                "                ,",
                "                DESC",
                "            )",
                "    )",
                "RETURN",
                "    ADDCOLUMNS (",
                "        SELECTCOLUMNS (",
                "            FILTER ( KEYS_RANKING, [RANK] = 1 ),",
                "            \"Business Unit Code\", ENTITY_DEPARTMENT[Business Unit Code],",
                "            \"Department Code\", ENTITY_DEPARTMENT[Department Code],",
                "            \"Entity Code\", ENTITY_DEPARTMENT[Entity Code],",
                "            \"Entity Department\", ENTITY_DEPARTMENT[Entity Department],",
                "            \"Volcker Desk\", ENTITY_DEPARTMENT[Volcker Desk]",
                "        ),",
                "        \"Order\",",
                "            SWITCH (",
                "                [Entity Department],",
                "                \"MUSI-CTG\", 1,",
                "                \"MUSI-CEA\", 2,",
                "                \"MUSI-CEM\", 3,",
                "                \"MUSUSA-CTG\", 4,",
                "                \"MUSUSA-CHY\", 5,",
                "                \"MUSUSA-ECG\", 6,",
                "                \"MUSUSA-CPD\", 7,",
                "                \"MUSUSA-CLO\", 8,",
                "                \"MUSUSA-LTG\", 9,",
                "                \"MUSEU-CEN\", 10,",
                "                \"MUSEU-CTN\", 11,",
                "                1",
                "            )",
                "    )"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "RLS_Level",
            "expression": [
              "VAR _TOP =",
              "    TOPN (",
              "        1,",
              "        'AD Groups',",
              "        'AD Groups'[Organization Rank], DESC,",
              "        'AD Groups'[Department], DESC",
              "    )",
              "RETURN",
              "    MAXX ( _TOP, 'AD Groups'[Organization Level] )"
            ],
            "isHidden": true,
            "lineageTag": "bf9d8e3e-ed43-4dc2-aaa8-18da4976d32b"
          }
        ],
        "annotations": [
          {
            "name": "PBI_Id",
            "value": "306160ef177748ecaff497eacaae3ca9"
          }
        ]
      },
