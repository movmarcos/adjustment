        "partitions": [
          {
            "name": "Stress Measures Combined DQ",
            "mode": "directQuery",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Snowflake.Databases(\"tj90313.west-europe.azure.snowflakecomputing.com\",WarehouseName),",
                "    RAPTOR_Database = Source{[Name=DBName,Kind=\"Database\"]}[Data],",
                "    FACT_Schema = RAPTOR_Database{[Name=\"FACT\",Kind=\"Schema\"]}[Data],",
                "    STRESS_MEASURES_COMBINED_View = FACT_Schema{[Name=\"STRESS_MEASURES_COMBINED\",Kind=\"View\"]}[Data]",
                "in",
                "    STRESS_MEASURES_COMBINED_View"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Adjustment Stress Row Count",
            "expression": [
              "",
              "CALCULATE(",
              "    COUNTROWS('Stress Measures Combined DQ'), ",
              "    FILTER(ALL('IsAdjustment'), IsAdjustment[Is Adjustment] = 1)",
              "    )"
            ],
            "formatString": "0",
            "isHidden": true,
            "lineageTag": "7fc05091-0204-406f-b013-eedf8d03591f",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"NumberWhole\" Accuracy=\"0\" />"
              },
              {
                "name": "PBI_ChangedProperties",
                "value": "[\"IsHidden\"]"
              }
            ]
          },
          {
            "name": "Simulation Pl DQ Adjusted",
            "expression": "SUM('Stress Measures Combined DQ'[SIMULATION_PL_IN_USD])",
            "isHidden": true,
