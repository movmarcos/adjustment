          },
          {
            "type": "calculated",
            "name": "Coupon Groups Order",
            "dataType": "int64",
            "isDataTypeInferred": true,
            "expression": [
              "SWITCH (",
              "    TRUE (),",
              "    'Instrument Other'[Coupon Interest Rate] <= 2.5, 1,",
              "    'Instrument Other'[Coupon Interest Rate] = 3, 2,",
              "    'Instrument Other'[Coupon Interest Rate] = 3.5, 3,",
              "    'Instrument Other'[Coupon Interest Rate] = 4, 4,",
              "    'Instrument Other'[Coupon Interest Rate] = 4.5, 5,",
              "    'Instrument Other'[Coupon Interest Rate] = 5, 6,",
              "    'Instrument Other'[Coupon Interest Rate] = 5.5, 7,",
              "    'Instrument Other'[Coupon Interest Rate] >= 6, 8,",
              "    9",
              ")"
            ],
            "lineageTag": "2cbe423c-0aa0-4f01-b277-b3b7c08b1b32"
          },
          {
            "type": "calculated",
            "name": "Coupon Groups",
            "dataType": "string",
            "isDataTypeInferred": true,
            "expression": [
              "SWITCH (",
              "    TRUE (),",
              "    'Instrument Other'[Coupon Interest Rate] <= 2.5, \"<= 2.5 Coupons\",",
              "    'Instrument Other'[Coupon Interest Rate] = 3, \"3.0 Coupons\",",
              "    'Instrument Other'[Coupon Interest Rate] = 3.5, \"3.5 Coupons\",",
              "    'Instrument Other'[Coupon Interest Rate] = 4, \"4.0 Coupons\",",
              "    'Instrument Other'[Coupon Interest Rate] = 4.5, \"4.5 Coupons\",",
              "    'Instrument Other'[Coupon Interest Rate] = 5, \"5.0 Coupons\",",
              "    'Instrument Other'[Coupon Interest Rate] = 5.5, \"5.5 Coupons\",",
              "    'Instrument Other'[Coupon Interest Rate] >= 6, \">= 6.0 Coupons\",",
              "    BLANK ()",
              ")"
            ],
            "sortByColumn": "Coupon Groups Order",
            "lineageTag": "82033952-70df-418d-907d-1ca7e3dc0e6d"
          }
        ],
