        "partitions": [
          {
            "name": "Market Value",
            "mode": "directQuery",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Snowflake.Databases(\"tj90313.west-europe.azure.snowflakecomputing.com\",WarehouseName),",
                "    Database = Source{[Name=DBName,Kind=\"Database\"]}[Data],",
                "    Schema = Database{[Name=\"FACT\",Kind=\"Schema\"]}[Data],",
                "    Data = Schema{[Name=\"VW_SENSITIVITY_MARKET_VALUE\",Kind=\"View\"]}[Data]",
                "in",
                "    Data"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "GrossMV",
            "expression": "[LongMV] + ABS([ShortMV])",
            "isHidden": true,
            "lineageTag": "b6dead91-592d-4e74-8c6f-851a222b7832"
          },
          {
            "name": "LongMV",
            "expression": [
              "IF(",
              "    [Use Sensi Trade Level DQ],",
              "    BLANK(),",
              "    CALCULATE(",
              "        SUM( 'Market Value'[MEASURE_VALUE_USD] ),",
              "        FILTER( 'Market Value', 'Market Value'[IS_LONG] = 1 )",
              "    )",
              ")"
            ],
            "isHidden": true,
            "lineageTag": "fe10d221-c5ac-415d-b08f-35f00a6e9876"
          },
          {
            "name": "ShortMV",
            "expression": [
              "IF(",
              "    [Use Sensi Trade Level DQ],",
              "    BLANK(),",
              "    CALCULATE(",
              "        SUM( 'Market Value'[MEASURE_VALUE_USD] ),",
              "        FILTER( 'Market Value', 'Market Value'[IS_LONG] = 0 )",
              "    )",
              ")"
            ],
            "isHidden": true,
            "lineageTag": "38c7119c-7fba-45c4-a95a-9870e2911d87"
          }
        ]
      },
