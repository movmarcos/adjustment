          {
            "type": "calculated",
            "name": "Counterparty Tier Group",
            "dataType": "string",
            "isDataTypeInferred": true,
            "expression": [
              "SWITCH (",
              "    TRUE (),",
              "    'Counterparty'[Counter Party Tier] = \"1\", \"1\",",
              "    'Counterparty'[Counter Party Tier] IN { \"2\", \"No Cash Trading\" }, \"2\",",
              "    'Counterparty'[Counter Party Tier] IN { \"3\", \"4\" }, \"3-4\",",
              "    \"Unclassified\"",
              ")"
            ],
            "lineageTag": "303f77c9-4d6b-4c6f-9a02-2f4348fd5b6c"
          }
        ],
