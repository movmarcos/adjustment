__pycache__/
*.pyc
*.pyo
.DS_Store
.venv/

# Local deploy marker — last successfully-deployed commit (per machine)
.last_deploy_commit
.gstack/

# Scratch/planning trees — .superpowers/sdd/ has its own nested .gitignore,
# but anything written directly under .superpowers/ (not under sdd/) needs
# this top-level rule too.
.superpowers/

# Ad-hoc scratch pastes at the repo root (e.g. timing/log pastes) — delete
# when no longer needed; this rule just stops an accidental `git add -A`.
/tes.txt

# Generated by deploy.py on each deploy — build stamp shown in the app sidebar
streamlit_app/utils/build_info.py

# Large binaries travel as split parts under drivers/ (see drivers/README.md)
*.jar
